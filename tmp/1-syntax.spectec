;; 구간 보정: nat x + uint64 start → uint64
dec $add_offset_nat_uint64(nat, uint64) : uint64
def $add_offset_nat_uint64(nat_x, uint64_start) = $(uint64_start + nat_x)

;; 하나의 i에 대해 셔플 인덱스를 통해 validatorIndex 뽑기
;; capture: (indices*, seed, len)
dec $pick_shuffled_vi(uint64, (validatorIndex*, bytes32, uint64)) : validatorIndex
def $pick_shuffled_vi(uint64_i, (validatorIndex_indices*, bytes32_seed, uint64_len)) = validatorIndex_vi
  -- if $compute_shuffled_index(uint64_i, uint64_len, bytes32_seed) = uint64_shuf
  -- if validatorIndex_indices*[uint64_shuf] = validatorIndex_vi


;; --------------------------------------------
;; compute_committee(validatorIndex*, bytes32, uint64, uint64) : validatorIndex*
;; --------------------------------------------

dec $compute_committee(validatorIndex*, bytes32, uint64, uint64) : validatorIndex*

def $compute_committee(validatorIndex_indices*, bytes32_seed, uint64_index, uint64_count) = validatorIndex_committee*
  -- if $( |validatorIndex_indices*| ) = uint64_len
  -- if $( (uint64_len * uint64_index) / uint64_count ) = uint64_start
  -- if $(uint64_index + 1) = uint64_plus_index
  -- if $( (uint64_len * uint64_plus_index) / uint64_count ) = uint64_end
  -- if $( uint64_end - uint64_start ) = uint64_span
  ;; [0..span-1] 만들고 → 각 원소에 start를 더해 [start..end-1] i-리스트 만들기
  -- if $range(uint64_span) = nat_r*
  -- if $map_list_2_<nat, uint64, uint64>(nat_r*, uint64_start, def $add_offset_nat_uint64) = uint64_i_list*
  ;; 각 i에 대해 indices[shuffle(i, len, seed)] 선택
  -- if $map_list_2_<uint64, (validatorIndex*, bytes32, uint64), validatorIndex>(
         uint64_i_list*,
         (validatorIndex_indices*, bytes32_seed, uint64_len),
         def $pick_shuffled_vi
       ) = validatorIndex_committee*

;; ------------------------------------------------------------
;; get_committee_count_per_slot
;; ------------------------------------------------------------
dec $get_committee_count_per_slot(beaconState, epoch) : uint64
def $get_committee_count_per_slot(state_beaconState, epoch_epoch) = uint64_committees_per_slot
  -- if $get_active_validator_indices(state_beaconState, epoch_epoch) = validatorIndex_active*
  -- if $( |validatorIndex_active*| ) = uint64_len_active
  -- if $(uint64_len_active / $SLOTS_PER_EPOCH) = uint64_per_slot
  -- if $(uint64_per_slot / $TARGET_COMMITTEE_SIZE) = uint64_estimate
  -- if $min_uint64($MAX_COMMITTEES_PER_SLOT, uint64_estimate) = uint64_capped
  -- if $max_uint64(1, uint64_capped) = uint64_committees_per_slot

;; ------------------------------------------------------------
;; get_beacon_committee
;; ------------------------------------------------------------
dec $get_beacon_committee(beaconState, slot, committeeIndex) : validatorIndex*
def $get_beacon_committee(state, slot, committeeIndex) = validatorIndex_committee*
  -- if $compute_epoch_at_slot(slot) = epoch
  -- if $get_committee_count_per_slot(state, epoch) = uint64_committees_per_slot
  -- if $get_active_validator_indices(state, epoch) = validatorIndex_indices*
  -- if $get_seed(state, epoch, $DOMAIN_BEACON_ATTESTER) = bytes32_seed
  -- if $( (slot \ $SLOTS_PER_EPOCH) * uint64_committees_per_slot + committeeIndex ) = uint64_index
  -- if $( uint64_committees_per_slot * $SLOTS_PER_EPOCH ) = uint64_count
  -- if $compute_committee(
         validatorIndex_indices*,
         bytes32_seed,
         uint64_index,
         uint64_count
       ) = validatorIndex_committee*

;; --------------------------------------------
;; is aggregation_bits[i] true?
;; --------------------------------------------
dec $bit_is_one_at_index((nat, validatorIndex), boolean*) : bool

def $bit_is_one_at_index((n_i, validatorIndex_vi), boolean_bits*)
  = true
  -- if $(n_i < |boolean_bits*|)
  -- if boolean_bits*[n_i] = true

def $bit_is_one_at_index((n_i, validatorIndex_vi), boolean_bits*)
  = false
  -- otherwise

;; --------------------------------------------
;; validatorIndex 만 뽑기
;; --------------------------------------------
dec $collect_vi((nat, validatorIndex), boolean*) : validatorIndex
def $collect_vi((n_i, validatorIndex_vi), boolean_bits*) = validatorIndex_vi

;; --------------------------------------------
;; get_attesting_indices(state, attestation) : validatorIndex*
;; --------------------------------------------
dec $get_attesting_indices(beaconState, attestation) : validatorIndex*

def $get_attesting_indices(state, attestation_att) = validatorIndex_set*
  -- if $get_beacon_committee(
         state,
         attestation_att.DATA.SLOT,
         attestation_att.DATA.INDEX
       ) = validatorIndex_committee*
  -- if $enumerate_<validatorIndex>(validatorIndex_committee*)
       = (n_i, validatorIndex_vi)*
  -- if $filter_list_2_<(nat, validatorIndex), boolean*>(
         (n_i, validatorIndex_vi)*,
         attestation_att.AGGREGATION_BITS,
         def $bit_is_one_at_index
       ) = (n_sel, validatorIndex_sel)*
  -- if $map_list_2_<(nat, validatorIndex), boolean*, validatorIndex>(
         (n_sel, validatorIndex_sel)*,
         attestation_att.AGGREGATION_BITS,
         def $collect_vi
       ) = validatorIndex_list*
  -- if $to_set_<validatorIndex>(validatorIndex_list*) = validatorIndex_set*

;; ------------------------------------------------------------
;; is_slashable_attestation_data
;; ------------------------------------------------------------
dec $is_slashable_attestation_data(attestationData, attestationData) : bool
def $is_slashable_attestation_data(attd1, attd2) =
  ( ~(attd1 = attd2) /\ $( attd1.TARGET.EPOCH = attd2.TARGET.EPOCH ) )
  \/
  ( $( attd1.SOURCE.EPOCH < attd2.SOURCE.EPOCH ) /\ $( attd2.TARGET.EPOCH < attd1.TARGET.EPOCH ) )

;;
;; is_valid_indexed_attestation
;;
dec $is_valid_indexed_attestation(beaconState, indexedAttestation) : boolean
;; 1. empty list
def $is_valid_indexed_attestation(state, indexedAttestation) = false
  -- if validatorIndex_indices* = indexedAttestation.ATTESTING_INDICES
  -- if $( |validatorIndex_indices*| = 0 )

;; 2. not sorted
def $is_valid_indexed_attestation(state, indexedAttestation) = false
  -- if validatorIndex_indices* = indexedAttestation.ATTESTING_INDICES
  -- if $to_set_<validatorIndex>(validatorIndex_indices*) = validatorIndex_set*
  -- if $sort_<validatorIndex>(validatorIndex_set*)    = validatorIndex_sorted*
  -- if ~( validatorIndex_sorted* = validatorIndex_indices* )

;; 3. if is true
def $is_valid_indexed_attestation(state, indexedAttestation) = true
  -- if validatorIndex_indices* = indexedAttestation.ATTESTING_INDICES
  -- if $to_set_<validatorIndex>(validatorIndex_indices*) = validatorIndex_set*
  -- if $sort_<validatorIndex>(validatorIndex_set*) = validatorIndex_sorted*
  -- if $( |validatorIndex_sorted*| > 0 )
  -- if validatorIndex_sorted* = validatorIndex_indices*
  -- if (state.VALIDATORS[validatorIndex_indices].PUBKEY = blsPubkey_pk)*
  -- if $get_domain(state, $DOMAIN_BEACON_ATTESTER, indexedAttestation.DATA.TARGET.EPOCH) = domain_att
  -- if $compute_signing_root_attestationData(indexedAttestation.DATA, domain_att) = root_sign
  -- if $bls_fast_aggregate_verify(blsPubkey_pk*, root_sign, indexedAttestation.SIGNATURE) = true


;; is_slashable?
dec $is_slashable_now(validatorIndex, beaconState) : boolean

def $is_slashable_now(validatorIndex_vi, state) = true
  -- if $(validatorIndex_vi < |state.VALIDATORS|)
  -- if state.VALIDATORS[validatorIndex_vi] = validator_v
  -- if $get_current_epoch(state) = epoch_cur
  -- if $is_slashable_validator(validator_v, epoch_cur) = true

def $is_slashable_now(validatorIndex_vi, state) = false
  -- otherwise

;; if is_slashable -> slash
dec $slash_if_eligible(beaconState, validatorIndex) : beaconState

def $slash_if_eligible(state, validatorIndex_vi) = state_slashed
  -- if $is_slashable_now(validatorIndex_vi, state) = true
  -- if state_slashed = $slash_validator(state, validatorIndex_vi, eps)

def $slash_if_eligible(state, validatorIndex_vi) = state
  -- otherwise

;; 리스트 전체에 적용: fold_
dec $apply_slashes(beaconState, validatorIndex*) : beaconState
def $apply_slashes(state, validatorIndex_sorted*) = state_after
  -- if $fold_<beaconState, validatorIndex>(
         def $slash_if_eligible,
         state,
         validatorIndex_sorted*
       ) = state_after

;; ============================================
;; SOURCE 플래그 판단 (조건 만족 시 [TIMELY_SOURCE_FLAG_INDEX], 아니면 eps)
;; ============================================
dec $source_flag_list(beaconState, attestationData, checkpoint, uint64) : nat*

def $source_flag_list(state_beaconState, attestationData_data, checkpoint_jc, uint64_inclusion_delay) = nat_flags_source*
  -- if $integer_squareroot($SLOTS_PER_EPOCH) = uint64_sqrt_slots_per_epoch
  -- if $(attestationData_data.SOURCE = checkpoint_jc)
  -- if $(uint64_inclusion_delay <= uint64_sqrt_slots_per_epoch)
  -- if nat_flags_source* = [ $TIMELY_SOURCE_FLAG_INDEX ]

def $source_flag_list(state_beaconState, attestationData_data, checkpoint_jc, uint64_inclusion_delay) = eps
  -- otherwise


;; ============================================
;; TARGET 플래그 판단 (조건 만족 시 [TIMELY_TARGET_FLAG_INDEX], 아니면 eps)
;; ============================================
dec $target_flag_list(beaconState, attestationData, uint64) : nat*

def $target_flag_list(state_beaconState, attestationData_data, uint64_inclusion_delay) = nat_flags_target*
  -- if $get_block_root(state_beaconState, attestationData_data.TARGET.EPOCH) = root_target_epoch
  -- if $(attestationData_data.TARGET.ROOT = root_target_epoch)
  -- if $(uint64_inclusion_delay <= $SLOTS_PER_EPOCH)
  -- if nat_flags_target* = [ $TIMELY_TARGET_FLAG_INDEX ]

def $target_flag_list(state_beaconState, attestationData_data, uint64_inclusion_delay) = eps
  -- otherwise


;; ============================================
;; HEAD 플래그 판단 (조건 만족 시 [TIMELY_HEAD_FLAG_INDEX], 아니면 eps)
;; (HEAD는 TARGET 매칭이 선행되어야 하므로 TARGET 매칭도 함께 확인)
;; ============================================
dec $head_flag_list(beaconState, attestationData, uint64) : nat*

def $head_flag_list(state_beaconState, attestationData_data, uint64_inclusion_delay) = nat_flags_head*
  -- if $get_block_root(state_beaconState, attestationData_data.TARGET.EPOCH) = root_target_epoch
  -- if $(attestationData_data.TARGET.ROOT = root_target_epoch)
  -- if $get_block_root_at_slot(state_beaconState, attestationData_data.SLOT) = root_at_slot
  -- if $(attestationData_data.BEACON_BLOCK_ROOT = root_at_slot)
  -- if $(uint64_inclusion_delay = $MIN_ATTESTATION_INCLUSION_DELAY)
  -- if nat_flags_head* = [ $TIMELY_HEAD_FLAG_INDEX ]

def $head_flag_list(state_beaconState, attestationData_data, uint64_inclusion_delay) = eps
  -- otherwise

;;
;; get_attestation_participation_flag_indices
;;
dec $get_attestation_participation_flag_indices(beaconState, attestationData, uint64) : nat*

;; case 1: data.TARGET.EPOCH == get_current_epoch(state)
def $get_attestation_participation_flag_indices(state_beaconState, attestationData_data, uint64_inclusion_delay) = nat_flag_indices*
  -- if $get_current_epoch(state_beaconState) = epoch_current
  -- if $(attestationData_data.TARGET.EPOCH = epoch_current)
  -- if checkpoint_jc = state_beaconState.CURRENT_JUSTIFIED_CHECKPOINT
  ;; assert is_matching_source
  -- if $(attestationData_data.SOURCE = checkpoint_jc)
  ;; 개별 플래그 리스트 계산
  -- if $source_flag_list(state_beaconState, attestationData_data, checkpoint_jc, uint64_inclusion_delay) = nat_flags_source*
  -- if $target_flag_list(state_beaconState, attestationData_data, uint64_inclusion_delay) = nat_flags_target*
  -- if $head_flag_list(state_beaconState, attestationData_data, uint64_inclusion_delay)   = nat_flags_head*
  ;; 합치기
  -- if nat_flag_indices* = nat_flags_source* ++ nat_flags_target* ++ nat_flags_head*


;; case 2: data.TARGET.EPOCH != get_current_epoch(state)  (⇒ previous 사용)
def $get_attestation_participation_flag_indices(state_beaconState, attestationData_data, uint64_inclusion_delay) = nat_flag_indices*
  -- if $get_current_epoch(state_beaconState) = epoch_current
  -- if ~( $(attestationData_data.TARGET.EPOCH = epoch_current) )
  -- if checkpoint_jc = state_beaconState.PREVIOUS_JUSTIFIED_CHECKPOINT
  ;; assert is_matching_source
  -- if $(attestationData_data.SOURCE = checkpoint_jc)
  ;; 개별 플래그 리스트 계산
  -- if $source_flag_list(state_beaconState, attestationData_data, checkpoint_jc, uint64_inclusion_delay) = nat_flags_source*
  -- if $target_flag_list(state_beaconState, attestationData_data, uint64_inclusion_delay) = nat_flags_target*
  -- if $head_flag_list(state_beaconState, attestationData_data, uint64_inclusion_delay)   = nat_flags_head*
  ;; 합치기
  -- if nat_flag_indices* = nat_flags_source* ++ nat_flags_target* ++ nat_flags_head*

;; next_sync_committee_indices_loop:
;; state, 활성검증자목록, seed, 활성수, i, 누적리스트  ->  누적리스트(길이 = SYNC_COMMITTEE_SIZE)
dec $next_sync_committee_indices_loop(
  beaconState, validatorIndex*, bytes32, uint64, uint64, validatorIndex*
) : validatorIndex*

;; while 종료 조건은 acc 길이 < SYNC_COMMITTEE_SIZE 이므로 같아지면 종료
def $next_sync_committee_indices_loop(
  state_beaconState, validatorIndex_active*, bytes32_seed, uint64_active_cnt, uint64_i, validatorIndex_acc*
) = validatorIndex_acc*
  -- if $( |validatorIndex_acc*| ) = uint64_len_acc
  -- if $( uint64_len_acc >= $SYNC_COMMITTEE_SIZE )

;; 계속: 한 번 시도하고(합격 시 append), i+1로 재귀
def $next_sync_committee_indices_loop(
  state_beaconState, validatorIndex_active*, bytes32_seed, uint64_active_cnt, uint64_i, validatorIndex_acc*
) = validatorIndex_ret*
  ;; 1 shuffled_index = compute_shuffled_index(i % active_cnt, active_cnt, seed)
  -- if $(uint64_i \ uint64_active_cnt) = uint64_mod
  -- if $compute_shuffled_index(uint64_mod, uint64_active_cnt, bytes32_seed) = uint64_shuf
  -- if validatorIndex_active*[uint64_shuf] = validatorIndex_candidate
  ;; 2 random_byte = hash(seed || uint_to_bytes(i//32))[i%32]
  -- if $(uint64_i / 32) = uint64_chunk
  -- if $uint_to_bytes(uint64_chunk) = bytes_chunk
  ;; fix hash(bytes32 + bytes)
  -- if $bytes32_to_bytes(bytes32_seed) = bytes_seed_bytes
  -- if $concat_bytes(bytes_seed_bytes, bytes_chunk) = bytes_msg
  -- if $hash_<bytes>(bytes_msg) = bytes32_h
  -- if $(uint64_i \ 32) = nat_b                      ;; 0..31
  -- if $bytes32_to_bytes1_list(bytes32_h) = bytes1_list_32*
  -- if bytes1_list_32*[nat_b] = bytes1_rb            ;; bytes1
  -- if $bytes1_to_uint64(bytes1_rb) = uint64_random_byte
  ;; 3 effective_balance 읽기
  -- if state_beaconState.VALIDATORS[validatorIndex_candidate] = validator_v
  -- if gwei_effective = validator_v.EFFECTIVE_BALANCE
  ;; 4 합격이면 append, 아니면 그대로
  -- if $( gwei_effective * $MAX_RANDOM_BYTE >= $MAX_EFFECTIVE_BALANCE * uint64_random_byte )
  -- if validatorIndex_acc_sel* = ( validatorIndex_acc* ++ [ validatorIndex_candidate ] )
  -- if ~( $( gwei_effective * $MAX_RANDOM_BYTE >= $MAX_EFFECTIVE_BALANCE * uint64_random_byte ) )
  -- if validatorIndex_acc_sel* = validatorIndex_acc*
  ;; 5 재귀(i+1)
  -- if $next_sync_committee_indices_loop(
         state_beaconState,
         validatorIndex_active*,
         bytes32_seed,
         uint64_active_cnt,
         $(uint64_i + 1),
         validatorIndex_acc_sel*
       ) = validatorIndex_ret*


;; --------------------------------------------
;; get_next_sync_committee_indices(state) : validatorIndex*
;; --------------------------------------------
dec $get_next_sync_committee_indices(beaconState) : validatorIndex*

def $get_next_sync_committee_indices(state) = validatorIndex_out*
  -- if $get_current_epoch(state) = epoch_cur
  -- if epoch_next = $( epoch_cur + 1 )
  -- if $get_active_validator_indices(state, epoch_next) = validatorIndex_active*
  -- if $( |validatorIndex_active*| ) = uint64_active_cnt
  -- if $get_seed(state, epoch_next, $DOMAIN_SYNC_COMMITTEE) = bytes32_seed
  -- if $next_sync_committee_indices_loop(
         state,
         validatorIndex_active*,
         bytes32_seed,
         uint64_active_cnt,
         0,
         eps ;; 빈 리스트 초기화 해서 넘기니까 그냥 eps 으로 넘김
       ) = validatorIndex_out*

;; --------------------------------------------
;; get_next_sync_committee(state) : SyncCommittee
;; --------------------------------------------
dec $get_next_sync_committee(beaconState) : syncCommittee

def $get_next_sync_committee(state) = syncCommittee_ret
  -- if $get_next_sync_committee_indices(state) = validatorIndex_indices*
  ;; indices로 선택된 validator들의 PUBKEY 리스트 생성
  -- if (state.VALIDATORS[validatorIndex_indices].PUBKEY = blsPubkey_list)*
  ;; pubkey 집합을 BLS aggregate
  -- if $eth_aggregate_pubkeys(blsPubkey_list*) = blsPubkey_agg
  -- if syncCommittee_ret =
       { PUBKEYS         blsPubkey_list*,
         AGGREGATE_PUBKEY blsPubkey_agg }

;; =========================
;; helpers for rewards, penlaties and balances
;; =========================

;; --------------------------------------------
;; get_total_balance(state, indices) : gwei
;; --------------------------------------------
dec $get_total_balance(beaconState, validatorIndex*) : gwei

def $get_total_balance(state, validatorIndex*) = gwei_total
  -- if (state.VALIDATORS[validatorIndex].EFFECTIVE_BALANCE = balance)*
  -- if $sum_<gwei>(balance*) = gwei_sum
  -- if $max_uint64($EFFECTIVE_BALANCE_INCREMENT, gwei_sum) = gwei_total

dec $get_total_active_balance(beaconState) : gwei

def $get_total_active_balance(state) = gwei_total
  -- if $get_current_epoch(state) = epoch_cur
  -- if $get_active_validator_indices(state, epoch_cur) = validatorIndex_active*
  -- if $to_set_<validatorIndex>(validatorIndex_active*) = validatorIndex_set*
  -- if $get_total_balance(state, validatorIndex_set*) = gwei_total

;; --------------------------------------------
;; get_base_reward_per_increment(state) : gwei
;;
;; --------------------------------------------
dec $get_base_reward_per_increment(beaconState) : gwei

def $get_base_reward_per_increment(state) = gwei_base
  -- if $get_total_active_balance(state) = gwei_total_active
  -- if $integer_squareroot(gwei_total_active) = uint64_sqrt_total
  -- if $( $EFFECTIVE_BALANCE_INCREMENT * $BASE_REWARD_FACTOR ) = uint64_num
  -- if $( uint64_num / uint64_sqrt_total ) = gwei_base

;; --------------------------------------------
;; get_base_reward(state, index) : gwei
;; --------------------------------------------
dec $get_base_reward(beaconState, validatorIndex) : gwei

def $get_base_reward(state, validatorIndex_vi) = gwei_reward
  -- if $(validatorIndex_vi < |state.VALIDATORS|)
  -- if state.VALIDATORS[validatorIndex_vi] = validator_i
  -- if $( validator_i.EFFECTIVE_BALANCE / $EFFECTIVE_BALANCE_INCREMENT ) = uint64_increments
  -- if $get_base_reward_per_increment(state) = gwei_per_inc
  -- if $( uint64_increments * gwei_per_inc ) = gwei_reward

;; predicate: apply update iff
;;   balance + DOWNWARD_THRESHOLD < effective_balance
;;   OR
;;   effective_balance + UPWARD_THRESHOLD < balance
dec $cond_hysteresis(gwei, gwei, uint64, uint64) : boolean

def $cond_hysteresis(gwei_balance, gwei_eff, uint64_down_th, uint64_up_th) = true
  -- if $( gwei_balance + uint64_down_th < gwei_eff )
   \/
       $( gwei_eff + uint64_up_th   < gwei_balance )

def $cond_hysteresis(gwei_balance, gwei_eff, uint64_down_th, uint64_up_th) = false
  -- otherwise

;; ------------------------------------------------------------
;; rebalance rule for a single (index, validator) pair
;; (computes hysteresis thresholds and updates EFFECTIVE_BALANCE if needed)
;; ------------------------------------------------------------
dec $rebalance_validator_enumerated((nat, validator), beaconState) : validator

def $rebalance_validator_enumerated((n, validator_v), state) = validator_updated
  -- if $(n < |state.BALANCES|)
  -- if state.BALANCES[n] = gwei_balance
  -- if $( $EFFECTIVE_BALANCE_INCREMENT / $HYSTERESIS_QUOTIENT ) = uint64_hyst_inc
  -- if $( uint64_hyst_inc * $HYSTERESIS_DOWNWARD_MULTIPLIER ) = uint64_down_th
  -- if $( uint64_hyst_inc * $HYSTERESIS_UPWARD_MULTIPLIER )  = uint64_up_th
  -- if $cond_hysteresis(
         gwei_balance,
         validator_v.EFFECTIVE_BALANCE,
         uint64_down_th,
         uint64_up_th
       ) = true
  -- if $( gwei_balance \ $EFFECTIVE_BALANCE_INCREMENT ) = gwei_mod
  -- if $( gwei_balance - gwei_mod ) = gwei_floor_inc
  -- if $min_uint64(gwei_floor_inc, $MAX_EFFECTIVE_BALANCE) = gwei_new_eff
  -- if validator_updated = validator_v[.EFFECTIVE_BALANCE = gwei_new_eff]

def $rebalance_validator_enumerated((n, validator_v), state) = validator_v
  -- otherwise

;; --------------------------------------------
;; per-index inactivity penalty
;; capture: (state, matching_set*, eligible_set*, denom)
;; rewards 는 건드는 코드 없으므로 penalty 에 대해 0으로 갈지 아니면 조건을 만족하여 값을 바꿀지만 결정되면 됨.
;; --------------------------------------------
dec $inact_penalty_one(nat, (beaconState, validatorIndex*, validatorIndex*, uint64)) : gwei

def $inact_penalty_one(nat_i, (state_beaconState, validatorIndex_matching*, validatorIndex_eligible*, uint64_den))
  = gwei_penalty
  -- if validatorIndex_vi = nat_i
  -- if ( validatorIndex_vi <- validatorIndex_eligible* )
  -- if ~( validatorIndex_vi <- validatorIndex_matching* )
  -- if $(validatorIndex_vi < |state_beaconState.VALIDATORS|)
  -- if state_beaconState.VALIDATORS[validatorIndex_vi] = validator_v
  -- if gwei_eff = validator_v.EFFECTIVE_BALANCE
  -- if $(validatorIndex_vi < |state_beaconState.INACTIVITY_SCORES|)
  -- if state_beaconState.INACTIVITY_SCORES[validatorIndex_vi] = uint64_score
  -- if $( gwei_eff * uint64_score ) = uint64_num
  -- if $( uint64_num / uint64_den ) = gwei_penalty

def $inact_penalty_one(nat_i, (state_beaconState, validatorIndex_matching*, validatorIndex_eligible*, uint64_den))
  = 0
  -- otherwise

;; --------------------------------------------
;; get_inactivity_penalty_deltas(state) : (rewards*, penalties*)
;; --------------------------------------------
dec $get_inactivity_penalty_deltas(beaconState) : (gwei*, gwei*)

def $get_inactivity_penalty_deltas(state_beaconState) = (gwei_rewards*, gwei_penalties*)
  -- if $( |state_beaconState.VALIDATORS| ) = uint64_N
  -- if $repeat_<gwei>(0, uint64_N) = gwei_rewards*                 ;; rewards = [0]*N
  -- if $range(uint64_N) = nat_idx*                                 ;; 0..N-1
  -- if $get_previous_epoch(state_beaconState) = epoch_prev
  -- if $get_unslashed_participating_indices(
         state_beaconState, $TIMELY_TARGET_FLAG_INDEX, epoch_prev
       ) = validatorIndex_matching*
  -- if $get_eligible_validator_indices(state_beaconState) = validatorIndex_eligible*
  -- if $( $INACTIVITY_SCORE_BIAS * $INACTIVITY_PENALTY_QUOTIENT_BELLATRIX ) = uint64_den
  -- if $map_list_2_<nat, (beaconState, validatorIndex*, validatorIndex*, uint64), gwei>(
         nat_idx*,
         (state_beaconState, validatorIndex_matching*, validatorIndex_eligible*, uint64_den),
         def $inact_penalty_one
       ) = gwei_penalties*


;; --------------------------------------------
;; flag-delta per-index helpers
;; --------------------------------------------

;; 보상 항목: 참여했고(leak 아님)일 때만 값, 그 외 0
;; capture: (state, unslashed_set*, weight, up_incs, active_incs)
dec $flag_reward_one(nat, (beaconState, validatorIndex*, uint64, uint64, uint64)) : gwei

def $flag_reward_one(nat_i, (state_beaconState, validatorIndex_unslashed*, uint64_weight, uint64_up_incs, uint64_active_incs))
  = gwei_reward
  -- if validatorIndex_vi = nat_i
  -- if ( validatorIndex_vi <- validatorIndex_unslashed* )
  -- if $is_in_inactivity_leak(state_beaconState) = false
  -- if $get_base_reward(state_beaconState, validatorIndex_vi) = gwei_base_reward
  -- if $( gwei_base_reward * uint64_weight ) = uint64_mul_w
  -- if $( uint64_mul_w * uint64_up_incs ) = uint64_num
  -- if $( uint64_active_incs * $WEIGHT_DENOMINATOR ) = uint64_den
  -- if $( uint64_num / uint64_den ) = gwei_reward

def $flag_reward_one(nat_i, (state_beaconState, validatorIndex_unslashed*, uint64_weight, uint64_up_incs, uint64_active_incs))
  = 0
  -- otherwise


;; 패널티 항목: 미참여이고 HEAD 플래그가 아닐 때만 값, 그 외 0
;; capture: (state, unslashed_set*, weight, flag_index)
dec $flag_penalty_one(nat, (beaconState, validatorIndex*, uint64, nat)) : gwei

def $flag_penalty_one(nat_i, (state_beaconState, validatorIndex_unslashed*, uint64_weight, nat_flag_index))
  = gwei_penalty
  -- if validatorIndex_vi = nat_i
  -- if ~( validatorIndex_vi <- validatorIndex_unslashed* )
  -- if ~( nat_flag_index = $TIMELY_HEAD_FLAG_INDEX )
  -- if $get_base_reward(state_beaconState, validatorIndex_vi) = gwei_base_reward
  -- if $( gwei_base_reward * uint64_weight ) = uint64_num
  -- if $( uint64_num / $WEIGHT_DENOMINATOR ) = gwei_penalty

def $flag_penalty_one(nat_i, (state_beaconState, validatorIndex_unslashed*, uint64_weight, nat_flag_index))
  = 0
  -- otherwise

;; --------------------------------------------
;; get_flag_index_deltas(state, flag_index) : (rewards*, penalties*)
;; --------------------------------------------
dec $get_flag_index_deltas(beaconState, nat) : (gwei*, gwei*)

def $get_flag_index_deltas(state_beaconState, nat_flag_index) = (gwei_rewards*, gwei_penalties*)
  -- if $( |state_beaconState.VALIDATORS| ) = uint64_N
  -- if $range(uint64_N) = nat_idx*
  -- if $get_previous_epoch(state_beaconState) = epoch_prev
  -- if $get_unslashed_participating_indices(
         state_beaconState, nat_flag_index, epoch_prev
       ) = validatorIndex_unslashed*
  -- if $PARTICIPATION_FLAG_WEIGHTS[nat_flag_index] = uint64_weight
  -- if $get_total_balance(state_beaconState, validatorIndex_unslashed*) = gwei_unslashed_bal
  -- if $( gwei_unslashed_bal / $EFFECTIVE_BALANCE_INCREMENT ) = uint64_up_incs
  -- if $get_total_active_balance(state_beaconState) = gwei_total_active
  -- if $( gwei_total_active / $EFFECTIVE_BALANCE_INCREMENT ) = uint64_active_incs
  ;; rewards: 참여 & (¬leak) 에만 분배
  -- if $map_list_2_<nat, (beaconState, validatorIndex*, uint64, uint64, uint64), gwei>(
         nat_idx*,
         (state_beaconState, validatorIndex_unslashed*, uint64_weight, uint64_up_incs, uint64_active_incs),
         def $flag_reward_one
       ) = gwei_rewards*
  ;; penalties: 미참여 & (flag != HEAD) 에만 부과
  -- if $map_list_2_<nat, (beaconState, validatorIndex*, uint64, nat), gwei>(
         nat_idx*,
         (state_beaconState, validatorIndex_unslashed*, uint64_weight, nat_flag_index),
         def $flag_penalty_one
       ) = gwei_penalties*

;; =========================
;; helper funcs in process_epoch 
;; =========================

;; ========== helpers for this rule ==========
;; (한 인덱스에 대해) 보상 → 패널티 적용
dec $apply_one_delta(beaconState, (validatorIndex, gwei, gwei)) : beaconState
def $apply_one_delta(state, (validatorIndex_vi, gwei_r, gwei_p)) = state_after
  -- if state_r     = $increase_balance(state, validatorIndex_vi, gwei_r)
  -- if state_after = $decrease_balance(state_r, validatorIndex_vi, gwei_p)

;; 한 세트의 (reward*, penalty*)를 모든 인덱스에 적용 (안쪽 for = fold 1회)
dec $apply_one_round(beaconState, (validatorIndex*, gwei*, gwei*)) : beaconState
def $apply_one_round(state, (validatorIndex_vi*, gwei_r*, gwei_p*)) = state_after
  -- if $fold_<beaconState, (validatorIndex, gwei, gwei)>(
         def $apply_one_delta,
         state,
         (validatorIndex_vi, gwei_r, gwei_p)*
       ) = state_after

;; 바깥 fold에서 항목을 받아 한 라운드 적용
dec $apply_one_round_captured(beaconState, (validatorIndex*, (gwei*, gwei*))) : beaconState
def $apply_one_round_captured(state, (validatorIndex_vi*, (gwei_rr*, gwei_pp*))) =
  $apply_one_round(state, (validatorIndex_vi*, gwei_rr*, gwei_pp*))

;; ------------------------------------------------------------
;; per-index inactivity score update
;; ------------------------------------------------------------
dec $update_inactivity_one(beaconState, validatorIndex) : beaconState

;; case A: index ∈ unslashed participating (prev epoch)
def $update_inactivity_one(state, validatorIndex_vi) = state_after
  -- if $get_previous_epoch(state) = epoch_prev
  -- if $get_unslashed_participating_indices(state, $TIMELY_TARGET_FLAG_INDEX, epoch_prev) = validatorIndex_participating_prev*
  -- if ( validatorIndex_vi <- validatorIndex_participating_prev* )
  -- if $(validatorIndex_vi < |state.INACTIVITY_SCORES|)
  -- if state.INACTIVITY_SCORES[validatorIndex_vi] = uint64_s0
  -- if $min_uint64(1, uint64_s0) = uint64_dec1
  -- if $(uint64_s0 - uint64_dec1) = uint64_s1
  -- if state.INACTIVITY_SCORES[[validatorIndex_vi] = uint64_s1] = uint64_scores_mid*
  -- if state_mid = state[.INACTIVITY_SCORES = uint64_scores_mid*]
  ;; leak-free 추가 회복(감소)
  -- if $is_in_inactivity_leak(state) = false
  -- if state_mid.INACTIVITY_SCORES[validatorIndex_vi] = uint64_s1_read
  -- if $min_uint64($INACTIVITY_SCORE_RECOVERY_RATE, uint64_s1_read) = uint64_dec2
  -- if $(uint64_s1_read - uint64_dec2) = uint64_s2
  -- if state_mid.INACTIVITY_SCORES[[validatorIndex_vi] = uint64_s2] = uint64_scores_after*
  -- if state_after = state_mid[.INACTIVITY_SCORES = uint64_scores_after*]

def $update_inactivity_one(state, validatorIndex_vi) = state_mid
  -- if $get_previous_epoch(state) = epoch_prev
  -- if $get_unslashed_participating_indices(state, $TIMELY_TARGET_FLAG_INDEX, epoch_prev) = validatorIndex_participating_prev*
  -- if ( validatorIndex_vi <- validatorIndex_participating_prev* )
  -- if $(validatorIndex_vi < |state.INACTIVITY_SCORES|)
  -- if state.INACTIVITY_SCORES[validatorIndex_vi] = uint64_s0
  -- if $min_uint64(1, uint64_s0) = uint64_dec1
  -- if $(uint64_s0 - uint64_dec1) = uint64_s1
  -- if state.INACTIVITY_SCORES[[validatorIndex_vi] = uint64_s1] = uint64_scores_mid*
  -- if $is_in_inactivity_leak(state) = true
  -- if state_mid = state[.INACTIVITY_SCORES = uint64_scores_mid*]

;; case B: index ∉ unslashed participating (prev epoch)
def $update_inactivity_one(state, validatorIndex_vi) = state_after
  -- if $get_previous_epoch(state) = epoch_prev
  -- if $get_unslashed_participating_indices(state, $TIMELY_TARGET_FLAG_INDEX, epoch_prev) = validatorIndex_participating_prev*
  -- if ~( validatorIndex_vi <- validatorIndex_participating_prev* )
  -- if $(validatorIndex_vi < |state.INACTIVITY_SCORES|)
  -- if state.INACTIVITY_SCORES[validatorIndex_vi] = uint64_s0
  -- if $(uint64_s0 + $INACTIVITY_SCORE_BIAS) = uint64_s1
  -- if state.INACTIVITY_SCORES[[validatorIndex_vi] = uint64_s1] = uint64_scores_mid*
  -- if state_mid = state[.INACTIVITY_SCORES = uint64_scores_mid*]
  ;; leak-free 추가 회복(감소)
  -- if $is_in_inactivity_leak(state) = false
  -- if state_mid.INACTIVITY_SCORES[validatorIndex_vi] = uint64_s1_read
  -- if $min_uint64($INACTIVITY_SCORE_RECOVERY_RATE, uint64_s1_read) = uint64_dec2
  -- if $(uint64_s1_read - uint64_dec2) = uint64_s2
  -- if state_mid.INACTIVITY_SCORES[[validatorIndex_vi] = uint64_s2] = uint64_scores_after*
  -- if state_after = state_mid[.INACTIVITY_SCORES = uint64_scores_after*]

def $update_inactivity_one(state, validatorIndex_vi) = state_mid
  -- if $get_previous_epoch(state) = epoch_prev
  -- if $get_unslashed_participating_indices(state, $TIMELY_TARGET_FLAG_INDEX, epoch_prev) = validatorIndex_participating_prev*
  -- if ~( validatorIndex_vi <- validatorIndex_participating_prev* )
  -- if $(validatorIndex_vi < |state.INACTIVITY_SCORES|)
  -- if state.INACTIVITY_SCORES[validatorIndex_vi] = uint64_s0
  -- if $(uint64_s0 + $INACTIVITY_SCORE_BIAS) = uint64_s1
  -- if state.INACTIVITY_SCORES[[validatorIndex_vi] = uint64_s1] = uint64_scores_mid*
  -- if $is_in_inactivity_leak(state) = true
  -- if state_mid = state[.INACTIVITY_SCORES = uint64_scores_mid*]


;; fold helper (beaconState, validatorIndex) -> beaconState
dec $apply_inactivity_one(beaconState, validatorIndex) : beaconState
def $apply_inactivity_one(state, validatorIndex_vi) = state_updated
  -- if state_updated = $update_inactivity_one(state, validatorIndex_vi)

;; --------------------------------------------
;; predicate: (i, v)가 이번 epoch에 슬래시 벌점 집행 대상인가?
;;  v.SLASHED = true  ∧  epoch + (EPOCHS_PER_SLASHINGS_VECTOR / 2) = v.WITHDRAWABLE_EPOCH
;; --------------------------------------------
dec $is_due_slashing_en(enumerated_<validator>, epoch) : boolean

def $is_due_slashing_en((nat_i, validator_v), epoch_cur) = true
  -- if $(validator_v.SLASHED = true)
  -- if $( epoch_cur + ($EPOCHS_PER_SLASHINGS_VECTOR / 2) = validator_v.WITHDRAWABLE_EPOCH )

def $is_due_slashing_en((nat_i, validator_v), epoch_cur) = false
  -- otherwise


;; --------------------------------------------
;; map: (i, v) ↦ (ValidatorIndex(i), penalty)
;; capture: (gwei_adj_total_slash, gwei_total_active)
;; penalty = ((v.EFFECTIVE_BALANCE / INC) * gwei_adj_total_slash / gwei_total_active) * INC
;; --------------------------------------------
dec $compute_slash_penalty_en((nat, validator), (gwei, gwei)) : (validatorIndex, gwei)

def $compute_slash_penalty_en((nat_i, validator_v), (gwei_adj_total_slash, gwei_total_active))
  = (validatorIndex_vi, gwei_penalty)
  -- if validatorIndex_vi = nat_i                 ;; nat → validatorIndex
  -- if $EFFECTIVE_BALANCE_INCREMENT = gwei_inc 
  -- if $( validator_v.EFFECTIVE_BALANCE / gwei_inc ) = uint64_incs 
  -- if $( uint64_incs * gwei_adj_total_slash ) = gwei_pen_num 
  -- if $( gwei_pen_num / gwei_total_active ) = gwei_pen_div 
  -- if $( gwei_pen_div * gwei_inc ) = gwei_penalty 


;; --------------------------------------------
;; fold 함수: 한 건의 (vi, penalty)를 state에 적용
;; --------------------------------------------
dec $apply_one_decrease(beaconState, (validatorIndex, gwei)) : beaconState

def $apply_one_decrease(state_in, (validatorIndex_vi, gwei_penalty)) = state_out
  -- if state_out = $decrease_balance(state_in, validatorIndex_vi, gwei_penalty)


dec $weigh_justification_and_finalization(beaconState, gwei, gwei, gwei) : beaconState

;; ============================================================
;; weigh_justification_and_finalization
;;   inputs: (state_in, gwei_total_active, gwei_prev_tgt, gwei_cur_tgt)
;;   output: state_out
;; 공통 기호:
;;   epoch_prev = $get_previous_epoch(state_in)
;;   epoch_cur  = $get_current_epoch(state_in)
;;   checkpoint_old_prev   = state_in.PREVIOUS_JUSTIFIED_CHECKPOINT
;;   checkpoint_old_cur    = state_in.CURRENT_JUSTIFIED_CHECKPOINT
;;   boolean_old_bits*  = state_in.JUSTIFICATION_BITS  (길이 ≥ 4 가정)
;;   shift 후 기본형: base_bits* = [ false, boolean_old_bits*[0], boolean_old_bits*[1], boolean_old_bits*[2] ]
;; 공통 보조 설명:
;;  P := (gwei_prev_tgt * 3 >= gwei_total_active * 2)
;;  C := (gwei_cur_tgt  * 3 >= gwei_total_active * 2)
;;  boolean_old_bits*[0]=b0', [1]=b1', [2]=b2', [3]=b3'
;;  boolean_bits_init*  = [ false, b0', b1', b2' ]
;;  P 반영: boolean_bits_after_P* = boolean_bits_init*            (P=0)
;;                        = boolean_bits_init*[[1] = true] (P=1)
;;  C 반영: boolean_bits_final*   = boolean_bits_after_P*         (C=0)
;;                        = boolean_bits_after_P*[[0] = true] (C=1)
;;  JC 갱신 순서:
;;   - PREVIOUS_JUSTIFIED_CHECKPOINT ← checkpoint_old_cur
;;   - if P=1 and C=0: CURRENT_JUSTIFIED_CHECKPOINT ← (epoch_prev, root_prev)
;;   - if C=1:         CURRENT_JUSTIFIED_CHECKPOINT ← (epoch_cur,  root_cur)
;;   - if P=0 and C=0: CURRENT_JUSTIFIED_CHECKPOINT 변화 없음
;;
;;  Finalize 조건:
;;   A: bits[1]&bits[2]&bits[3] = 1  ∧  checkpoint_old_prev.EPOCH + 3 = epoch_cur → FINALIZED = checkpoint_old_prev
;;   B: bits[1]&bits[2]        = 1  ∧  checkpoint_old_prev.EPOCH + 2 = epoch_cur → FINALIZED = checkpoint_old_prev
;;   C: bits[0]&bits[1]&bits[2] = 1 ∧  checkpoint_old_cur.EPOCH  + 2 = epoch_cur → FINALIZED = checkpoint_old_cur
;;   D: bits[0]&bits[1]        = 1  ∧  checkpoint_old_cur.EPOCH  + 1 = epoch_cur → FINALIZED = checkpoint_old_cur
;; ============================================================
dec $weigh_justification_and_finalization(beaconState, gwei, gwei, gwei) : beaconState

;; =========================
;; P=0, C=0  →  A / B / None  (3개)
;; =========================

def $weigh_justification_and_finalization(state_in, gwei_total_active, gwei_prev_tgt, gwei_cur_tgt) = state_out
  ;; P=0, C=0, Finalize A
  -- if $get_previous_epoch(state_in) = epoch_prev
  -- if $get_current_epoch(state_in)  = epoch_cur
  -- if checkpoint_old_prev = state_in.PREVIOUS_JUSTIFIED_CHECKPOINT
  -- if checkpoint_old_cur  = state_in.CURRENT_JUSTIFIED_CHECKPOINT
  -- if boolean_old_bits* = state_in.JUSTIFICATION_BITS
  -- if boolean_old_bits*[0] = boolean_b0p
  -- if boolean_old_bits*[1] = boolean_b1p
  -- if boolean_old_bits*[2] = boolean_b2p
  -- if boolean_bits_init*   = [ false, boolean_b0p, boolean_b1p, boolean_b2p ]
  -- if $(gwei_prev_tgt * 3 >= gwei_total_active * 2) = false   ;; P=0
  -- if $(gwei_cur_tgt  * 3 >= gwei_total_active * 2) = false   ;; C=0
  -- if boolean_bits_after_P* = boolean_bits_init*
  -- if boolean_bits_final*   = boolean_bits_after_P*
  ;; update JC (prev ← checkpoint_old_cur; curr unchanged)
  -- if state_pj = state_in[.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_old_cur]
  -- if state_bits = state_pj[.JUSTIFICATION_BITS = boolean_bits_final*]
  ;; Finalize A: bits[1]=1,bits[2]=1,bits[3]=1 & checkpoint_old_prev.EPOCH+3=epoch_cur
  -- if boolean_bits_final*[1] = true
  -- if boolean_bits_final*[2] = true
  -- if boolean_bits_final*[3] = true
  -- if $(checkpoint_old_prev.EPOCH + 3 = epoch_cur)
  -- if state_out = state_bits[.FINALIZED_CHECKPOINT = checkpoint_old_prev]

def $weigh_justification_and_finalization(state_in, gwei_total_active, gwei_prev_tgt, gwei_cur_tgt) = state_out
  ;; P=0, C=0, Finalize B
  -- if $get_previous_epoch(state_in) = epoch_prev
  -- if $get_current_epoch(state_in)  = epoch_cur
  -- if checkpoint_old_prev = state_in.PREVIOUS_JUSTIFIED_CHECKPOINT
  -- if checkpoint_old_cur  = state_in.CURRENT_JUSTIFIED_CHECKPOINT
  -- if boolean_old_bits* = state_in.JUSTIFICATION_BITS
  -- if boolean_old_bits*[0] = boolean_b0p
  -- if boolean_old_bits*[1] = boolean_b1p
  -- if boolean_old_bits*[2] = boolean_b2p
  -- if boolean_bits_init*   = [ false, boolean_b0p, boolean_b1p, boolean_b2p ]
  -- if $(gwei_prev_tgt * 3 >= gwei_total_active * 2) = false
  -- if $(gwei_cur_tgt  * 3 >= gwei_total_active * 2) = false
  -- if boolean_bits_after_P* = boolean_bits_init*
  -- if boolean_bits_final*   = boolean_bits_after_P*
  -- if state_pj = state_in[.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_old_cur]
  -- if state_bits = state_pj[.JUSTIFICATION_BITS = boolean_bits_final*]
  ;; Finalize B
  -- if boolean_bits_final*[1] = true
  -- if boolean_bits_final*[2] = true
  -- if $(checkpoint_old_prev.EPOCH + 2 = epoch_cur)
  -- if state_out = state_bits[.FINALIZED_CHECKPOINT = checkpoint_old_prev]

def $weigh_justification_and_finalization(state_in, gwei_total_active, gwei_prev_tgt, gwei_cur_tgt) = state_out
  ;; P=0, C=0, None
  -- if $get_previous_epoch(state_in) = epoch_prev
  -- if $get_current_epoch(state_in)  = epoch_cur
  -- if checkpoint_old_cur  = state_in.CURRENT_JUSTIFIED_CHECKPOINT
  -- if boolean_old_bits* = state_in.JUSTIFICATION_BITS
  -- if boolean_old_bits*[0] = boolean_b0p
  -- if boolean_old_bits*[1] = boolean_b1p
  -- if boolean_old_bits*[2] = boolean_b2p
  -- if boolean_bits_init*   = [ false, boolean_b0p, boolean_b1p, boolean_b2p ]
  -- if $(gwei_prev_tgt * 3 >= gwei_total_active * 2) = false
  -- if $(gwei_cur_tgt  * 3 >= gwei_total_active * 2) = false
  -- if boolean_bits_after_P* = boolean_bits_init*
  -- if boolean_bits_final*   = boolean_bits_after_P*
  -- if state_pj = state_in[.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_old_cur]
  -- if state_out = state_pj[.JUSTIFICATION_BITS = boolean_bits_final*]


;; =========================
;; P=1, C=0  →  A / B / None  (3개)
;; =========================

def $weigh_justification_and_finalization(state_in, gwei_total_active, gwei_prev_tgt, gwei_cur_tgt) = state_out
  ;; P=1, C=0, Finalize A
  -- if $get_previous_epoch(state_in) = epoch_prev
  -- if $get_current_epoch(state_in)  = epoch_cur
  -- if checkpoint_old_prev = state_in.PREVIOUS_JUSTIFIED_CHECKPOINT
  -- if checkpoint_old_cur  = state_in.CURRENT_JUSTIFIED_CHECKPOINT
  -- if boolean_old_bits* = state_in.JUSTIFICATION_BITS
  -- if boolean_old_bits*[0] = boolean_b0p
  -- if boolean_old_bits*[1] = boolean_b1p
  -- if boolean_old_bits*[2] = boolean_b2p
  -- if boolean_bits_init*   = [ false, boolean_b0p, boolean_b1p, boolean_b2p ]
  -- if $(gwei_prev_tgt * 3 >= gwei_total_active * 2) = true    ;; P=1
  -- if $(gwei_cur_tgt  * 3 >= gwei_total_active * 2) = false   ;; C=0
  -- if boolean_bits_after_P* = boolean_bits_init*[[1] = true]
  -- if boolean_bits_final*   = boolean_bits_after_P*
  ;; JC 업데이트 (prev ← checkpoint_old_cur; curr ← (epoch_prev, root_prev))
  -- if $get_block_root(state_in, epoch_prev) = root_prev
  -- if checkpoint_prev = { EPOCH epoch_prev, ROOT root_prev }
  -- if state_pj  = state_in[.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_old_cur]
  -- if state_cj  = state_pj[.CURRENT_JUSTIFIED_CHECKPOINT  = checkpoint_prev]
  -- if state_bits = state_cj[.JUSTIFICATION_BITS = boolean_bits_final*]
  ;; Finalize A
  -- if boolean_bits_final*[1] = true
  -- if boolean_bits_final*[2] = true
  -- if boolean_bits_final*[3] = true
  -- if $(checkpoint_old_prev.EPOCH + 3 = epoch_cur)
  -- if state_out = state_bits[.FINALIZED_CHECKPOINT = checkpoint_old_prev]

def $weigh_justification_and_finalization(state_in, gwei_total_active, gwei_prev_tgt, gwei_cur_tgt) = state_out
  ;; P=1, C=0, Finalize B
  -- if $get_previous_epoch(state_in) = epoch_prev
  -- if $get_current_epoch(state_in)  = epoch_cur
  -- if checkpoint_old_prev = state_in.PREVIOUS_JUSTIFIED_CHECKPOINT
  -- if checkpoint_old_cur  = state_in.CURRENT_JUSTIFIED_CHECKPOINT
  -- if boolean_old_bits* = state_in.JUSTIFICATION_BITS
  -- if boolean_old_bits*[0] = boolean_b0p
  -- if boolean_old_bits*[1] = boolean_b1p
  -- if boolean_old_bits*[2] = boolean_b2p
  -- if boolean_bits_init*   = [ false, boolean_b0p, boolean_b1p, boolean_b2p ]
  -- if $(gwei_prev_tgt * 3 >= gwei_total_active * 2) = true
  -- if $(gwei_cur_tgt  * 3 >= gwei_total_active * 2) = false
  -- if boolean_bits_after_P* = boolean_bits_init*[[1] = true]
  -- if boolean_bits_final*   = boolean_bits_after_P*
  -- if $get_block_root(state_in, epoch_prev) = root_prev
  -- if checkpoint_prev = { EPOCH epoch_prev, ROOT root_prev }
