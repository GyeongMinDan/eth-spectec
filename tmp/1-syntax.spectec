;; ============================================
;; helpers for process_registry_updates (fixed)
;; ============================================

;; (i, v)가 activation 자격인가?  (state 캡처)
dec $is_eligible_activation_en((nat, validator), beaconState) : boolean
def $is_eligible_activation_en((nat_i, validator_v), state) =
  $is_eligible_for_activation(state, validator_v)

;; (i, v) ↦ (v.ACTIVATION_ELIGIBILITY_EPOCH, ValidatorIndex(i))  (state 캡처 안 씀)
dec $activation_key_en((nat, validator), beaconState) : (epoch, validatorIndex)
def $activation_key_en((nat_i, validator_v), state) = (epoch_key, validatorIndex_vi)
  -- if epoch_key = validator_v.ACTIVATION_ELIGIBILITY_EPOCH
  -- if validatorIndex_vi = nat_i

;; (epoch, vi) → vi   (단항 맵으로 변경)
dec $pick_vi_from_key_1((epoch, validatorIndex)) : validatorIndex
def $pick_vi_from_key_1((epoch_e, validatorIndex_vi)) = validatorIndex_vi

;; enumerate 결과 (n, vi)에서 n < limit ?
dec $idx_lt_limit((nat, validatorIndex), uint64) : boolean
def $idx_lt_limit((nat_i, validatorIndex_vi), uint64_lim) = true
  -- if $(nat_i < uint64_lim)
def $idx_lt_limit((nat_i, validatorIndex_vi), uint64_lim) = false
  -- otherwise

;; dequeue 대상 하나에 대해 ACTIVATION_EPOCH 세팅
dec $activate_one(beaconState, validatorIndex) : beaconState
def $activate_one(state_in, validatorIndex_vi) = state_out
  -- if $get_current_epoch(state_in) = epoch_cur
  -- if $compute_activation_exit_epoch(epoch_cur) = epoch_act
  -- if $(validatorIndex_vi < |state_in.VALIDATORS|)
  -- if validator_old = state_in.VALIDATORS[validatorIndex_vi]
  -- if validator_new = validator_old[.ACTIVATION_EPOCH = epoch_act]
  -- if state_out = state_in[.VALIDATORS = state_in.VALIDATORS[[validatorIndex_vi] = validator_new]]

;; (i, v) 한 쌍 처리: eligibility_epoch 설정 및 eject
dec $process_registry_one(beaconState, (nat, validator)) : beaconState

;; case 1: activation queue 자격 → eligibility_epoch 갱신, 그리고 eject 검사
def $process_registry_one(state_in, (nat_i, validator_v)) = state_after
  -- if $get_current_epoch(state_in) = epoch_cur
  -- if $is_eligible_for_activation_queue(validator_v) = true
  -- if epoch_elig = $(epoch_cur + 1)
  -- if validator_set_elig = validator_v[.ACTIVATION_ELIGIBILITY_EPOCH = epoch_elig]
  -- if state_elig = state_in[.VALIDATORS = state_in.VALIDATORS[[nat_i] = validator_set_elig]]
  -- if state_elig.VALIDATORS[nat_i] = validator_read
  -- if $is_active_validator(validator_read, epoch_cur) = true
  -- if $(validator_read.EFFECTIVE_BALANCE <= $EJECTION_BALANCE)
  -- if state_after = $initiate_validator_exit(state_elig, nat_i)

;; case 2: 자격 아님 → eject 검사만
def $process_registry_one(state_in, (nat_i, validator_v)) = state_after
  -- if $get_current_epoch(state_in) = epoch_cur
  -- if $is_eligible_for_activation_queue(validator_v) = false
  -- if state_mid = state_in
  -- if state_mid.VALIDATORS[nat_i] = validator_read
  -- if $is_active_validator(validator_read, epoch_cur) = true
  -- if $(validator_read.EFFECTIVE_BALANCE <= $EJECTION_BALANCE) = true
  -- if state_after = $initiate_validator_exit(state_mid, nat_i)

;; case 3: 그 외 → 변화 없음
def $process_registry_one(state_in, (nat_i, validator_v)) = state_in
  -- otherwise

;; enumerate 결과에서 index만 뽑기
dec $pick_vi_from_enumerated_1((nat, validatorIndex)) : validatorIndex
def $pick_vi_from_enumerated_1((nat_i, validatorIndex_vi)) = validatorIndex_vi

;;
;; process_justification_and_finalization
;;
relation Process_justification_and_finalization:
  beaconState ~> beaconState
  hint(input %0)

rule Process_justification_and_finalization/skip:
  state_beaconState ~> state_beaconState
  -- if $get_current_epoch(state_beaconState) = epoch_cur
  -- if $(epoch_cur <= ($GENESIS_EPOCH + 1))

rule Process_justification_and_finalization/main:
  state_beaconState ~> state_weighed
  -- if $get_current_epoch(state_beaconState) = epoch_cur
  -- if $get_previous_epoch(state_beaconState) = epoch_prev
  -- if $get_unslashed_participating_indices(state_beaconState, $TIMELY_TARGET_FLAG_INDEX, epoch_prev) = validatorIndex_prev_indices*
  -- if $get_unslashed_participating_indices(state_beaconState, $TIMELY_TARGET_FLAG_INDEX, epoch_cur)  = validatorIndex_curr_indices*
  -- if $get_total_active_balance(state_beaconState) = gwei_total_active
  -- if $get_total_balance(state_beaconState, validatorIndex_prev_indices*) = gwei_prev_target_bal
  -- if $get_total_balance(state_beaconState, validatorIndex_curr_indices*) = gwei_curr_target_bal
  -- if $weigh_justification_and_finalization(state_beaconState, gwei_total_active, gwei_prev_target_bal, gwei_curr_target_bal) = state_weighed


;;
;; process_inactivity_updates
;;
relation Process_inactivity_updates:
  beaconState ~> beaconState
  hint(input %0)

rule Process_inactivity_updates/skip:
  state_beaconState ~> state_beaconState
  -- if $get_current_epoch(state_beaconState) = $GENESIS_EPOCH

rule Process_inactivity_updates/main:
  state_beaconState ~> state_updated
  -- if $get_current_epoch(state_beaconState) = epoch_cur
  -- if ~(epoch_cur = $GENESIS_EPOCH)
  -- if $get_eligible_validator_indices(state_beaconState) = validatorIndex_eligible*
  -- if $fold_<beaconState, validatorIndex>(
         def $apply_inactivity_one,
         state_beaconState,
         validatorIndex_eligible*
       ) = state_updated


;;
;; process_rewards_and_penalties
;;
relation Process_rewards_and_penalties:
  beaconState ~> beaconState
  hint(input %0)

rule Process_rewards_and_penalties/skip:
  state ~> state
  -- if $get_current_epoch(state) = $GENESIS_EPOCH

rule Process_rewards_and_penalties/main:
  state ~> state_out
  ;; 1 flag deltas 수집: 0..|PARTICIPATION_FLAG_WEIGHTS|-1
  -- if $range(|$PARTICIPATION_FLAG_WEIGHTS|) = nat_flag_idx*
  -- if ( $get_flag_index_deltas(state, nat_flag_idx) = (gwei_rf*, gwei_pf*) )*
  ;;    ↑ 반복으로 gwei_rf** / gwei_pf** 생성
  ;; 2 inactivity deltas 추가 → 총 4세트
  -- if $get_inactivity_penalty_deltas(state) = (gwei_ri*, gwei_pi*)
  -- if gwei_rf** ++ [gwei_ri*] = gwei_reward_2d**
  -- if gwei_pf** ++ [gwei_pi*] = gwei_penalty_2d**
  ;; 3 검증자 인덱스 목록 준비 
  -- if $range(|state.VALIDATORS|) = nat_idx*
  -- if validatorIndex_idx* = nat_idx*          
  ;; 4 바깥 세트(reward*, penalty*)들에 대해 차례대로 적용 (fold 1회)
  -- if $fold_<beaconState, (validatorIndex*, (gwei*, gwei*))>(
         def $apply_one_round_captured,
         state,
         (validatorIndex_idx*, (gwei_reward_2d*, gwei_penalty_2d*))*
       ) = state_out

;;
;; process_registry_updates
;;
relation Process_registry_updates:
  beaconState ~> beaconState
  hint(input %0)

relation Process_registry_updates:
  beaconState ~> beaconState
  hint(input %0)

rule Process_registry_updates/main:
  state_in ~> state_out
  ;; (1) 1차 패스: eligibility_epoch 설정 및 eject 처리 (for each validator)
  -- if validator_list* = state_in.VALIDATORS
  -- if $enumerate_<validator>(validator_list*) = (nat_i, validator_v)*
  -- if state_pass1 = $fold_<beaconState, (nat, validator)>(
         def $process_registry_one,
         state_in,
         (nat_i, validator_v)*
       )
  ;; (2) activation 후보 인덱스 수집 + (elig_epoch, index) 키로 정렬
  -- if validator_list1* = state_pass1.VALIDATORS
  -- if $enumerate_<validator>(validator_list1*) = (nat_j, validator_w)*
  -- if $filter_list_2_<(nat, validator), beaconState>(
         (nat_j, validator_w)*,
         state_pass1,
         def $is_eligible_activation_en
       ) = (nat_elg, validator_elg)*
  -- if $map_list_2_<(nat, validator), beaconState, (epoch, validatorIndex)>(
         (nat_elg, validator_elg)*,
         state_pass1,
         def $activation_key_en
       ) = (epoch_key, validatorIndex_vi)*
  -- if $sort_<(epoch, validatorIndex)>((epoch_key, validatorIndex_vi)*) =
         (epoch_sorted, validatorIndex_sorted_vi)*
  -- if $map_list_1_<(epoch, validatorIndex), validatorIndex>(
         (epoch_sorted, validatorIndex_sorted_vi)*,
         def $pick_vi_from_key_1
       ) = validatorIndex_sorted*
  ;; (3) churn limit 만큼만 dequeue → ACTIVATION_EPOCH 세팅
  -- if $get_validator_churn_limit(state_pass1) = uint64_churn_limit
  -- if $enumerate_<validatorIndex>(validatorIndex_sorted*) = (nat_idx, validatorIndex_q)*
  -- if $filter_list_2_<(nat, validatorIndex), uint64>(
        (nat_idx, validatorIndex_q)*,
        uint64_churn_limit,
        def $idx_lt_limit
      ) = (nat_take, validatorIndex_take)*
  -- if $map_list_1_<(nat, validatorIndex), validatorIndex>(
        (nat_take, validatorIndex_take)*,
        def $pick_vi_from_enumerated_1
      ) = validatorIndex_to_activate*
  -- if state_out = $fold_<beaconState, validatorIndex>(
        def $activate_one,
        state_pass1,
        validatorIndex_to_activate*
      )


;;
;; process_slashings
;;
relation Process_slashings:
  beaconState ~> beaconState
  hint(input %0)

rule Process_slashings:
  state_in ~> state_out
  ;; 1 계산에 사용할 값들 
  -- if $get_current_epoch(state_in) = epoch_cur 
  -- if $get_total_active_balance(state_in) = gwei_total_active
  -- if $sum_<gwei>(state_in.SLASHINGS) = gwei_slash_sum 
  -- if $( gwei_slash_sum * $PROPORTIONAL_SLASHING_MULTIPLIER_BELLATRIX ) = gwei_scaled
  -- if $min_uint64(gwei_scaled, gwei_total_active) = gwei_adj_total_slash
  ;; 2 validator 인덱스 for 문으로 inices 뽑고, 그 안에서 slashing 할 조건으로 index 추출
  -- if validator_list* = state_in.VALIDATORS
  -- if $enumerate_<validator>(validator_list*) = (nat_i, validator_v)*
  -- if $filter_list_2_<(nat, validator), epoch>(
         (nat_i, validator_v)*,
         epoch_cur,
         def $is_due_slashing_en
       ) = (nat_due, validator_due)*
  ;; 3 penalty 계산(map, (adj_total_slash, total_active))
  -- if $map_list_2_<(nat, validator), (gwei, gwei), (validatorIndex, gwei)>(
         (nat_due, validator_due)*,
         (gwei_adj_total_slash, gwei_total_active),
         def $compute_slash_penalty_en
       ) = (validatorIndex_vi, gwei_penalty)*
  ;; 4 fold 로 적용
  -- if $fold_<beaconState, (validatorIndex, gwei)>(
         def $apply_one_decrease,
         state_in,
         (validatorIndex_vi, gwei_penalty)*
       ) = state_out


