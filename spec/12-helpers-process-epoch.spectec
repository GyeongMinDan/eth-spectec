;; =========================
;; helper funcs in process_epoch 
;; =========================

;; ========== helpers for this rule ==========
;; (한 인덱스에 대해) 보상 → 패널티 적용
dec $apply_one_delta(beaconState, (validatorIndex, gwei, gwei)) : beaconState
def $apply_one_delta(state, (validatorIndex_vi, gwei_r, gwei_p)) = state_after
  -- if state_r     = $increase_balance(state, validatorIndex_vi, gwei_r)
  -- if state_after = $decrease_balance(state_r, validatorIndex_vi, gwei_p)

;; 한 세트의 (reward*, penalty*)를 모든 인덱스에 적용 (안쪽 for = fold 1회)
dec $apply_one_round(beaconState, (validatorIndex*, gwei*, gwei*)) : beaconState
def $apply_one_round(state, (validatorIndex_vi*, gwei_r*, gwei_p*)) = state_after
  -- if $fold_<beaconState, (validatorIndex, gwei, gwei)>(
         def $apply_one_delta,
         state,
         (validatorIndex_vi, gwei_r, gwei_p)*
       ) = state_after

;; 바깥 fold에서 항목을 받아 한 라운드 적용
dec $apply_one_round_captured(beaconState, (validatorIndex*, (gwei*, gwei*))) : beaconState
def $apply_one_round_captured(state, (validatorIndex_vi*, (gwei_rr*, gwei_pp*))) =
  $apply_one_round(state, (validatorIndex_vi*, gwei_rr*, gwei_pp*))

;; ------------------------------------------------------------
;; per-index inactivity score update
;; ------------------------------------------------------------
dec $update_inactivity_one(beaconState, validatorIndex) : beaconState

;; case A: index ∈ unslashed participating (prev epoch)
def $update_inactivity_one(state, validatorIndex_vi) = state_after
  -- if $get_previous_epoch(state) = epoch_prev
  -- if $get_unslashed_participating_indices(state, $TIMELY_TARGET_FLAG_INDEX, epoch_prev) = validatorIndex_participating_prev*
  -- if ( validatorIndex_vi <- validatorIndex_participating_prev* )
  -- if $(validatorIndex_vi < |state.INACTIVITY_SCORES|)
  -- if state.INACTIVITY_SCORES[validatorIndex_vi] = uint64_s0
  -- if $min_uint64(1, uint64_s0) = uint64_dec1
  -- if $(uint64_s0 - uint64_dec1) = uint64_s1
  -- if state.INACTIVITY_SCORES[[validatorIndex_vi] = uint64_s1] = uint64_scores_mid*
  -- if state_mid = state[.INACTIVITY_SCORES = uint64_scores_mid*]
  ;; leak-free 추가 회복(감소)
  -- if $is_in_inactivity_leak(state) = false
  -- if state_mid.INACTIVITY_SCORES[validatorIndex_vi] = uint64_s1_read
  -- if $min_uint64($INACTIVITY_SCORE_RECOVERY_RATE, uint64_s1_read) = uint64_dec2
  -- if $(uint64_s1_read - uint64_dec2) = uint64_s2
  -- if state_mid.INACTIVITY_SCORES[[validatorIndex_vi] = uint64_s2] = uint64_scores_after*
  -- if state_after = state_mid[.INACTIVITY_SCORES = uint64_scores_after*]

def $update_inactivity_one(state, validatorIndex_vi) = state_mid
  -- if $get_previous_epoch(state) = epoch_prev
  -- if $get_unslashed_participating_indices(state, $TIMELY_TARGET_FLAG_INDEX, epoch_prev) = validatorIndex_participating_prev*
  -- if ( validatorIndex_vi <- validatorIndex_participating_prev* )
  -- if $(validatorIndex_vi < |state.INACTIVITY_SCORES|)
  -- if state.INACTIVITY_SCORES[validatorIndex_vi] = uint64_s0
  -- if $min_uint64(1, uint64_s0) = uint64_dec1
  -- if $(uint64_s0 - uint64_dec1) = uint64_s1
  -- if state.INACTIVITY_SCORES[[validatorIndex_vi] = uint64_s1] = uint64_scores_mid*
  -- if $is_in_inactivity_leak(state) = true
  -- if state_mid = state[.INACTIVITY_SCORES = uint64_scores_mid*]

;; case B: index ∉ unslashed participating (prev epoch)
def $update_inactivity_one(state, validatorIndex_vi) = state_after
  -- if $get_previous_epoch(state) = epoch_prev
  -- if $get_unslashed_participating_indices(state, $TIMELY_TARGET_FLAG_INDEX, epoch_prev) = validatorIndex_participating_prev*
  -- if ~( validatorIndex_vi <- validatorIndex_participating_prev* )
  -- if $(validatorIndex_vi < |state.INACTIVITY_SCORES|)
  -- if state.INACTIVITY_SCORES[validatorIndex_vi] = uint64_s0
  -- if $(uint64_s0 + $INACTIVITY_SCORE_BIAS) = uint64_s1
  -- if state.INACTIVITY_SCORES[[validatorIndex_vi] = uint64_s1] = uint64_scores_mid*
  -- if state_mid = state[.INACTIVITY_SCORES = uint64_scores_mid*]
  ;; leak-free 추가 회복(감소)
  -- if $is_in_inactivity_leak(state) = false
  -- if state_mid.INACTIVITY_SCORES[validatorIndex_vi] = uint64_s1_read
  -- if $min_uint64($INACTIVITY_SCORE_RECOVERY_RATE, uint64_s1_read) = uint64_dec2
  -- if $(uint64_s1_read - uint64_dec2) = uint64_s2
  -- if state_mid.INACTIVITY_SCORES[[validatorIndex_vi] = uint64_s2] = uint64_scores_after*
  -- if state_after = state_mid[.INACTIVITY_SCORES = uint64_scores_after*]

def $update_inactivity_one(state, validatorIndex_vi) = state_mid
  -- if $get_previous_epoch(state) = epoch_prev
  -- if $get_unslashed_participating_indices(state, $TIMELY_TARGET_FLAG_INDEX, epoch_prev) = validatorIndex_participating_prev*
  -- if ~( validatorIndex_vi <- validatorIndex_participating_prev* )
  -- if $(validatorIndex_vi < |state.INACTIVITY_SCORES|)
  -- if state.INACTIVITY_SCORES[validatorIndex_vi] = uint64_s0
  -- if $(uint64_s0 + $INACTIVITY_SCORE_BIAS) = uint64_s1
  -- if state.INACTIVITY_SCORES[[validatorIndex_vi] = uint64_s1] = uint64_scores_mid*
  -- if $is_in_inactivity_leak(state) = true
  -- if state_mid = state[.INACTIVITY_SCORES = uint64_scores_mid*]


;; fold helper (beaconState, validatorIndex) -> beaconState
dec $apply_inactivity_one(beaconState, validatorIndex) : beaconState
def $apply_inactivity_one(state, validatorIndex_vi) = state_updated
  -- if state_updated = $update_inactivity_one(state, validatorIndex_vi)

;; --------------------------------------------
;; predicate: (i, v)가 이번 epoch에 슬래시 벌점 집행 대상인가?
;;  v.SLASHED = true  ∧  epoch + (EPOCHS_PER_SLASHINGS_VECTOR / 2) = v.WITHDRAWABLE_EPOCH
;; --------------------------------------------
dec $is_due_slashing_en(enumerated_<validator>, epoch) : boolean

def $is_due_slashing_en((nat_i, validator_v), epoch_cur) = true
  -- if $(validator_v.SLASHED = true)
  -- if $( epoch_cur + ($EPOCHS_PER_SLASHINGS_VECTOR / 2) = validator_v.WITHDRAWABLE_EPOCH )

def $is_due_slashing_en((nat_i, validator_v), epoch_cur) = false
  -- otherwise


;; --------------------------------------------
;; map: (i, v) ↦ (ValidatorIndex(i), penalty)
;; capture: (gwei_adj_total_slash, gwei_total_active)
;; penalty = ((v.EFFECTIVE_BALANCE / INC) * gwei_adj_total_slash / gwei_total_active) * INC
;; --------------------------------------------
dec $compute_slash_penalty_en((nat, validator), (gwei, gwei)) : (validatorIndex, gwei)

def $compute_slash_penalty_en((nat_i, validator_v), (gwei_adj_total_slash, gwei_total_active))
  = (validatorIndex_vi, gwei_penalty)
  -- if validatorIndex_vi = nat_i                 ;; nat → validatorIndex
  -- if $EFFECTIVE_BALANCE_INCREMENT = gwei_inc 
  -- if $( validator_v.EFFECTIVE_BALANCE / gwei_inc ) = uint64_incs 
  -- if $( uint64_incs * gwei_adj_total_slash ) = gwei_pen_num 
  -- if $( gwei_pen_num / gwei_total_active ) = gwei_pen_div 
  -- if $( gwei_pen_div * gwei_inc ) = gwei_penalty 


;; --------------------------------------------
;; fold 함수: 한 건의 (vi, penalty)를 state에 적용
;; --------------------------------------------
dec $apply_one_decrease(beaconState, (validatorIndex, gwei)) : beaconState

def $apply_one_decrease(state_in, (validatorIndex_vi, gwei_penalty)) = state_out
  -- if state_out = $decrease_balance(state_in, validatorIndex_vi, gwei_penalty)

;; ============================================================
;; weigh_justification_and_finalization
;;   inputs: (state_in, gwei_total_active, gwei_prev_tgt, gwei_cur_tgt)
;;   output: state_out
;; 공통 기호:
;;   epoch_prev = $get_previous_epoch(state_in)
;;   epoch_cur  = $get_current_epoch(state_in)
;;   checkpoint_old_prev   = state_in.PREVIOUS_JUSTIFIED_CHECKPOINT
;;   checkpoint_old_cur    = state_in.CURRENT_JUSTIFIED_CHECKPOINT
;;   boolean_old_bits*  = state_in.JUSTIFICATION_BITS  (길이 ≥ 4 가정)
;;   shift 후 기본형: base_bits* = [ false, boolean_old_bits*[0], boolean_old_bits*[1], boolean_old_bits*[2] ]
;; 공통 보조 설명:
;;  P := (gwei_prev_tgt * 3 >= gwei_total_active * 2)
;;  C := (gwei_cur_tgt  * 3 >= gwei_total_active * 2)
;;  boolean_old_bits*[0]=b0', [1]=b1', [2]=b2', [3]=b3'
;;  boolean_bits_init*  = [ false, b0', b1', b2' ]
;;  P 반영: boolean_bits_after_P* = boolean_bits_init*            (P=0)
;;                        = boolean_bits_init*[[1] = true] (P=1)
;;  C 반영: boolean_bits_final*   = boolean_bits_after_P*         (C=0)
;;                        = boolean_bits_after_P*[[0] = true] (C=1)
;;  JC 갱신 순서:
;;   - PREVIOUS_JUSTIFIED_CHECKPOINT ← checkpoint_old_cur
;;   - if P=1 and C=0: CURRENT_JUSTIFIED_CHECKPOINT ← (epoch_prev, root_prev)
;;   - if C=1:         CURRENT_JUSTIFIED_CHECKPOINT ← (epoch_cur,  root_cur)
;;   - if P=0 and C=0: CURRENT_JUSTIFIED_CHECKPOINT 변화 없음
;;
;;  Finalize 조건:
;;   A: bits[1]&bits[2]&bits[3] = 1  ∧  checkpoint_old_prev.EPOCH + 3 = epoch_cur → FINALIZED = checkpoint_old_prev
;;   B: bits[1]&bits[2]        = 1  ∧  checkpoint_old_prev.EPOCH + 2 = epoch_cur → FINALIZED = checkpoint_old_prev
;;   C: bits[0]&bits[1]&bits[2] = 1 ∧  checkpoint_old_cur.EPOCH  + 2 = epoch_cur → FINALIZED = checkpoint_old_cur
;;   D: bits[0]&bits[1]        = 1  ∧  checkpoint_old_cur.EPOCH  + 1 = epoch_cur → FINALIZED = checkpoint_old_cur
;; ============================================================
dec $weigh_justification_and_finalization(beaconState, gwei, gwei, gwei) : beaconState

;; =========================
;; P=0, C=0  →  A / B / None  (3개)
;; =========================

def $weigh_justification_and_finalization(state_in, gwei_total_active, gwei_prev_tgt, gwei_cur_tgt) = state_out
  ;; P=0, C=0, Finalize A
  -- if $get_previous_epoch(state_in) = epoch_prev
  -- if $get_current_epoch(state_in)  = epoch_cur
  -- if checkpoint_old_prev = state_in.PREVIOUS_JUSTIFIED_CHECKPOINT
  -- if checkpoint_old_cur  = state_in.CURRENT_JUSTIFIED_CHECKPOINT
  -- if boolean_old_bits* = state_in.JUSTIFICATION_BITS
  -- if boolean_old_bits*[0] = boolean_b0p
  -- if boolean_old_bits*[1] = boolean_b1p
  -- if boolean_old_bits*[2] = boolean_b2p
  -- if boolean_bits_init*   = [ false, boolean_b0p, boolean_b1p, boolean_b2p ]
  -- if $(gwei_prev_tgt * 3 >= gwei_total_active * 2) = false   ;; P=0
  -- if $(gwei_cur_tgt  * 3 >= gwei_total_active * 2) = false   ;; C=0
  -- if boolean_bits_after_P* = boolean_bits_init*
  -- if boolean_bits_final*   = boolean_bits_after_P*
  ;; update JC (prev ← checkpoint_old_cur; curr unchanged)
  -- if state_pj = state_in[.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_old_cur]
  -- if state_bits = state_pj[.JUSTIFICATION_BITS = boolean_bits_final*]
  ;; Finalize A: bits[1]=1,bits[2]=1,bits[3]=1 & checkpoint_old_prev.EPOCH+3=epoch_cur
  -- if boolean_bits_final*[1] = true
  -- if boolean_bits_final*[2] = true
  -- if boolean_bits_final*[3] = true
  -- if $(checkpoint_old_prev.EPOCH + 3 = epoch_cur)
  -- if state_out = state_bits[.FINALIZED_CHECKPOINT = checkpoint_old_prev]

def $weigh_justification_and_finalization(state_in, gwei_total_active, gwei_prev_tgt, gwei_cur_tgt) = state_out
  ;; P=0, C=0, Finalize B
  -- if $get_previous_epoch(state_in) = epoch_prev
  -- if $get_current_epoch(state_in)  = epoch_cur
  -- if checkpoint_old_prev = state_in.PREVIOUS_JUSTIFIED_CHECKPOINT
  -- if checkpoint_old_cur  = state_in.CURRENT_JUSTIFIED_CHECKPOINT
  -- if boolean_old_bits* = state_in.JUSTIFICATION_BITS
  -- if boolean_old_bits*[0] = boolean_b0p
  -- if boolean_old_bits*[1] = boolean_b1p
  -- if boolean_old_bits*[2] = boolean_b2p
  -- if boolean_bits_init*   = [ false, boolean_b0p, boolean_b1p, boolean_b2p ]
  -- if $(gwei_prev_tgt * 3 >= gwei_total_active * 2) = false
  -- if $(gwei_cur_tgt  * 3 >= gwei_total_active * 2) = false
  -- if boolean_bits_after_P* = boolean_bits_init*
  -- if boolean_bits_final*   = boolean_bits_after_P*
  -- if state_pj = state_in[.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_old_cur]
  -- if state_bits = state_pj[.JUSTIFICATION_BITS = boolean_bits_final*]
  ;; Finalize B
  -- if boolean_bits_final*[1] = true
  -- if boolean_bits_final*[2] = true
  -- if $(checkpoint_old_prev.EPOCH + 2 = epoch_cur)
  -- if state_out = state_bits[.FINALIZED_CHECKPOINT = checkpoint_old_prev]

def $weigh_justification_and_finalization(state_in, gwei_total_active, gwei_prev_tgt, gwei_cur_tgt) = state_out
  ;; P=0, C=0, None
  -- if $get_previous_epoch(state_in) = epoch_prev
  -- if $get_current_epoch(state_in)  = epoch_cur
  -- if checkpoint_old_cur  = state_in.CURRENT_JUSTIFIED_CHECKPOINT
  -- if boolean_old_bits* = state_in.JUSTIFICATION_BITS
  -- if boolean_old_bits*[0] = boolean_b0p
  -- if boolean_old_bits*[1] = boolean_b1p
  -- if boolean_old_bits*[2] = boolean_b2p
  -- if boolean_bits_init*   = [ false, boolean_b0p, boolean_b1p, boolean_b2p ]
  -- if $(gwei_prev_tgt * 3 >= gwei_total_active * 2) = false
  -- if $(gwei_cur_tgt  * 3 >= gwei_total_active * 2) = false
  -- if boolean_bits_after_P* = boolean_bits_init*
  -- if boolean_bits_final*   = boolean_bits_after_P*
  -- if state_pj = state_in[.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_old_cur]
  -- if state_out = state_pj[.JUSTIFICATION_BITS = boolean_bits_final*]


;; =========================
;; P=1, C=0  →  A / B / None  (3개)
;; =========================

def $weigh_justification_and_finalization(state_in, gwei_total_active, gwei_prev_tgt, gwei_cur_tgt) = state_out
  ;; P=1, C=0, Finalize A
  -- if $get_previous_epoch(state_in) = epoch_prev
  -- if $get_current_epoch(state_in)  = epoch_cur
  -- if checkpoint_old_prev = state_in.PREVIOUS_JUSTIFIED_CHECKPOINT
  -- if checkpoint_old_cur  = state_in.CURRENT_JUSTIFIED_CHECKPOINT
  -- if boolean_old_bits* = state_in.JUSTIFICATION_BITS
  -- if boolean_old_bits*[0] = boolean_b0p
  -- if boolean_old_bits*[1] = boolean_b1p
  -- if boolean_old_bits*[2] = boolean_b2p
  -- if boolean_bits_init*   = [ false, boolean_b0p, boolean_b1p, boolean_b2p ]
  -- if $(gwei_prev_tgt * 3 >= gwei_total_active * 2) = true    ;; P=1
  -- if $(gwei_cur_tgt  * 3 >= gwei_total_active * 2) = false   ;; C=0
  -- if boolean_bits_after_P* = boolean_bits_init*[[1] = true]
  -- if boolean_bits_final*   = boolean_bits_after_P*
  ;; JC 업데이트 (prev ← checkpoint_old_cur; curr ← (epoch_prev, root_prev))
  -- if $get_block_root(state_in, epoch_prev) = root_prev
  -- if checkpoint_prev = { EPOCH epoch_prev, ROOT root_prev }
  -- if state_pj  = state_in[.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_old_cur]
  -- if state_cj  = state_pj[.CURRENT_JUSTIFIED_CHECKPOINT  = checkpoint_prev]
  -- if state_bits = state_cj[.JUSTIFICATION_BITS = boolean_bits_final*]
  ;; Finalize A
  -- if boolean_bits_final*[1] = true
  -- if boolean_bits_final*[2] = true
  -- if boolean_bits_final*[3] = true
  -- if $(checkpoint_old_prev.EPOCH + 3 = epoch_cur)
  -- if state_out = state_bits[.FINALIZED_CHECKPOINT = checkpoint_old_prev]

def $weigh_justification_and_finalization(state_in, gwei_total_active, gwei_prev_tgt, gwei_cur_tgt) = state_out
  ;; P=1, C=0, Finalize B
  -- if $get_previous_epoch(state_in) = epoch_prev
  -- if $get_current_epoch(state_in)  = epoch_cur
  -- if checkpoint_old_prev = state_in.PREVIOUS_JUSTIFIED_CHECKPOINT
  -- if checkpoint_old_cur  = state_in.CURRENT_JUSTIFIED_CHECKPOINT
  -- if boolean_old_bits* = state_in.JUSTIFICATION_BITS
  -- if boolean_old_bits*[0] = boolean_b0p
  -- if boolean_old_bits*[1] = boolean_b1p
  -- if boolean_old_bits*[2] = boolean_b2p
  -- if boolean_bits_init*   = [ false, boolean_b0p, boolean_b1p, boolean_b2p ]
  -- if $(gwei_prev_tgt * 3 >= gwei_total_active * 2) = true
  -- if $(gwei_cur_tgt  * 3 >= gwei_total_active * 2) = false
  -- if boolean_bits_after_P* = boolean_bits_init*[[1] = true]
  -- if boolean_bits_final*   = boolean_bits_after_P*
  -- if $get_block_root(state_in, epoch_prev) = root_prev
  -- if checkpoint_prev = { EPOCH epoch_prev, ROOT root_prev }
  -- if state_pj  = state_in[.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_old_cur]
  -- if state_cj  = state_pj[.CURRENT_JUSTIFIED_CHECKPOINT  = checkpoint_prev]
  -- if state_bits = state_cj[.JUSTIFICATION_BITS = boolean_bits_final*]
  ;; Finalize B
  -- if boolean_bits_final*[1] = true
  -- if boolean_bits_final*[2] = true
  -- if $(checkpoint_old_prev.EPOCH + 2 = epoch_cur)
  -- if state_out = state_bits[.FINALIZED_CHECKPOINT = checkpoint_old_prev]

def $weigh_justification_and_finalization(state_in, gwei_total_active, gwei_prev_tgt, gwei_cur_tgt) = state_out
  ;; P=1, C=0, None
  -- if $get_previous_epoch(state_in) = epoch_prev
  -- if checkpoint_old_cur  = state_in.CURRENT_JUSTIFIED_CHECKPOINT
  -- if boolean_old_bits* = state_in.JUSTIFICATION_BITS
  -- if boolean_old_bits*[0] = boolean_b0p
  -- if boolean_old_bits*[1] = boolean_b1p
  -- if boolean_old_bits*[2] = boolean_b2p
  -- if boolean_bits_init*   = [ false, boolean_b0p, boolean_b1p, boolean_b2p ]
  -- if $(gwei_prev_tgt * 3 >= gwei_total_active * 2) = true
  -- if $(gwei_cur_tgt  * 3 >= gwei_total_active * 2) = false
  -- if boolean_bits_after_P* = boolean_bits_init*[[1] = true]
  -- if boolean_bits_final*   = boolean_bits_after_P*
  -- if $get_block_root(state_in, epoch_prev) = root_prev
  -- if checkpoint_prev = { EPOCH epoch_prev, ROOT root_prev }
  -- if state_pj  = state_in[.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_old_cur]
  -- if state_cj  = state_pj[.CURRENT_JUSTIFIED_CHECKPOINT  = checkpoint_prev]
  -- if state_out = state_cj[.JUSTIFICATION_BITS = boolean_bits_final*]


;; =========================
;; P=0, C=1  →  A / B / C / D / None  (5개)
;; =========================

def $weigh_justification_and_finalization(state_in, gwei_total_active, gwei_prev_tgt, gwei_cur_tgt) = state_out
  ;; P=0, C=1, Finalize A  (비트·에폭이 허용하면 가능)
  -- if $get_previous_epoch(state_in) = epoch_prev
  -- if $get_current_epoch(state_in)  = epoch_cur
  -- if checkpoint_old_prev = state_in.PREVIOUS_JUSTIFIED_CHECKPOINT
  -- if checkpoint_old_cur  = state_in.CURRENT_JUSTIFIED_CHECKPOINT
  -- if boolean_old_bits* = state_in.JUSTIFICATION_BITS
  -- if boolean_old_bits*[0] = boolean_b0p
  -- if boolean_old_bits*[1] = boolean_b1p
  -- if boolean_old_bits*[2] = boolean_b2p
  -- if boolean_bits_init*   = [ false, boolean_b0p, boolean_b1p, boolean_b2p ]
  -- if $(gwei_prev_tgt * 3 >= gwei_total_active * 2) = false   ;; P=0
  -- if $(gwei_cur_tgt  * 3 >= gwei_total_active * 2) = true    ;; C=1
  -- if boolean_bits_after_P* = boolean_bits_init*
  -- if boolean_bits_final*   = boolean_bits_after_P*[[0] = true]
  ;; JC 업데이트 (prev ← checkpoint_old_cur; curr ← (epoch_cur, root_cur))
  -- if $get_block_root(state_in, epoch_cur) = root_cur
  -- if checkpoint_cur = { EPOCH epoch_cur, ROOT root_cur }
  -- if state_pj  = state_in[.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_old_cur]
  -- if state_cj  = state_pj[.CURRENT_JUSTIFIED_CHECKPOINT  = checkpoint_cur]
  -- if state_bits = state_cj[.JUSTIFICATION_BITS = boolean_bits_final*]
  ;; Finalize A
  -- if boolean_bits_final*[1] = true
  -- if boolean_bits_final*[2] = true
  -- if boolean_bits_final*[3] = true
  -- if $(checkpoint_old_prev.EPOCH + 3 = epoch_cur)
  -- if state_out = state_bits[.FINALIZED_CHECKPOINT = checkpoint_old_prev]

def $weigh_justification_and_finalization(state_in, gwei_total_active, gwei_prev_tgt, gwei_cur_tgt) = state_out
  ;; P=0, C=1, Finalize B
  -- if $get_previous_epoch(state_in) = epoch_prev
  -- if $get_current_epoch(state_in)  = epoch_cur
  -- if checkpoint_old_prev = state_in.PREVIOUS_JUSTIFIED_CHECKPOINT
  -- if checkpoint_old_cur  = state_in.CURRENT_JUSTIFIED_CHECKPOINT
  -- if boolean_old_bits* = state_in.JUSTIFICATION_BITS
  -- if boolean_old_bits*[0] = boolean_b0p
  -- if boolean_old_bits*[1] = boolean_b1p
  -- if boolean_old_bits*[2] = boolean_b2p
  -- if boolean_bits_init*   = [ false, boolean_b0p, boolean_b1p, boolean_b2p ]
  -- if $(gwei_prev_tgt * 3 >= gwei_total_active * 2) = false
