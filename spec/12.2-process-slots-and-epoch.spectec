;;
;; Epoch processing 
;;

relation ProcessEpoch:
  beaconState ~>* beaconState
  hint(input %0)

rule ProcessEpoch/main:
  state_beaconState ~>* state_11
  ;; 디버깅: ProcessEpoch 시작 전 balances (validator 42, 257, 508)
  -- if state_beaconState.BALANCES[42] = gwei_balance_42_before_epoch
  -- if state_beaconState.BALANCES[257] = gwei_balance_257_before_epoch
  -- if $debug_print_label_<gwei>("ProcessEpoch: balance[42] before", gwei_balance_42_before_epoch) = gwei_balance_42_before_epoch_dbg
  -- if $debug_print_label_<gwei>("ProcessEpoch: balance[257] before", gwei_balance_257_before_epoch) = gwei_balance_257_before_epoch_dbg
  -- Process_justification_and_finalization:  state_beaconState ~> state_0
  -- Process_inactivity_updates:              state_0           ~> state_1
  ;; 디버깅: Process_rewards_and_penalties 전 balances (validator 42, 257, 508)
  -- if state_1.BALANCES[42] = gwei_balance_42_before_rewards
  -- if state_1.BALANCES[257] = gwei_balance_257_before_rewards
  -- if $debug_print_label_<gwei>("ProcessEpoch: balance[42] before rewards", gwei_balance_42_before_rewards) = gwei_balance_42_before_rewards_dbg
  -- if $debug_print_label_<gwei>("ProcessEpoch: balance[257] before rewards", gwei_balance_257_before_rewards) = gwei_balance_257_before_rewards_dbg
  -- Process_rewards_and_penalties:           state_1           ~> state_2
  ;; 디버깅: Process_rewards_and_penalties 후 balances (validator 42, 257, 508)
  -- if state_2.BALANCES[42] = gwei_balance_42_after_rewards
  -- if state_2.BALANCES[257] = gwei_balance_257_after_rewards
  -- if $debug_print_label_<gwei>("ProcessEpoch: balance[42] after rewards", gwei_balance_42_after_rewards) = gwei_balance_42_after_rewards_dbg
  -- if $debug_print_label_<gwei>("ProcessEpoch: balance[257] after rewards", gwei_balance_257_after_rewards) = gwei_balance_257_after_rewards_dbg
  -- Process_registry_updates:                state_2           ~> state_3
  -- Process_slashings:                       state_3           ~> state_4
  -- Process_eth1_data_reset:                 state_4           ~> state_5
  -- Process_effective_balance_updates:       state_5           ~> state_6
  -- Process_slashings_reset:                 state_6           ~> state_7
  -- Process_randao_mixes_reset:              state_7           ~> state_8
  -- Process_historical_summaries_update:     state_8           ~> state_9
  -- Process_participation_flag_updates:      state_9           ~> state_10
  -- Process_sync_committee_updates:          state_10          ~> state_11
  ;; 디버깅: ProcessEpoch 완료 후 balances (validator 42, 257, 508)
  -- if state_11.BALANCES[42] = gwei_balance_42_after_epoch
  -- if state_11.BALANCES[257] = gwei_balance_257_after_epoch
  -- if $debug_print_label_<gwei>("ProcessEpoch: balance[42] after", gwei_balance_42_after_epoch) = gwei_balance_42_after_epoch_dbg
  -- if $debug_print_label_<gwei>("ProcessEpoch: balance[257] after", gwei_balance_257_after_epoch) = gwei_balance_257_after_epoch_dbg

;;
;; process_slots
;;
relation Process_slots_loop:
  beaconState slot ~> beaconState
  hint(input %0 %1)

;; 종료: state.SLOT >= slot_target
rule Process_slots_loop/base:
  state_in slot_target ~> state_in
  -- if $( state_in.SLOT < slot_target ) = false

;; step (epoch 경계 아님)
rule Process_slots_loop/step-no-epoch:
  state_in slot_target ~> state_out
  -- if $( state_in.SLOT < slot_target ) = true
  -- Process_slot: state_in ~> state_after_slot
  -- if slot_cur = state_after_slot.SLOT
  -- if $( slot_cur + 1 ) = slot_next
  -- if $( slot_next \ $SLOTS_PER_EPOCH ) = nat_mod
  -- if ~( nat_mod = 0 )
  -- if state_inc = state_after_slot[.SLOT = slot_next]
  -- Process_slots_loop: state_inc slot_target ~> state_out

;; step (epoch 경계)
rule Process_slots_loop/step-epoch:
  state_in slot_target ~> state_out
  -- if $( state_in.SLOT < slot_target ) = true
  -- Process_slot: state_in ~> state_after_slot
  -- if slot_cur = state_after_slot.SLOT
  -- if $( slot_cur + 1 ) = slot_next
  -- if $( slot_next \ $SLOTS_PER_EPOCH ) = 0
  -- ProcessEpoch: state_after_slot ~>* state_after_epoch
  -- if state_inc = state_after_epoch[.SLOT = slot_next]
  -- Process_slots_loop: state_inc slot_target ~> state_out


relation Process_slots:
  beaconState slot ~> beaconState
  hint(input %0 %1)

rule Process_slots/main:
  state_in slot_target ~> state_out
  -- if $( state_in.SLOT < slot_target )
  ;; 디버깅: Process_slots 시작 전 balances (validator 42, 257, 508)
  -- if state_in.BALANCES[42] = gwei_balance_42_before_slots
  -- if state_in.BALANCES[257] = gwei_balance_257_before_slots
  -- if $debug_print_label_<gwei>("Process_slots: balance[42] before", gwei_balance_42_before_slots) = gwei_balance_42_before_slots_dbg
  -- if $debug_print_label_<gwei>("Process_slots: balance[257] before", gwei_balance_257_before_slots) = gwei_balance_257_before_slots_dbg
  -- Process_slots_loop: state_in slot_target ~> state_out
  ;; 디버깅: Process_slots 완료 후 balances (validator 42, 257, 508)
  -- if state_out.BALANCES[42] = gwei_balance_42_after_slots
  -- if state_out.BALANCES[257] = gwei_balance_257_after_slots
  -- if $debug_print_label_<gwei>("Process_slots: balance[42] after", gwei_balance_42_after_slots) = gwei_balance_42_after_slots_dbg
  -- if $debug_print_label_<gwei>("Process_slots: balance[257] after", gwei_balance_257_after_slots) = gwei_balance_257_after_slots_dbg
