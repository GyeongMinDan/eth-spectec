;; state_transition(state, signed_block, validate_result) : beaconState

relation State_transition:
  beaconState signedBeaconBlock boolean ~>* beaconState
  hint(input %0 %1 %2)

;; validate_result = true
rule State_transition/validate:
  state signedBeaconBlock true ~>* state_next
  -- if signedBeaconBlock.MESSAGE = beaconBlock
  ;; Process slots (including those with no blocks) since block
  -- ProcessSlots: state beaconBlock.SLOT ~> state_cur
  ;; assert (if validate)
  -- if $verify_block_signature(state_cur, signedBeaconBlock)
  -- ProcessBlock: state_cur beaconBlock ~>* state_next
  ;; assert (if validate)
  -- if $(beaconBlock.STATE_ROOT = $hash_tree_root_beaconState(state_next))

;; validate_result = false
rule State_transition/skip-validate:
  state signedBeaconBlock false ~>* state_next
  ;; assert
  -- if signedBeaconBlock.MESSAGE = beaconBlock
  -- ProcessSlots: state beaconBlock.SLOT ~> state_cur
  -- ProcessBlock: state_cur beaconBlock ~>* state_next
