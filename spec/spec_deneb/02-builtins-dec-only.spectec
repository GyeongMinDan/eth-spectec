;; =========================
;; builtins-decls.spectec
;; =========================

;; --- BLS cryptography ---
dec $bls_verify(blsPubkey, root, blsSignature) : boolean
dec $bls_fast_aggregate_verify(blsPubkey*, root, blsSignature) : boolean
dec $eth_aggregate_pubkeys(blsPubkey*) : blsPubkey

;; hash
dec $hash_<X>(X) : bytes32

;; Debug functions
dec $debug_print_<X>(X) : X
dec $debug_print_label_<X>(text, X) : X

;; --- hash_tree_root ---
dec $hash_tree_root_beaconBlockHeader(beaconBlockHeader) : root
dec $hash_tree_root_beaconBlockBody(beaconBlockBody) : root
dec $hash_tree_root_depositData(depositData) : root
dec $hash_tree_root_forkdata(forkdata) : root
dec $hash_tree_root_beaconState(beaconState) : root
dec $hash_tree_root_withdrawals(withdrawal*) : root
dec $hash_tree_root_beaconBlock(beaconBlock) : root

dec $hash_tree_root_roots(root*) : root
dec $hash_tree_root_tx(bytes*) : root


;; --- compute signing root ---
dec $compute_signing_root_epoch(epoch, domain) : root
dec $compute_signing_root_voluntary_exit(voluntaryExit, domain) : root
dec $compute_signing_root_bls_to_execution_change(blsToExecutionChange, domain) : root
dec $compute_signing_root_beaconBlockHeader(beaconBlockHeader, domain) : root
dec $compute_signing_root_attestationData(attestationData, domain) : root
dec $compute_signing_root_depositMessage(depositMessage, domain) : root
dec $compute_signing_root_block_root(bytes32, domain) : root
dec $compute_signing_root_beaconBlock(beaconBlock, domain) : root

;; --- merkle validation ---
dec $is_valid_merkle_branch(bytes32, bytes32*, uint64, uint64, root) : boolean

dec $integer_square_root(uint64) : uint64

;; count occurrences of X in X*
dec $count_occurrences_<X>(X*, X) : nat

;; --- pow2(nat) -> 2 ^ nat --- 
dec $pow2(nat) : nat

;; dedup lists
dec $to_set_<X>(X*) : X*

;; sum over list
dec $sum_<X>(X*) : X

;; generate a list of X repeated nat times
dec $repeat_<X>(X, nat) : X*

;; sort in ascending order
dec $sort_<X>(X*) : X*       

;; common elements in two lists
dec $set_intersection_<X>(X*, X*) : X*

;; set_or_append_list : X* × nat × X → X*
;; if len(X*) == nat -> X*.append(X)
;; else X*[nat] = X
dec $set_or_append_list_<X>(X*, nat, X) : X*


;; python for statement range funcs
dec $range(nat) : nat*

;; enumerate
dec $enumerate_<X>(X*) : enumerated_<X>*


;; --- byte utils ---
dec $bytes_to_uint64(bytes32) : uint64
dec $uint_to_bytes(uint) : bytes
dec $xor(bytes32, bytes32) : bytes32
dec $first_28_bytes(bytes32) : bytes28
dec $get_first_byte(bytes32) : bytes1
dec $strip_first_byte(bytes32) : bytes31
dec $concat_domain(domainType, bytes28) : domain
dec $make_withdrawal_credentials_eth1(executionAddress) : bytes32
;; [Deneb]
;; Used in kzg_commitment_to_versioned_hash
dec $make_versioned_hash(bytes1, bytes31) : bytes32

;; Fixed-width Little-Endian encoders (for eth2spec compatibility)
dec $uint8_to_bytes_le(uint8) : bytes
dec $uint32_to_bytes_le(uint32) : bytes
dec $uint64_to_bytes_le(uint64) : bytes
dec $bytes32_prefix8(bytes32) : bytes
dec $bytes8_to_uint64_le(bytes) : uint64

;; Bitwise operations
dec $shr_uint64(uint64, nat) : uint64
dec $and_uint64(uint64, uint64) : uint64

;; type conversions
dec $bytes32_to_bytes1_list(bytes32) : bytes1*
dec $bytes1_to_uint64(bytes1) : uint64

dec $concat_bytes(bytes, bytes) : bytes

dec $bytes32_to_bytes(bytes32) : bytes
dec $bytes4_to_bytes(bytes4) : bytes 

;; bytes32 withdrawal_credentials → executionAddress
;; bytes32 X -> X[12:] -> last 20 bytes
dec $extract_execution_address(bytes32) : executionAddress
