  -- if $( $get_total_active_balance(state) / $EFFECTIVE_BALANCE_INCREMENT ) = uint64_active_increments
  -- if $range(|state.VALIDATORS|) = vid*
  ;; instead of iterating over the eligible indices, iterate over all indices and set 0 for non-eligible ones.
  -- if (
          $flag_reward_one_eligible(
            vid,
            state,
            vid_unslashed*,
            vid_eligible*,
            uint64_weight,
            uint64_unslashed_increments,
            uint64_active_increments
          )
          = reward)*
  -- if (
          $flag_penalty_one_eligible(
            vid,
            state,
            vid_unslashed*,
            vid_eligible*,
            uint64_weight,
