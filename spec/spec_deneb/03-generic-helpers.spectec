;; index_of_pubkey(state, pk) : validatorIndex
;; --------------------------------------------
dec $index_of_pubkey(beaconState, blsPubkey) : validatorIndex

def $index_of_pubkey(state, blsPubkey_pk) = validatorIndex_idx
  -- if state.VALIDATORS = validator_list*
  -- if $enumerate_<validator>(validator_list*) = (n_i, validator_v)*
  -- if $filter_list_2_<(nat, validator), blsPubkey>(
         (n_i, validator_v)*,
         blsPubkey_pk,
         def $pubkey_match_en
       ) = (n_sel, validator_sel)*
  -- if $( |(n_sel, validator_sel)*| ) = 1
  -- if (nat_n0, validator_v0) = (n_sel, validator_sel)*[0]
  -- if $pick_index_en_validator((nat_n0, validator_v0)) = validatorIndex_idx

