;; =========================
;; generic helpers
;; =========================

;; =========================
;; filter_list (if bool) (X* -> X*)
;; =========================
dec $filter_list_<X>(X*, def $cond(X) : bool)
  : X*
def $filter_list_<X>(eps, def $cond) = eps
def $filter_list_<X>(X_h :: X_t*, def $cond)
  = X_h :: $filter_list_<X>(X_t*, def $cond)
  -- if $cond(X_h) = true
def $filter_list_<X>(X_h :: X_t*, def $cond)
  = $filter_list_<X>(X_t*, def $cond)
  -- if $cond(X_h) = false

dec $filter_list_2_<X, Y>(X*, Y, def $cond(X, Y) : bool) : X*
def $filter_list_2_<X, Y>(eps, Y, def $cond) = eps
def $filter_list_2_<X, Y>(X_h :: X_t*, Y, def $cond)
  = X_h :: $filter_list_2_<X, Y>(X_t*, Y, def $cond)
  -- if $cond(X_h, Y) = true
def $filter_list_2_<X, Y>(X_h :: X_t*, Y, def $cond)
  = $filter_list_2_<X, Y>(X_t*, Y, def $cond)
  -- if $cond(X_h, Y) = false

;; =========================
;; Generic fold 
;; =========================
dec $fold_<X, Y>(def $fold_func(X, Y): X, X, Y*) : X
def $fold_<X, Y>(def $fold_func, X, eps) = X
def $fold_<X, Y>(def $fold_func, X, Y_h :: Y_t*)
= $fold_<X, Y>(def $fold_func, $fold_func(X, Y_h), Y_t*)


;; =========================
;; flag helpers
;; =========================
;; [Custom : ProcessAttestations / AddFlag ] has_flag: flags[i] = 1
dec $has_flag(participationFlags, nat) : boolean

;; range check for uint8
def $has_flag(participationFlags, n) = false
  -- if $( n >= 8 )
def $has_flag(participationFlags, n) = true
  -- if $( ((participationFlags / $pow2(n)) \ 2) = 1 )
def $has_flag(participationFlags, n) = false
  -- otherwise

;; [Custom : ProcessAttestations / AddFlag ] add_flag: flags[i] += 1
dec $add_flag(participationFlags, nat) : participationFlags

;; range check for uint8
def $add_flag(participationFlags, n) = participationFlags
  -- if $( n >= 8 )
def $add_flag(participationFlags, n) = participationFlags
  -- if $( ((participationFlags / $pow2(n)) \ 2) = 1 )
def $add_flag(participationFlags, n) = $( participationFlags + $pow2(n) )
  -- otherwise


;; =========================
;; max, min helpers
;; =========================
;; max for uint64
dec $max_uint64(uint64, uint64) : uint64
def $max_uint64(x, y) = x
  -- if $(x >= y)
def $max_uint64(x, y) = y
  -- otherwise

;; min for uint64
dec $min_uint64(uint64, uint64) : uint64
def $min_uint64(x, y) = x
  -- if $(x <= y)
def $min_uint64(x, y) = y
  -- otherwise

;; [Altair: ProcessSyncAggregate] eth_fast_aggregate_verify (missing in spec?)
dec $eth_fast_aggregate_verify(blsPubkey*, bytes32, blsSignature) : boolean

def $eth_fast_aggregate_verify(blsPubkey*, bytes32_msg, blsSignature) = true
  -- if |blsPubkey*| = 0
  -- if blsSignature = $G2_POINT_AT_INFINITY

def $eth_fast_aggregate_verify(blsPubkey*, bytes32_msg, blsSignature)
  = $bls_fast_aggregate_verify(blsPubkey*, bytes32_msg, blsSignature)
  -- otherwise

;; [Bellatrix: ProcessExecutionPayload] execution engine
dec $ee_verify_and_notify_new_payload(executionPayload) : bool

;; [Custom: ProcessSyncAggregate] index_of_pubkey(state, pk) : validatorIndex
dec $index_of_pubkey((validatorIndex, blsPubkey)*, blsPubkey) : validatorIndex

def $index_of_pubkey((vid_h, blsPubkey_h) :: (vid_t, blsPubkey_t)*, blsPubkey_committee) = vid_h
  -- if blsPubkey_h = blsPubkey_committee

def $index_of_pubkey((vid_h, blsPubkey_h) :: (vid_t, blsPubkey_t)*, blsPubkey_committee)
  = $index_of_pubkey((vid_t, blsPubkey_t)*, blsPubkey_committee)
  -- otherwise

