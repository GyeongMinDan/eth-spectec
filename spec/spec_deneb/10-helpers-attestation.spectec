;; [Phase0] compute_committee(Sequence[ValidatorIndex], Bytes32, uint64, uint64) : Sequence[ValidatorIndex]
dec $compute_committee(validatorIndex*, bytes32, uint64, uint64) : validatorIndex*

def $compute_committee(vid*, seed, i, count) = vid_committee*
  -- if $( (|vid*| * i) / count ) = i_start
  -- if $( (|vid*| * (i + 1)) / count ) = i_end
  -- if $range($(i_end - i_start)) = n*
  -- if $(n + i_start = i_range)*
  -- if ($compute_shuffled_index(i_range, |vid*|, seed) = i_shuffled)*
  -- if (vid*[i_shuffled] = vid_committee)*

;; [Phase0] get_committee_count_per_slot(BeaconState, Epoch) -> uint64
dec $get_committee_count_per_slot(beaconState, epoch) : uint64
def $get_committee_count_per_slot(state, epoch) 
  = $max_uint64(
      1,
      $min_uint64(
        $MAX_COMMITTEES_PER_SLOT,
        $( |$get_active_validator_indices(state, epoch)|
           / $SLOTS_PER_EPOCH
           / $TARGET_COMMITTEE_SIZE )
      )
    )

;; [Phase0] get_beacon_committee(BeaconState, Slot, CommitteeIndex) -> Sequence[ValidatorIndex]
dec $get_beacon_committee(beaconState, slot, committeeIndex) : validatorIndex*
def $get_beacon_committee(state, slot, committeeIndex)
  = $compute_committee(
      $get_active_validator_indices(state, epoch),
      $get_seed(state, epoch, $DOMAIN_BEACON_ATTESTER),
      $( (slot \ $SLOTS_PER_EPOCH) * count_committees_per_slot + committeeIndex ),
      $( count_committees_per_slot * $SLOTS_PER_EPOCH )
    )
  -- if $compute_epoch_at_slot(slot) = epoch
  -- if $get_committee_count_per_slot(state, epoch) = count_committees_per_slot

;; [Custom | filter : get_attesting_indices] aggregation_bits[i] = true
dec $bit_is_one_at_index((nat, validatorIndex), boolean*) : bool

def $bit_is_one_at_index((i, _), bit*)
  = bit*[i]
  ;; inserted guard
  -- if $(i < |bit*|)

;; [Phase0] get_attesting_indices(BeaconState, Attestation) -> Set[ValidatorIndex]
dec $get_attesting_indices(beaconState, attestation) : validatorIndex*

def $get_attesting_indices(state, attestation) = vid_set*
  -- if $get_beacon_committee(
         state,
         attestation.DATA.SLOT,
         attestation.DATA.INDEX
       ) = vid_committee*
  -- if $enumerate_<validatorIndex>(vid_committee*)
       = (i, vid)*
  -- if $filter_list_2_<(nat, validatorIndex), boolean*>(
         (i, vid)*,
         attestation.AGGREGATION_BITS,
         def $bit_is_one_at_index
       ) = (_, vid_attesting)*
  -- if $to_set_<validatorIndex>(vid_attesting*) = vid_set*

;; [Phase0] is_slashable_attestation_data(AttestationData, AttestationData) -> bool
dec $is_slashable_attestation_data(attestationData, attestationData) : bool
def $is_slashable_attestation_data(attestationData_1, attestationData_2) =
  ( ( attestationData_1 =/= attestationData_2 )
    /\ $( attestationData_1.TARGET.EPOCH = attestationData_2.TARGET.EPOCH ) ) ;;double vote
  \/
  ( $( attestationData_1.SOURCE.EPOCH < attestationData_2.SOURCE.EPOCH )
    /\ $( attestationData_2.TARGET.EPOCH < attestationData_1.TARGET.EPOCH ) ) ;;surround vote

;; [Phase0] is_valid_indexed_attestation(BeaconState, IndexedAttestation) -> bool
dec $is_valid_indexed_attestation(beaconState, indexedAttestation) : boolean
;; false: empty list
def $is_valid_indexed_attestation(state, indexedAttestation) = false
  -- if |indexedAttestation.ATTESTING_INDICES| = 0
;; false: not sorted
def $is_valid_indexed_attestation(state, indexedAttestation) = false
  -- if $sort_<validatorIndex>($to_set_<validatorIndex>(indexedAttestation.ATTESTING_INDICES))
  =/= indexedAttestation.ATTESTING_INDICES
;; otherwise
def $is_valid_indexed_attestation(state, indexedAttestation)
  = $bls_fast_aggregate_verify(blsPubkey*, root_signing, indexedAttestation.SIGNATURE)
  -- if vid* = indexedAttestation.ATTESTING_INDICES
  -- if $(|indexedAttestation.ATTESTING_INDICES| > 0)
  -- if $sort_<validatorIndex>($to_set_<validatorIndex>(indexedAttestation.ATTESTING_INDICES))
      = indexedAttestation.ATTESTING_INDICES
  -- if (state.VALIDATORS[vid].PUBKEY = blsPubkey)*
  -- if $get_domain(state, $DOMAIN_BEACON_ATTESTER, indexedAttestation.DATA.TARGET.EPOCH) = domain
  -- if $compute_signing_root_attestationData(indexedAttestation.DATA, domain) = root_signing

;; [Custom]
;;  modifies: .VALIDATORS[](.EXIT_EPOCH, .WITHDRAWABLE_EPOCH, .SLASHED) .SLASHINGS, .BALANCES
relation SlashIfEligible:
  beaconState SLASH`? `[ validatorIndex ] ~> beaconState `#SLASHED bool
  hint(input %0 %1)

rule SlashIfEligible/true:
  state SLASH`? `[ vid ] ~> state_slashed `#SLASHED true
  -- if $(vid < |state.VALIDATORS|)
  -- if $is_slashable_validator(state.VALIDATORS[vid], $get_current_epoch(state))
  -- SlashValidator: state SLASH `[ vid ] BY eps ~> state_slashed

rule SlashIfEligible/false:
  state SLASH`? `[ vid ] ~> state `#SLASHED false
  -- if $(vid < |state.VALIDATORS|)
  -- if ~$is_slashable_validator(state.VALIDATORS[vid], $get_current_epoch(state))

;; folder for SlashIfEligible
relation SlashIfEligible_over_validators:
  beaconState SLASH`? `[ validatorIndex* ] ~> beaconState `#SLASHED bool
  hint(input %0 %1)

rule SlashIfEligible_over_validators/nil:
  state SLASH`? `[ eps ] ~> state `#SLASHED false

rule SlashIfEligible_over_validators/cons:
  state SLASH`? `[ vid_h :: vid_t* ] ~> state_t `#SLASHED (bool_h \/ bool_t)
  -- SlashIfEligible: state SLASH`? `[ vid_h ] ~> state_h `#SLASHED bool_h
  -- SlashIfEligible_over_validators: state_h SLASH`? `[ vid_t* ] ~> state_t `#SLASHED bool_t

;; [Custom | branch : get_attestation_participation_flag_indices]
dec $source_flag_list(uint64) : nat*

def $source_flag_list(uint64_inclusion_delay)
  = [ $TIMELY_SOURCE_FLAG_INDEX ]
  -- if $(uint64_inclusion_delay <= $integer_square_root($SLOTS_PER_EPOCH))
def $source_flag_list(_) = eps
  -- otherwise

dec $target_flag_list(bool) : nat*

def $target_flag_list(bool_matching_target) 
  = [ $TIMELY_TARGET_FLAG_INDEX ]
  ;; Removed in [Deneb]
  ;;-- if $(uint64_inclusion_delay <= $SLOTS_PER_EPOCH)
def $target_flag_list(_) = eps
  -- otherwise
dec $head_flag_list(bool, uint64) : nat*

def $head_flag_list(bool_matching_head, uint64_inclusion_delay)
  = [ $TIMELY_HEAD_FLAG_INDEX ]
  -- if $(uint64_inclusion_delay = $MIN_ATTESTATION_INCLUSION_DELAY)
def $head_flag_list(_, _) = eps
  -- otherwise

