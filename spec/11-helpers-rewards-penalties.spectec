dec $get_flag_index_deltas(beaconState, nat) : (gwei*, gwei*)

def $get_flag_index_deltas(state_beaconState, nat_flag_index) = (gwei_rewards*, gwei_penalties*)
  -- if $( |state_beaconState.VALIDATORS| ) = uint64_N
  -- if $range(uint64_N) = nat_idx*
  -- if $get_previous_epoch(state_beaconState) = epoch_prev
  -- if $get_unslashed_participating_indices(
         state_beaconState, nat_flag_index, epoch_prev
       ) = validatorIndex_unslashed*
  -- if $PARTICIPATION_FLAG_WEIGHTS[nat_flag_index] = uint64_weight
  -- if $get_total_balance(state_beaconState, validatorIndex_unslashed*) = gwei_unslashed_bal
  -- if $( gwei_unslashed_bal / $EFFECTIVE_BALANCE_INCREMENT ) = uint64_up_incs
  -- if $get_total_active_balance(state_beaconState) = gwei_total_active
  -- if $( gwei_total_active / $EFFECTIVE_BALANCE_INCREMENT ) = uint64_active_incs
  ;; rewards: 참여 & (¬leak) 에만 분배
  ;; change map_list_2_
  -- if ($flag_reward_one(nat_idx, (state_beaconState, validatorIndex_unslashed*, uint64_weight, uint64_up_incs, uint64_active_incs)) = gwei_rewards)*
  ;; penalties: 미참여 & (flag != HEAD) 에만 부과
  ;; change map_list_2_
  -- if ($flag_penalty_one(nat_idx, (state_beaconState, validatorIndex_unslashed*, uint64_weight, nat_flag_index)) = gwei_penalties)*

