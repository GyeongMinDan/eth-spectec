;; --------------------------------------------
;; helpers for withdrawals
;; --------------------------------------------

;; 내부 루프:
;; (state, epoch, wi, vi, bound, i, withdrawal_acc*) → withdrawal_acc*
dec $expected_withdrawals_loop(
  beaconState, epoch, withdrawalIndex, validatorIndex, uint64, uint64, withdrawal*
) : withdrawal*

;; base 1: payload 한도
def $expected_withdrawals_loop(state_beaconState, epoch_epoch, withdrawalIndex_wi, validatorIndex_vi, uint64_bound, uint64_i, withdrawal_acc*)
  = withdrawal_acc*
  -- if $( |withdrawal_acc*| ) = $MAX_WITHDRAWALS_PER_PAYLOAD

;; base 2: bound 횟수 반복
def $expected_withdrawals_loop(state_beaconState, epoch_epoch, withdrawalIndex_wi, validatorIndex_vi, uint64_bound, uint64_i, withdrawal_acc*)
  = withdrawal_acc*
  -- if $( uint64_i >= uint64_bound )

;; step: 현재 vi 점검 → (전액/부분/미해당) 처리 → i+1, vi'로 진행
def $expected_withdrawals_loop(state_beaconState, epoch_epoch, withdrawalIndex_wi, validatorIndex_vi, uint64_bound, uint64_i, withdrawal_acc*)
  = withdrawal_out*
  -- if $(validatorIndex_vi < |state_beaconState.VALIDATORS|)
  -- if validator_v = state_beaconState.VALIDATORS[validatorIndex_vi]
  -- if gwei_balance = state_beaconState.BALANCES[validatorIndex_vi]
  ;; case A: fully withdrawable
  -- if $is_fully_withdrawable_validator(validator_v, gwei_balance, epoch_epoch) = true
  -- if executionAddress_addr = $extract_execution_address(validator_v.WITHDRAWAL_CREDENTIALS)
  -- if withdrawal_w =
       { INDEX           withdrawalIndex_wi,
         VALIDATOR_INDEX validatorIndex_vi,
         ADDRESS         executionAddress_addr,
         AMOUNT          gwei_balance }
  -- if withdrawal_sel* = ( withdrawal_acc* ++ [ withdrawal_w ] )
  -- if withdrawalIndex_next = $( withdrawalIndex_wi + 1 )
  ;; 다음 인덱스(원형 증가)
  -- if $( |state_beaconState.VALIDATORS| ) = uint64_N
  -- if $( (validatorIndex_vi + 1) \ uint64_N ) = validatorIndex_next
  -- if withdrawal_out* =
       $expected_withdrawals_loop(
         state_beaconState, epoch_epoch, withdrawalIndex_next, validatorIndex_next, uint64_bound, $(uint64_i + 1), withdrawal_sel*
       )

;; case B: partially withdrawable
def $expected_withdrawals_loop(state_beaconState, epoch_epoch, withdrawalIndex_wi, validatorIndex_vi, uint64_bound, uint64_i, withdrawal_acc*)
  = withdrawal_out*
  -- if $(validatorIndex_vi < |state_beaconState.VALIDATORS|)
  -- if validator_v = state_beaconState.VALIDATORS[validatorIndex_vi]
  -- if gwei_balance = state_beaconState.BALANCES[validatorIndex_vi]
  -- if $is_fully_withdrawable_validator(validator_v, gwei_balance, epoch_epoch) = false
  -- if $is_partially_withdrawable_validator(validator_v, gwei_balance) = true
  -- if executionAddress_addr = $extract_execution_address(validator_v.WITHDRAWAL_CREDENTIALS)
  -- if $( gwei_balance - $MAX_EFFECTIVE_BALANCE ) = gwei_excess
  -- if withdrawal_w =
       { INDEX           withdrawalIndex_wi,
         VALIDATOR_INDEX validatorIndex_vi,
         ADDRESS         executionAddress_addr,
         AMOUNT          gwei_excess }
  -- if withdrawal_sel* = ( withdrawal_acc* ++ [ withdrawal_w ] )
  -- if withdrawalIndex_next = $( withdrawalIndex_wi + 1 )
  -- if $( |state_beaconState.VALIDATORS| ) = uint64_N
  -- if $( (validatorIndex_vi + 1) \ uint64_N ) = validatorIndex_next
  -- if withdrawal_out* =
       $expected_withdrawals_loop(
         state_beaconState, epoch_epoch, withdrawalIndex_next, validatorIndex_next, uint64_bound, $(uint64_i + 1), withdrawal_sel*
       )

;; case C: 미해당 → append 없음 / wi 변화 없음
def $expected_withdrawals_loop(state_beaconState, epoch_epoch, withdrawalIndex_wi, validatorIndex_vi, uint64_bound, uint64_i, withdrawal_acc*)
  = withdrawal_out*
  -- if $(validatorIndex_vi < |state_beaconState.VALIDATORS|)
  -- if validator_v = state_beaconState.VALIDATORS[validatorIndex_vi]
  -- if gwei_balance = state_beaconState.BALANCES[validatorIndex_vi]
  -- if $is_fully_withdrawable_validator(validator_v, gwei_balance, epoch_epoch) = false
  -- if $is_partially_withdrawable_validator(validator_v, gwei_balance) = false
  -- if withdrawal_sel* = withdrawal_acc*
  -- if withdrawalIndex_next = withdrawalIndex_wi
  -- if $( |state_beaconState.VALIDATORS| ) = uint64_N
  -- if $( (validatorIndex_vi + 1) \ uint64_N ) = validatorIndex_next
  -- if withdrawal_out* =
       $expected_withdrawals_loop(
         state_beaconState, epoch_epoch, withdrawalIndex_next, validatorIndex_next, uint64_bound, $(uint64_i + 1), withdrawal_sel*
       )

;; --------------------------------------------
;; get_expected_withdrawals(state) : withdrawal*
;; --------------------------------------------
dec $get_expected_withdrawals(beaconState) : withdrawal*

def $get_expected_withdrawals(state_beaconState) = withdrawal_out*
  -- if epoch_cur = $get_current_epoch(state_beaconState)
  -- if withdrawalIndex_start = state_beaconState.NEXT_WITHDRAWAL_INDEX
  -- if validatorIndex_start  = state_beaconState.NEXT_WITHDRAWAL_VALIDATOR_INDEX
  -- if $( |state_beaconState.VALIDATORS| ) = uint64_N
  -- if uint64_bound = $min_uint64(uint64_N, $MAX_VALIDATORS_PER_WITHDRAWALS_SWEEP)
  -- if withdrawal_empty* = eps
  -- if withdrawal_out* =
       $expected_withdrawals_loop(
         state_beaconState, epoch_cur, withdrawalIndex_start, validatorIndex_start, uint64_bound, 0, withdrawal_empty*
       )

dec $apply_withdrawal_one(beaconState, withdrawal) : beaconState
def $apply_withdrawal_one(state_in, withdrawal_w) = state_out
  -- if state_out = $decrease_balance(
         state_in,
         withdrawal_w.VALIDATOR_INDEX,
         withdrawal_w.AMOUNT
       )


;; (acc_flags, acc_num) × (flag_index, (state, vi)) → (acc_flags', acc_num')
dec $apply_flag_once((participationFlags, gwei), (nat, (beaconState, validatorIndex))) : (participationFlags, gwei)

def $apply_flag_once((participationFlags_flags, gwei_num), (nat_flag_index, (state_beaconState, validatorIndex_vi)))
  = (participationFlags_new, gwei_num_new)
  -- if $has_flag(participationFlags_flags, nat_flag_index) = false
  -- if $PARTICIPATION_FLAG_WEIGHTS[nat_flag_index] = uint64_w
  -- if $get_base_reward(state_beaconState, validatorIndex_vi) = gwei_base
  -- if $( gwei_base * uint64_w ) = gwei_add
  -- if participationFlags_new = $add_flag(participationFlags_flags, nat_flag_index)
  -- if $( gwei_num + gwei_add ) = gwei_num_new

def $apply_flag_once((participationFlags_flags, gwei_num), (nat_flag_index, (state_beaconState, validatorIndex_vi)))
  = (participationFlags_flags, gwei_num)
  -- otherwise


dec $attach_flags_to_vi(validatorIndex, nat*) : (validatorIndex, nat*)
def $attach_flags_to_vi(validatorIndex_vi, nat_flags*) = (validatorIndex_vi, nat_flags*)


dec $attach_capture_flag(nat, (beaconState, validatorIndex)) : (nat, (beaconState, validatorIndex))
def $attach_capture_flag(nat_flag, (state_c, validatorIndex_vi_c)) = (nat_flag, (state_c, validatorIndex_vi_c))


;; 현재 epoch용: (state, acc_num) × (vi, flags*) → (state', acc_num')
dec $process_one_vi_current((beaconState, gwei), (validatorIndex, nat*)) : (beaconState, gwei)

def $process_one_vi_current((state_in, gwei_num), (validatorIndex_vi, nat_flags*))
  = (state_out, gwei_num_out)
  -- if $(validatorIndex_vi < |state_in.CURRENT_EPOCH_PARTICIPATION|) 
  -- if state_in.CURRENT_EPOCH_PARTICIPATION[validatorIndex_vi] = participationFlags_old
  ;; change map_list_2_
  -- if ($attach_capture_flag(nat_flags, (state_in, validatorIndex_vi)) = (nat_flag_i, (state_in_c, validatorIndex_vi_c)))*
  -- if $fold_<(participationFlags, gwei), (nat, (beaconState, validatorIndex))>(
         def $apply_flag_once,
         (participationFlags_old, 0),
         (nat_flag_i, (state_in_c, validatorIndex_vi_c))*
       ) = (participationFlags_new, gwei_add)
  -- if participationFlags_list_updated* = state_in.CURRENT_EPOCH_PARTICIPATION[[validatorIndex_vi] = participationFlags_new]
  -- if state_mid = state_in[.CURRENT_EPOCH_PARTICIPATION = participationFlags_list_updated*]
  -- if $( gwei_num + gwei_add ) = gwei_num_out
  -- if state_out = state_mid

;; 이전 epoch용
dec $process_one_vi_previous((beaconState, gwei), (validatorIndex, nat*)) : (beaconState, gwei)

def $process_one_vi_previous((state_in, gwei_num), (validatorIndex_vi, nat_flags*))
  = (state_out, gwei_num_out)
  -- if $(validatorIndex_vi < |state_in.PREVIOUS_EPOCH_PARTICIPATION|) 
  -- if state_in.PREVIOUS_EPOCH_PARTICIPATION[validatorIndex_vi] = participationFlags_old
  ;; change map_list_2_
  -- if ($attach_capture_flag(nat_flags, (state_in, validatorIndex_vi)) = (nat_flag_i, (state_in_c, validatorIndex_vi_c)))*
  -- if $fold_<(participationFlags, gwei), (nat, (beaconState, validatorIndex))>(
         def $apply_flag_once,
         (participationFlags_old, 0),
         (nat_flag_i, (state_in_c, validatorIndex_vi_c))*
       ) = (participationFlags_new, gwei_add)
  -- if participationFlags_list_updated* = state_in.PREVIOUS_EPOCH_PARTICIPATION[[validatorIndex_vi] = participationFlags_new]
  -- if state_mid = state_in[.PREVIOUS_EPOCH_PARTICIPATION = participationFlags_list_updated*]
  -- if $( gwei_num + gwei_add ) = gwei_num_out
  -- if state_out = state_mid

dec $compute_proposer_reward(gwei) : gwei
def $compute_proposer_reward(gwei_num) = gwei_prop
  -- if $( ($WEIGHT_DENOMINATOR - $PROPOSER_WEIGHT) * $WEIGHT_DENOMINATOR ) = uint64_num
  -- if $( uint64_num / $PROPOSER_WEIGHT ) = uint64_den
  -- if gwei_prop = $( gwei_num \ uint64_den )    

dec $reward_proposer(beaconState, gwei) : beaconState
def $reward_proposer(state_in, gwei_prop) = state_out
  -- if validatorIndex_prop = $get_beacon_proposer_index(state_in)
  -- if state_out = $increase_balance(state_in, validatorIndex_prop, gwei_prop)


;; process_sync_aggregate 용
;; enumerate (n, X) 에서 bits[n] == 1
dec $bit_is_one_en_blsPubkey(enumerated_<blsPubkey>, boolean*) : bool
def $bit_is_one_en_blsPubkey((n_i, blsPubkey_pk), boolean_bits*) = true
  -- if $(n_i < |boolean_bits*|)
  -- if boolean_bits*[n_i] = true
def $bit_is_one_en_blsPubkey((n_i, blsPubkey_pk), boolean_bits*) = false
  -- otherwise

;; enumerate (n, X) → X  (두 번째만)
dec $pick_second_en_blsPubkey(enumerated_<blsPubkey>, boolean*) : blsPubkey
def $pick_second_en_blsPubkey((n_i, blsPubkey_pk), boolean_bits*) = blsPubkey_pk

;; map_list_2 에서 state 를 캡처로 써서 pubkey → validatorIndex
dec $index_of_pubkey_captured(blsPubkey, beaconState) : validatorIndex
def $index_of_pubkey_captured(blsPubkey_pk, state) = $index_of_pubkey(state, blsPubkey_pk)

;; fold 에서 한 항목 처리:
;; ((i, vi), (participant_reward, proposer_reward, bits*, proposer_index)) → state 업데이트
dec $apply_sync_one(beaconState, ((nat, validatorIndex), (gwei, gwei, boolean*, validatorIndex))) : beaconState

def $apply_sync_one(state_in, ((nat_i, validatorIndex_vi), (gwei_part, gwei_prop, boolean_bits*, validatorIndex_prop))) = state_out
  -- if $(nat_i < |boolean_bits*|)
  -- if boolean_bits*[nat_i] = true
  -- if state_r  = $increase_balance(state_in, validatorIndex_vi,  gwei_part)
  -- if state_out = $increase_balance(state_r,  validatorIndex_prop, gwei_prop)

def $apply_sync_one(state_in, ((nat_i, validatorIndex_vi), (gwei_part, gwei_prop, boolean_bits*, validatorIndex_prop))) = state_out
  -- if $decrease_balance(state_in, validatorIndex_vi, gwei_part) = state_out
  -- otherwise

;; fold 입력을 만들기 위해 동일한 capture 를 각 (i, vi) 에 붙여줌
dec $attach_capture_sync((nat, validatorIndex), (gwei, gwei, boolean*, validatorIndex))
  : ((nat, validatorIndex), (gwei, gwei, boolean*, validatorIndex))
def $attach_capture_sync((nat_i, validatorIndex_vi), (gwei_part, gwei_prop, boolean_bits*, validatorIndex_prop))
  = ((nat_i, validatorIndex_vi), (gwei_part, gwei_prop, boolean_bits*, validatorIndex_prop))
