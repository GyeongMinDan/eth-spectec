  -- if vid <- vid_eligible*
  -- if vid <- vid_unslashed*
  -- if ~$is_in_inactivity_leak(state)
  -- if $get_base_reward(state, vid) = reward_base
  -- if $( reward_base * uint64_weight * uint64_up_incs ) = reward_numerator
  -- if $(reward_numerator / ( uint64_active_incs * $WEIGHT_DENOMINATOR ) ) = reward

def $flag_reward_one_eligible(_, _, _, _, _, _, _)
