;; =========================
;; helpers for rewards, penlaties and balances
;; =========================

;; [Phase0] get_total_balance(BeaconState, Set[ValidatorIndex]) -> Gwei
dec $get_total_balance(beaconState, validatorIndex*) : gwei

def $get_total_balance(state, vid*)
  = $max_uint64(
      $EFFECTIVE_BALANCE_INCREMENT,
      $sum_<gwei>(balance*)
    )
  -- if (state.VALIDATORS[vid].EFFECTIVE_BALANCE = balance)*

dec $get_total_active_balance(beaconState) : gwei

def $get_total_active_balance(state) = gwei_total
  -- if $get_current_epoch(state) = epoch_cur
  -- if $get_active_validator_indices(state, epoch_cur) = vid_active*
  -- if $to_set_<validatorIndex>(vid_active*) = vid_set*
  -- if $get_total_balance(state, vid_set*) = gwei_total

;; [Altair] get_base_reward_per_increment(BeaconState) -> Gwei
dec $get_base_reward_per_increment(beaconState) : gwei

def $get_base_reward_per_increment(state)
  = $(
       $EFFECTIVE_BALANCE_INCREMENT * $BASE_REWARD_FACTOR
       / $integer_square_root($get_total_active_balance(state))
     )

;; [Phase0 -> Altair] get_base_reward(BeaconState, ValidatorIndex) -> Gwei
dec $get_base_reward(beaconState, validatorIndex) : gwei

def $get_base_reward(state, vid) = reward
  ;; inserted bound check guard
  -- if $(vid < |state.VALIDATORS|)
  -- if $( state.VALIDATORS[vid].EFFECTIVE_BALANCE / $EFFECTIVE_BALANCE_INCREMENT ) = uint64_increments
  -- if $( uint64_increments * $get_base_reward_per_increment(state) ) = reward

;; [Custom | loop : ProcessInactivityUpdates]
relation ApplyEffectiveBalance:
  validator `.EFFECTIVE_BALANCE gwei ~> validator
  hint(input %0 %1)

rule ApplyEffectiveBalance/main:
  validator `.EFFECTIVE_BALANCE balance ~> 
    validator
      [.EFFECTIVE_BALANCE =
        $min_uint64(
          $( balance - balance \ $EFFECTIVE_BALANCE_INCREMENT ), 
          $MAX_EFFECTIVE_BALANCE
        )
      ]
  -- if $( $EFFECTIVE_BALANCE_INCREMENT / $HYSTERESIS_QUOTIENT ) = uint64_hyst_inc
  -- if $( uint64_hyst_inc * $HYSTERESIS_DOWNWARD_MULTIPLIER ) = uint64_down_th
  -- if $( uint64_hyst_inc * $HYSTERESIS_UPWARD_MULTIPLIER )  = uint64_up_th
  ;; inserted overflow checks
  -- if $( balance <= $UINT64_MAX - uint64_down_th )
  -- if $( validator.EFFECTIVE_BALANCE  <= $UINT64_MAX - uint64_up_th )
  -- if $( balance + uint64_down_th < validator.EFFECTIVE_BALANCE )
     \/ $( validator.EFFECTIVE_BALANCE + uint64_up_th < balance )

rule ApplyEffectiveBalance/skip:
  validator `.EFFECTIVE_BALANCE _ ~> validator
  -- otherwise

;; [Custom | loop : get_inactivity_penalty_deltas]
dec $inact_penalty_one(nat, beaconState, validatorIndex*, validatorIndex*) : gwei

def $inact_penalty_one(vid, state, vid_matching*, vid_eligible*)
  = penalty
  -- if vid <- vid_eligible*
  -- if ~( vid <- vid_matching* )
  -- if $(vid < |state.VALIDATORS|)
  -- if state.VALIDATORS[vid].EFFECTIVE_BALANCE = balance_effective
  ;; inserted bound check guard
  -- if $(vid < |state.INACTIVITY_SCORES|)
  -- if state.INACTIVITY_SCORES[vid] = uint64_score
  -- if $(balance_effective * uint64_score) = penalty_numerator
  ;; inserted overflow check
  -- if $(penalty_numerator <= $UINT64_MAX)
  -- if $($INACTIVITY_SCORE_BIAS * $INACTIVITY_PENALTY_QUOTIENT_BELLATRIX) = penalty_denominator
  -- if $( penalty_numerator / penalty_denominator) = penalty

def $inact_penalty_one(_, _, _, _)
  = 0
  -- otherwise

;; [Phase0 -> Altair -> Bellatrix] get_inactivity_penalty_deltas(BeaconState) -> Tuple[Sequence[gwei], Sequence[gwei]]
dec $get_inactivity_penalty_deltas(beaconState) : (gwei*, gwei*)

def $get_inactivity_penalty_deltas(state) 
  = (reward*, penalty*)
  -- if $repeat_<gwei>(0, |state.VALIDATORS|) = reward*                 ;; rewards = [0]*N
  -- if $get_eligible_validator_indices(state) = vid_eligible*
  -- if $get_previous_epoch(state) = epoch_prev
  -- if $get_unslashed_participating_indices(state, $TIMELY_TARGET_FLAG_INDEX, epoch_prev)
      = vid_matching*
  ;; instead of iterating over the eligible indices, iterate over all indices and set 0 for non-eligible ones.
  -- if $range(|state.VALIDATORS|) = vid*
  -- if ($inact_penalty_one(vid, state, vid_matching*, vid_eligible*) = penalty)*

