;;
;; --------------------------------------------
dec $get_base_reward_per_increment(beaconState) : gwei

def $get_base_reward_per_increment(state) = gwei_base
  -- if $get_total_active_balance(state) = gwei_total_active
  -- if $integer_square_root(gwei_total_active) = uint64_sqrt_total
  -- if $( $EFFECTIVE_BALANCE_INCREMENT * $BASE_REWARD_FACTOR ) = uint64_num
  -- if $( uint64_num / uint64_sqrt_total ) = gwei_base

;; --------------------------------------------
;; get_base_reward(state, index) : gwei
;; --------------------------------------------
dec $get_base_reward(beaconState, validatorIndex) : gwei

def $get_base_reward(state, vid) = gwei_reward
  -- if $(vid < |state.VALIDATORS|)
  -- if state.VALIDATORS[vid] = validator_i
  -- if $( validator_i.EFFECTIVE_BALANCE / $EFFECTIVE_BALANCE_INCREMENT ) = uint64_increments
  -- if $get_base_reward_per_increment(state) = gwei_per_inc
  -- if $( uint64_increments * gwei_per_inc ) = gwei_reward

;; ------------------------------------------------------------
;; rebalance rule for a single (index, validator) pair
;; (computes hysteresis thresholds and updates EFFECTIVE_BALANCE if needed)
;; ------------------------------------------------------------
relation ApplyEffectiveBalance:
  validator `.EFFECTIVE_BALANCE gwei ~> validator
  hint(input %0 %1)

rule ApplyEffectiveBalance/main:
  validator `.EFFECTIVE_BALANCE balance ~> 
    validator
      [.EFFECTIVE_BALANCE =
        $min_uint64(
          $( balance - balance \ $EFFECTIVE_BALANCE_INCREMENT ), 
          $MAX_EFFECTIVE_BALANCE
        )
      ]
  -- if $( $EFFECTIVE_BALANCE_INCREMENT / $HYSTERESIS_QUOTIENT ) = uint64_hyst_inc
  -- if $( uint64_hyst_inc * $HYSTERESIS_DOWNWARD_MULTIPLIER ) = uint64_down_th
  -- if $( uint64_hyst_inc * $HYSTERESIS_UPWARD_MULTIPLIER )  = uint64_up_th
  ;; inserted overflow checks
  -- if $( balance + uint64_down_th <= $UINT64_MAX )
  -- if $( validator.EFFECTIVE_BALANCE + uint64_up_th <= $UINT64_MAX )
  -- if $( balance + uint64_down_th < validator.EFFECTIVE_BALANCE )
     \/ $( validator.EFFECTIVE_BALANCE + uint64_up_th < balance )

rule ApplyEffectiveBalance/skip:
  validator `.EFFECTIVE_BALANCE _ ~> validator
  -- otherwise

;; --------------------------------------------
;; per-index inactivity penalty
;; capture: (state, matching_set*, eligible_set*, denom)
;; rewards 는 건드는 코드 없으므로 penalty 에 대해 0으로 갈지 아니면 조건을 만족하여 값을 바꿀지만 결정되면 됨.
;; --------------------------------------------
dec $inact_penalty_one(nat, (beaconState, validatorIndex*, validatorIndex*, uint64)) : gwei

def $inact_penalty_one(nat_i, (state, vid_matching*, vid_eligible*, uint64_den))
  = gwei_penalty
  -- if vid = nat_i
  -- if ( vid <- vid_eligible* )
  -- if ~( vid <- vid_matching* )
  -- if $(vid < |state.VALIDATORS|)
  -- if state.VALIDATORS[vid] = validator_v
  -- if gwei_eff = validator_v.EFFECTIVE_BALANCE
  -- if $(vid < |state.INACTIVITY_SCORES|)
  -- if state.INACTIVITY_SCORES[vid] = uint64_score
  -- if $( gwei_eff * uint64_score ) = uint64_num
  ;; inserted overflow check
  -- if $( uint64_num <= $UINT64_MAX )
  -- if $( uint64_num / uint64_den ) = gwei_penalty

def $inact_penalty_one(nat_i, (state, vid_matching*, vid_eligible*, uint64_den))
  = 0
  -- otherwise

