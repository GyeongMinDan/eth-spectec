;; ============================================
dec $target_flag_list(beaconState, attestationData, checkpoint, uint64) : nat*

def $target_flag_list(state, attestationData, checkpoint_jc, uint64_inclusion_delay) = nat_flags_target*
  ;; is_matching_source: 구조체 직접 비교가 실패하는 경우를 대비해 필드별로 비교
  -- if $(attestationData.SOURCE.EPOCH = checkpoint_jc.EPOCH)
  -- if $(attestationData.SOURCE.ROOT = checkpoint_jc.ROOT)
