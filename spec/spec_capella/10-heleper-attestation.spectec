  -- if $(attestationData.TARGET.ROOT = root_target_epoch)  ;; target_root_matches
  -- if $(uint64_inclusion_delay <= $SLOTS_PER_EPOCH)
  -- if nat_flags_target* = [ $TIMELY_TARGET_FLAG_INDEX ]

def $target_flag_list(state, attestationData, checkpoint_jc, uint64_inclusion_delay) = eps
  -- otherwise

;; ============================================
;; HEAD 플래그 판단 (조건 만족 시 [TIMELY_HEAD_FLAG_INDEX], 아니면 eps)
