;; [Phase0 | loop : get_next_sync_committee_indices]
dec $next_sync_committee_indices_loop(
  beaconState, validatorIndex*, bytes32, uint64, uint64, validatorIndex*
) : validatorIndex*

;; while loop termination: |sync_committee_indices| >= SYNC_COMMITTEE_SIZE
def $next_sync_committee_indices_loop(_, _, _, _, _, vid_sync_committee*)
  = vid_sync_committee*
  -- if $(|vid_sync_committee*| >= $SYNC_COMMITTEE_SIZE)

;; append if condition satisfied
def $next_sync_committee_indices_loop(
  state, vid_active*, seed, count_active, vid, vid_sync_committee*
) = $next_sync_committee_indices_loop(
      state,
      vid_active*,
      seed,
      count_active,
      $(vid + 1),
      vid_sync_committee* ++ [vid_candidate] ;;append if condition holds
    )
  ;; branch-complete: loop condition
  -- if $( |vid_sync_committee*| < $SYNC_COMMITTEE_SIZE )
  -- if vid_active*[$compute_shuffled_index($(vid \ count_active), count_active, seed)] = vid_candidate
  -- if $hash_<bytes>($concat_bytes($bytes32_to_bytes(seed), $uint_to_bytes($(vid / 32)))) = bytes32_h
  -- if $bytes1_to_uint64($bytes32_to_bytes1_list(bytes32_h)[vid \ 32]) = uint64_random_byte
  -- if state.VALIDATORS[vid_candidate].EFFECTIVE_BALANCE = balance_effective
  ;; inserted overflow check
  -- if $( balance_effective <= $MAX_RANDOM_BYTE / $UINT64_MAX )
  -- if $( balance_effective * $MAX_RANDOM_BYTE >= $MAX_EFFECTIVE_BALANCE * uint64_random_byte )
  ;; procceed to next iteration

;; continue if condition not satisfied
def $next_sync_committee_indices_loop(
  state, vid_active*, seed, count_active, vid, vid_sync_committee*
) = $next_sync_committee_indices_loop(
      state,
      vid_active*,
      seed,
      count_active,
      $(vid + 1),
      vid_sync_committee*
    )
  ;; branch-complete: loop condition
  -- if $( |vid_sync_committee*| < $SYNC_COMMITTEE_SIZE )
  -- if vid_active*[$compute_shuffled_index($(vid \ count_active), count_active, seed)] = vid_candidate
  -- if $hash_<bytes>($concat_bytes($bytes32_to_bytes(seed), $uint_to_bytes($(vid / 32)))) = bytes32_h
  -- if $bytes1_to_uint64($bytes32_to_bytes1_list(bytes32_h)[vid \ 32]) = uint64_random_byte
  -- if state.VALIDATORS[vid_candidate].EFFECTIVE_BALANCE = balance_effective
  ;; inserted overflow check
  -- if $( balance_effective <= $MAX_RANDOM_BYTE / $UINT64_MAX )
  -- if $( balance_effective * $MAX_RANDOM_BYTE < $MAX_EFFECTIVE_BALANCE * uint64_random_byte )
  ;; otherwise, proceed to next iteration without appending


;; [Phase0] get_next_sync_committee_indices(BeaconState) -> Sequence[ValidatorIndex]
dec $get_next_sync_committee_indices(beaconState) : validatorIndex*

def $get_next_sync_committee_indices(state) = vid_out*
  -- if epoch_next = $( $get_current_epoch(state) + 1 )
  -- if $get_active_validator_indices(state, epoch_next) = vid_active*
  -- if |vid_active*| = count_active
  -- if $get_seed(state, epoch_next, $DOMAIN_SYNC_COMMITTEE) = seed
  -- if $next_sync_committee_indices_loop(
         state,
         vid_active*,
         seed,
         count_active,
         0,
         eps ;; empty list
       ) = vid_out*

;; [Phase0] get_next_sync_committee(BeaconState) -> SyncCommittee
dec $get_next_sync_committee(beaconState) : syncCommittee

def $get_next_sync_committee(state)
  = { PUBKEYS          blsPubkey*,
      AGGREGATE_PUBKEY blsPubkey_aggregate }
  -- if $get_next_sync_committee_indices(state) = vid*
  -- if (state.VALIDATORS[vid].PUBKEY = blsPubkey)*
  -- if $eth_aggregate_pubkeys(blsPubkey*) = blsPubkey_aggregate


;; [Phase0] get_indexed_attestation(BeaconState, Attestation) -> IndexedAttestation
dec $get_indexed_attestation(beaconState, attestation) : indexedAttestation

def $get_indexed_attestation(state, attestation)
  = { ATTESTING_INDICES $sort_<validatorIndex>(vid_attesting*),
      DATA               attestation.DATA,
      SIGNATURE          attestation.SIGNATURE }
  -- if $get_attesting_indices(state, attestation) = vid_attesting*
