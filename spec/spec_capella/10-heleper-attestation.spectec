;; get_attesting_indices(state, attestation) : validatorIndex*
;; --------------------------------------------
dec $get_attesting_indices(beaconState, attestation) : validatorIndex*

def $get_attesting_indices(state, attestation) = vid_set*
  -- if $get_beacon_committee(
         state,
         attestation.DATA.SLOT,
         attestation.DATA.INDEX
       ) = vid_committee*
  -- if $enumerate_<validatorIndex>(vid_committee*)
       = (n_i, vid)*
  -- if $filter_list_2_<(nat, validatorIndex), boolean*>(
         (n_i, vid)*,
         attestation.AGGREGATION_BITS,
         def $bit_is_one_at_index
       ) = (n_sel, vid_sel)*
  ;; chagne map_list_2_
  -- if ($collect_vi((n_sel, vid_sel), attestation.AGGREGATION_BITS) = vid_list)*
  -- if $to_set_<validatorIndex>(vid_list*) = vid_set*

;; ------------------------------------------------------------
;; is_slashable_attestation_data
;; ------------------------------------------------------------
dec $is_slashable_attestation_data(attestationData, attestationData) : bool
def $is_slashable_attestation_data(attestationData_1, attestationData_2) =
  ( ( attestationData_1 =/= attestationData_2 )
    /\ $( attestationData_1.TARGET.EPOCH = attestationData_2.TARGET.EPOCH ) )
  \/
  ( $( attestationData_1.SOURCE.EPOCH < attestationData_2.SOURCE.EPOCH )
    /\ $( attestationData_2.TARGET.EPOCH < attestationData_1.TARGET.EPOCH ) )

;;
;; is_valid_indexed_attestation
;;
dec $is_valid_indexed_attestation(beaconState, indexedAttestation) : boolean
;; 1. empty list
def $is_valid_indexed_attestation(state, indexedAttestation) = false
  -- if vid* = indexedAttestation.ATTESTING_INDICES
  -- if |vid*| = 0

;; 2. not sorted
def $is_valid_indexed_attestation(state, indexedAttestation) = false
  -- if vid* = indexedAttestation.ATTESTING_INDICES
  -- if $to_set_<validatorIndex>(vid*) = vid_set*
  -- if $sort_<validatorIndex>(vid_set*) = vid_sorted*
  -- if vid_sorted* =/= vid*

;; 3. if is true
def $is_valid_indexed_attestation(state, indexedAttestation) = true
  -- if vid* = indexedAttestation.ATTESTING_INDICES
  -- if $to_set_<validatorIndex>(vid*) = vid_set*
  -- if $sort_<validatorIndex>(vid_set*) = vid_sorted*
  -- if $( |vid_sorted*| > 0 )
  -- if vid_sorted* = vid*
  -- if (state.VALIDATORS[vid].PUBKEY = blsPubkey_pk)*
  -- if $get_domain(state, $DOMAIN_BEACON_ATTESTER, indexedAttestation.DATA.TARGET.EPOCH) = domain_att
  -- if $compute_signing_root_attestationData(indexedAttestation.DATA, domain_att) = root_sign
  -- if $bls_fast_aggregate_verify(blsPubkey_pk*, root_sign, indexedAttestation.SIGNATURE) = true

;; [Custom]
;;  modifies: .VALIDATORS[](.EXIT_EPOCH, .WITHDRAWABLE_EPOCH, .SLASHED) .SLASHINGS, .BALANCES

relation SlashIfEligible:
  beaconState SLASH`? `[ validatorIndex ] ~> beaconState `#SLASHED bool
  hint(input %0 %1)

rule SlashIfEligible/true:
  state SLASH`? `[ vid ] ~> state_slashed `#SLASHED true
  -- if $(vid < |state.VALIDATORS|)
  -- if $is_slashable_validator(state.VALIDATORS[vid], $get_current_epoch(state))
  -- SlashValidator: state SLASH `[ vid ] BY eps ~> state_slashed

rule SlashIfEligible/false:
  state SLASH`? `[ vid ] ~> state `#SLASHED false
  -- if $(vid < |state.VALIDATORS|)
  -- if ~$is_slashable_validator(state.VALIDATORS[vid], $get_current_epoch(state))

;; folder for SlashIfEligible
relation SlashIfEligible_over_validators:
  beaconState SLASH`? `[ validatorIndex* ] ~> beaconState `#SLASHED bool
  hint(input %0 %1)

rule SlashIfEligible_over_validators/nil:
  state SLASH`? `[ eps ] ~> state `#SLASHED false

rule SlashIfEligible_over_validators/cons:
  state SLASH`? `[ vid_h :: vid_t* ] ~> state_t `#SLASHED (bool_h \/ bool_t)
  -- SlashIfEligible: state SLASH`? `[ vid_h ] ~> state_h `#SLASHED bool_h
  -- SlashIfEligible_over_validators: state_h SLASH`? `[ vid_t* ] ~> state_t `#SLASHED bool_t

;; [Custom | branch : get_attestation_participation_flag_indices]
dec $source_flag_list(uint64) : nat*

def $source_flag_list(uint64_inclusion_delay)
  = [ $TIMELY_SOURCE_FLAG_INDEX ]
  -- if $(uint64_inclusion_delay <= $integer_square_root($SLOTS_PER_EPOCH))
def $source_flag_list(_) = eps
  -- otherwise

dec $target_flag_list(bool, uint64) : nat*

def $target_flag_list(bool_matching_target, uint64_inclusion_delay) 
  = [ $TIMELY_TARGET_FLAG_INDEX ]
  -- if $(uint64_inclusion_delay <= $SLOTS_PER_EPOCH)
def $target_flag_list(_, _) = eps
  -- otherwise
dec $head_flag_list(bool, uint64) : nat*

def $head_flag_list(bool_matching_head, uint64_inclusion_delay)
  = [ $TIMELY_HEAD_FLAG_INDEX ]
  -- if $(uint64_inclusion_delay = $MIN_ATTESTATION_INCLUSION_DELAY)
def $head_flag_list(_, _) = eps
  -- otherwise

