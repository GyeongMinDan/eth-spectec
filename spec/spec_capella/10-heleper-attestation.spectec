dec $bit_is_one_at_index((nat, validatorIndex), boolean*) : bool

def $bit_is_one_at_index((n_i, vid), boolean_bits*)
  = true
  -- if $(n_i < |boolean_bits*|)
  -- if boolean_bits*[n_i] = true

def $bit_is_one_at_index((n_i, vid), boolean_bits*)
  = false
  -- otherwise

;; --------------------------------------------
;; validatorIndex 만 뽑기
;; --------------------------------------------
dec $collect_vi((nat, validatorIndex), boolean*) : validatorIndex
def $collect_vi((n_i, vid), boolean_bits*) = vid

;; --------------------------------------------
;; get_attesting_indices(state, attestation) : validatorIndex*
;; --------------------------------------------
dec $get_attesting_indices(beaconState, attestation) : validatorIndex*

def $get_attesting_indices(state, attestation) = vid_set*
  -- if $get_beacon_committee(
         state,
         attestation.DATA.SLOT,
         attestation.DATA.INDEX
       ) = vid_committee*
  -- if $enumerate_<validatorIndex>(vid_committee*)
       = (n_i, vid)*
  -- if $filter_list_2_<(nat, validatorIndex), boolean*>(
         (n_i, vid)*,
         attestation.AGGREGATION_BITS,
         def $bit_is_one_at_index
       ) = (n_sel, vid_sel)*
  ;; chagne map_list_2_
  -- if ($collect_vi((n_sel, vid_sel), attestation.AGGREGATION_BITS) = vid_list)*
  -- if $to_set_<validatorIndex>(vid_list*) = vid_set*

;; ------------------------------------------------------------
;; is_slashable_attestation_data
;; ------------------------------------------------------------
dec $is_slashable_attestation_data(attestationData, attestationData) : bool
def $is_slashable_attestation_data(attestationData_1, attestationData_2) =
  ( ( attestationData_1 =/= attestationData_2 )
    /\ $( attestationData_1.TARGET.EPOCH = attestationData_2.TARGET.EPOCH ) )
  \/
  ( $( attestationData_1.SOURCE.EPOCH < attestationData_2.SOURCE.EPOCH )
    /\ $( attestationData_2.TARGET.EPOCH < attestationData_1.TARGET.EPOCH ) )

;;
;; is_valid_indexed_attestation
;;
dec $is_valid_indexed_attestation(beaconState, indexedAttestation) : boolean
;; 1. empty list
def $is_valid_indexed_attestation(state, indexedAttestation) = false
  -- if vid* = indexedAttestation.ATTESTING_INDICES
  -- if |vid*| = 0

;; 2. not sorted
def $is_valid_indexed_attestation(state, indexedAttestation) = false
  -- if vid* = indexedAttestation.ATTESTING_INDICES
  -- if $to_set_<validatorIndex>(vid*) = vid_set*
  -- if $sort_<validatorIndex>(vid_set*) = vid_sorted*
  -- if vid_sorted* =/= vid*

;; 3. if is true
def $is_valid_indexed_attestation(state, indexedAttestation) = true
  -- if vid* = indexedAttestation.ATTESTING_INDICES
  -- if $to_set_<validatorIndex>(vid*) = vid_set*
  -- if $sort_<validatorIndex>(vid_set*) = vid_sorted*
  -- if $( |vid_sorted*| > 0 )
  -- if vid_sorted* = vid*
  -- if (state.VALIDATORS[vid].PUBKEY = blsPubkey_pk)*
  -- if $get_domain(state, $DOMAIN_BEACON_ATTESTER, indexedAttestation.DATA.TARGET.EPOCH) = domain_att
  -- if $compute_signing_root_attestationData(indexedAttestation.DATA, domain_att) = root_sign
  -- if $bls_fast_aggregate_verify(blsPubkey_pk*, root_sign, indexedAttestation.SIGNATURE) = true


;; is_slashable?
dec $is_slashable_now(validatorIndex, beaconState) : boolean

def $is_slashable_now(vid, state) = true
  -- if $(vid < |state.VALIDATORS|)
  -- if state.VALIDATORS[vid] = validator
  -- if $get_current_epoch(state) = epoch_cur
  -- if $is_slashable_validator(validator, epoch_cur) = true

def $is_slashable_now(vid, state) = false
  -- otherwise

;; if is_slashable -> slash
dec $slash_if_eligible(beaconState, validatorIndex) : beaconState

def $slash_if_eligible(state, vid) = state_slashed
  -- if $is_slashable_now(vid, state) = true
  -- SlashValidator: state `.VALIDATORS `[ vid `; eps ] ~> state_slashed

def $slash_if_eligible(state, vid) = state
  -- otherwise

;; 리스트 전체에 적용: fold_
dec $apply_slashes(beaconState, validatorIndex*) : beaconState
def $apply_slashes(state, vid_sorted*) = state_after
  -- if $fold_<beaconState, validatorIndex>(
         def $slash_if_eligible,
         state,
         vid_sorted*
       ) = state_after

;; ============================================
;; SOURCE 플래그 판단 (조건 만족 시 [TIMELY_SOURCE_FLAG_INDEX], 아니면 eps)
;; ============================================
dec $source_flag_list(beaconState, attestationData, checkpoint, uint64) : nat*

def $source_flag_list(state, attestationData, checkpoint_jc, uint64_inclusion_delay) = nat_flags_source*
  -- if $integer_square_root($SLOTS_PER_EPOCH) = uint64_sqrt_slots_per_epoch
  ;; 구조체 직접 비교가 실패하는 경우를 대비해 필드별로 비교
  -- if $(attestationData.SOURCE.EPOCH = checkpoint_jc.EPOCH)
  -- if $(attestationData.SOURCE.ROOT = checkpoint_jc.ROOT)
  -- if $(uint64_inclusion_delay <= uint64_sqrt_slots_per_epoch)
  -- if nat_flags_source* = [ $TIMELY_SOURCE_FLAG_INDEX ]

def $source_flag_list(state, attestationData, checkpoint_jc, uint64_inclusion_delay) = eps
  -- otherwise


;; ============================================
;; TARGET 플래그 판단 (조건 만족 시 [TIMELY_TARGET_FLAG_INDEX], 아니면 eps)
