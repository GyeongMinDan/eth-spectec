;; 구간 보정: nat x + uint64 start → uint64
dec $add_offset_nat_uint64(nat, uint64) : uint64
def $add_offset_nat_uint64(nat_x, uint64_start) = $(uint64_start + nat_x)

;; 하나의 i에 대해 셔플 인덱스를 통해 validatorIndex 뽑기
;; capture: (indices*, seed, len)
dec $pick_shuffled_vi(uint64, (validatorIndex*, bytes32, uint64)) : validatorIndex
def $pick_shuffled_vi(uint64_i, (vid*, bytes32_seed, uint64_len)) = vid_picked
  -- if $compute_shuffled_index(uint64_i, uint64_len, bytes32_seed) = uint64_shuf
  -- if vid*[uint64_shuf] = vid_picked


;; --------------------------------------------
;; compute_committee(validatorIndex*, bytes32, uint64, uint64) : validatorIndex*
;; --------------------------------------------

dec $compute_committee(validatorIndex*, bytes32, uint64, uint64) : validatorIndex*

def $compute_committee(vid*, bytes32_seed, uint64_index, uint64_count) = vid_committee*
  -- if |vid*| = uint64_len
  -- if $( (uint64_len * uint64_index) / uint64_count ) = uint64_start
  -- if $(uint64_index + 1) = uint64_plus_index
  -- if $( (uint64_len * uint64_plus_index) / uint64_count ) = uint64_end
  -- if $( uint64_end - uint64_start ) = uint64_span
  ;; [0..span-1] 만들고 → 각 원소에 start를 더해 [start..end-1] i-리스트 만들기
  -- if $range(uint64_span) = nat_r*
  ;; change map_list_2_
  -- if ($add_offset_nat_uint64(nat_r, uint64_start) = uint64_i_list)*
  ;; 각 i에 대해 indices[shuffle(i, len, seed)] 선택
  ;; change map_list_2_
  -- if ($pick_shuffled_vi(uint64_i_list, (vid*, bytes32_seed, uint64_len)) = vid_committee)*


;; ------------------------------------------------------------
;; get_committee_count_per_slot
;; ------------------------------------------------------------
dec $get_committee_count_per_slot(beaconState, epoch) : uint64
def $get_committee_count_per_slot(state, epoch_epoch) = uint64_committees_per_slot
  -- if $get_active_validator_indices(state, epoch_epoch) = vid_active*
  -- if $( |vid_active*| ) = uint64_len_active
  -- if $(uint64_len_active / $SLOTS_PER_EPOCH) = uint64_per_slot
  -- if $(uint64_per_slot / $TARGET_COMMITTEE_SIZE) = uint64_estimate
  -- if $min_uint64($MAX_COMMITTEES_PER_SLOT, uint64_estimate) = uint64_capped
  -- if $max_uint64(1, uint64_capped) = uint64_committees_per_slot

;; ------------------------------------------------------------
;; get_beacon_committee
;; ------------------------------------------------------------
dec $get_beacon_committee(beaconState, slot, committeeIndex) : validatorIndex*
def $get_beacon_committee(state, slot, committeeIndex) = vid_committee*
  -- if $compute_epoch_at_slot(slot) = epoch
  -- if $get_committee_count_per_slot(state, epoch) = uint64_committees_per_slot
  -- if $get_active_validator_indices(state, epoch) = vid*
  -- if $get_seed(state, epoch, $DOMAIN_BEACON_ATTESTER) = bytes32_seed
  -- if $( (slot \ $SLOTS_PER_EPOCH) * uint64_committees_per_slot + committeeIndex ) = uint64_index
  -- if $( uint64_committees_per_slot * $SLOTS_PER_EPOCH ) = uint64_count
  -- if $compute_committee(
         vid*,
         bytes32_seed,
         uint64_index,
         uint64_count
       ) = vid_committee*

;; --------------------------------------------
;; is aggregation_bits[i] true?
