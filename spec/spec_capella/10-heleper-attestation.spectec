  -- if $(attestationData.TARGET.ROOT = root_target_epoch)  ;; is_matching_target
  -- if $get_block_root_at_slot(state, attestationData.SLOT) = root_at_slot
  -- if $(attestationData.BEACON_BLOCK_ROOT = root_at_slot)  ;; head_root_matches
  -- if $(uint64_inclusion_delay = $MIN_ATTESTATION_INCLUSION_DELAY)
  -- if nat_flags_head* = [ $TIMELY_HEAD_FLAG_INDEX ]

def $head_flag_list(state, attestationData, checkpoint_jc, uint64_inclusion_delay) = eps
  -- otherwise

;;
;; get_attestation_participation_flag_indices
;;
dec $get_attestation_participation_flag_indices(beaconState, attestationData, uint64) : nat*

;; case 1: data.TARGET.EPOCH == get_current_epoch(state)
def $get_attestation_participation_flag_indices(state, attestationData, uint64_inclusion_delay) = nat_flag_indices*
  -- if $get_current_epoch(state) = epoch_current
  -- if $(attestationData.TARGET.EPOCH = epoch_current)
  -- if checkpoint_jc = state.CURRENT_JUSTIFIED_CHECKPOINT
  ;; assert is_matching_source (Python 코드의 assert is_matching_source)
  ;; 구조체 직접 비교 ->  필드별로 비교
  -- if $(attestationData.SOURCE.EPOCH = checkpoint_jc.EPOCH)
  -- if $(attestationData.SOURCE.ROOT = checkpoint_jc.ROOT)
  ;; 개별 플래그 리스트 계산
  ;; Python 코드: is_matching_target = is_matching_source and target_root_matches
  ;; Python 코드: is_matching_head = is_matching_target and head_root_matches
  -- if $source_flag_list(state, attestationData, checkpoint_jc, uint64_inclusion_delay) = nat_flags_source*
  -- if $target_flag_list(state, attestationData, checkpoint_jc, uint64_inclusion_delay) = nat_flags_target*
  -- if $head_flag_list(state, attestationData, checkpoint_jc, uint64_inclusion_delay) = nat_flags_head*
  ;; 합치기
  -- if nat_flag_indices* = nat_flags_source* ++ nat_flags_target* ++ nat_flags_head*


;; case 2: data.TARGET.EPOCH != get_current_epoch(state)  (⇒ previous 사용)
def $get_attestation_participation_flag_indices(state, attestationData, uint64_inclusion_delay) = nat_flag_indices*
  -- if $get_current_epoch(state) = epoch_current
  -- if ~( $(attestationData.TARGET.EPOCH = epoch_current) )
  -- if checkpoint_jc = state.PREVIOUS_JUSTIFIED_CHECKPOINT
  ;; assert is_matching_source (Python 코드의 assert is_matching_source)
  ;; 구조체 직접 비교 ->  필드별로 비교
  -- if $(attestationData.SOURCE.EPOCH = checkpoint_jc.EPOCH)
  -- if $(attestationData.SOURCE.ROOT = checkpoint_jc.ROOT)
  ;; 개별 플래그 리스트 계산
  ;; Python 코드: is_matching_target = is_matching_source and target_root_matches
  ;; Python 코드: is_matching_head = is_matching_target and head_root_matches
  -- if $source_flag_list(state, attestationData, checkpoint_jc, uint64_inclusion_delay) = nat_flags_source*
  -- if $target_flag_list(state, attestationData, checkpoint_jc, uint64_inclusion_delay) = nat_flags_target*
  -- if $head_flag_list(state, attestationData, checkpoint_jc, uint64_inclusion_delay) = nat_flags_head*
  ;; 합치기
  -- if nat_flag_indices* = nat_flags_source* ++ nat_flags_target* ++ nat_flags_head*

;; next_sync_committee_indices_loop:
;; state, 활성검증자목록, seed, 활성수, i, 누적리스트  ->  누적리스트(길이 = SYNC_COMMITTEE_SIZE)
dec $next_sync_committee_indices_loop(
  beaconState, validatorIndex*, bytes32, uint64, uint64, validatorIndex*
) : validatorIndex*

;; while 종료 조건은 acc 길이 < SYNC_COMMITTEE_SIZE 이므로 같아지면 종료
def $next_sync_committee_indices_loop(
  state, vid_active*, bytes32_seed, uint64_active_cnt, uint64_i, vid_acc*
) = vid_acc*
  -- if $( |vid_acc*| ) = uint64_len_acc
  -- if $( uint64_len_acc >= $SYNC_COMMITTEE_SIZE )

;; 계속: 한 번 시도하고(합격 시 append), i+1로 재귀
;; Case 1: 조건 만족 시 append
def $next_sync_committee_indices_loop(
  state, vid_active*, bytes32_seed, uint64_active_cnt, uint64_i, vid_acc*
) = vid_ret*
  -- if $( |vid_acc*| ) = uint64_len_acc
  -- if $( uint64_len_acc < $SYNC_COMMITTEE_SIZE )
  ;; 1 shuffled_index = compute_shuffled_index(i % active_cnt, active_cnt, seed)
  -- if $(uint64_i \ uint64_active_cnt) = uint64_mod
  -- if $compute_shuffled_index(uint64_mod, uint64_active_cnt, bytes32_seed) = uint64_shuf
  -- if vid_active*[uint64_shuf] = vid_candidate
  ;; 2 random_byte = hash(seed || uint_to_bytes(i//32))[i%32]
  -- if $(uint64_i / 32) = uint64_chunk
  -- if $uint_to_bytes(uint64_chunk) = bytes_chunk
  ;; fix hash(bytes32 + bytes)
  -- if $bytes32_to_bytes(bytes32_seed) = bytes_seed_bytes
  -- if $concat_bytes(bytes_seed_bytes, bytes_chunk) = bytes_msg
  -- if $hash_<bytes>(bytes_msg) = bytes32_h
  -- if $(uint64_i \ 32) = nat_b                      ;; 0..31
  -- if $bytes32_to_bytes1_list(bytes32_h) = bytes1_list_32*
  -- if bytes1_list_32*[nat_b] = bytes1_rb            ;; bytes1
  -- if $bytes1_to_uint64(bytes1_rb) = uint64_random_byte
  ;; 3 effective_balance 읽기
  -- if state.VALIDATORS[vid_candidate] = validator_v
  -- if gwei_effective = validator_v.EFFECTIVE_BALANCE
  ;; 4 합격이면 append
  -- if $( gwei_effective * $MAX_RANDOM_BYTE >= $MAX_EFFECTIVE_BALANCE * uint64_random_byte )
  -- if vid_acc_sel* = ( vid_acc* ++ [ vid_candidate ] )
  ;; 5 재귀(i+1)
  -- if $next_sync_committee_indices_loop(
         state,
         vid_active*,
         bytes32_seed,
         uint64_active_cnt,
         $(uint64_i + 1),
         vid_acc_sel*
       ) = vid_ret*

;; Case 2: 조건 불만족 시 그대로
def $next_sync_committee_indices_loop(
  state, vid_active*, bytes32_seed, uint64_active_cnt, uint64_i, vid_acc*
) = vid_ret*
  -- if $( |vid_acc*| ) = uint64_len_acc
  -- if $( uint64_len_acc < $SYNC_COMMITTEE_SIZE )
  ;; 1 shuffled_index = compute_shuffled_index(i % active_cnt, active_cnt, seed)
  -- if $(uint64_i \ uint64_active_cnt) = uint64_mod
  -- if $compute_shuffled_index(uint64_mod, uint64_active_cnt, bytes32_seed) = uint64_shuf
  -- if vid_active*[uint64_shuf] = vid_candidate
  ;; 2 random_byte = hash(seed || uint_to_bytes(i//32))[i%32]
  -- if $(uint64_i / 32) = uint64_chunk
  -- if $uint_to_bytes(uint64_chunk) = bytes_chunk
  ;; fix hash(bytes32 + bytes)
  -- if $bytes32_to_bytes(bytes32_seed) = bytes_seed_bytes
  -- if $concat_bytes(bytes_seed_bytes, bytes_chunk) = bytes_msg
  -- if $hash_<bytes>(bytes_msg) = bytes32_h
  -- if $(uint64_i \ 32) = nat_b                      ;; 0..31
  -- if $bytes32_to_bytes1_list(bytes32_h) = bytes1_list_32*
  -- if bytes1_list_32*[nat_b] = bytes1_rb            ;; bytes1
  -- if $bytes1_to_uint64(bytes1_rb) = uint64_random_byte
  ;; 3 effective_balance 읽기
  -- if state.VALIDATORS[vid_candidate] = validator_v
  -- if gwei_effective = validator_v.EFFECTIVE_BALANCE
  ;; 4 조건 불만족 시 그대로
  -- if ~( $( gwei_effective * $MAX_RANDOM_BYTE >= $MAX_EFFECTIVE_BALANCE * uint64_random_byte ) )
  -- if vid_acc_sel* = vid_acc*
  ;; 5 재귀(i+1)
  -- if $next_sync_committee_indices_loop(
         state,
         vid_active*,
         bytes32_seed,
         uint64_active_cnt,
         $(uint64_i + 1),
         vid_acc_sel*
       ) = vid_ret*


;; --------------------------------------------
;; get_next_sync_committee_indices(state) : validatorIndex*
;; --------------------------------------------
dec $get_next_sync_committee_indices(beaconState) : validatorIndex*

def $get_next_sync_committee_indices(state) = vid_out*
  -- if $get_current_epoch(state) = epoch_cur
  -- if epoch_next = $( epoch_cur + 1 )
  -- if $get_active_validator_indices(state, epoch_next) = vid_active*
  -- if $( |vid_active*| ) = uint64_active_cnt
  -- if $get_seed(state, epoch_next, $DOMAIN_SYNC_COMMITTEE) = bytes32_seed
  -- if $next_sync_committee_indices_loop(
         state,
         vid_active*,
         bytes32_seed,
         uint64_active_cnt,
         0,
         eps ;; 빈 리스트 초기화 해서 넘기니까 그냥 eps 으로 넘김
       ) = vid_out*

;; --------------------------------------------
;; get_next_sync_committee(state) : SyncCommittee
;; --------------------------------------------
dec $get_next_sync_committee(beaconState) : syncCommittee

def $get_next_sync_committee(state) = syncCommittee
  -- if $get_next_sync_committee_indices(state) = vid*
  ;; indices로 선택된 validator들의 PUBKEY 리스트 생성
  -- if (state.VALIDATORS[vid].PUBKEY = blsPubkey_list)*
  ;; pubkey 집합을 BLS aggregate
  -- if $eth_aggregate_pubkeys(blsPubkey_list*) = blsPubkey_agg
  -- if syncCommittee =
       { PUBKEYS         blsPubkey_list*,
         AGGREGATE_PUBKEY blsPubkey_agg }


;; --------------------------------------------
;; get_indexed_attestation(state, attestation) : indexedAttestation
;; --------------------------------------------
dec $get_indexed_attestation(beaconState, attestation) : indexedAttestation

def $get_indexed_attestation(state, attestation) = indexedAttestation_ret
  -- if $get_attesting_indices(state, attestation) = vid_set*
  -- if $sort_<validatorIndex>(vid_set*) = vid_sorted*
  -- if indexedAttestation_ret =
       { ATTESTING_INDICES vid_sorted*,
         DATA               attestation.DATA,
         SIGNATURE          attestation.SIGNATURE }
