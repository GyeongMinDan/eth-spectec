;; =======================================
;; roots & randao mixes & inactivity helpers
;; =======================================

;; [Phase0] get_block_root_at_slot(BeaconState, Slot) -> Root
dec $get_block_root_at_slot(beaconState, slot) : root

def $get_block_root_at_slot(state, slot) = root
  ;; assert
  -- if $(slot < state.SLOT)
  ;; assert
  -- if $(state.SLOT <= slot + $SLOTS_PER_HISTORICAL_ROOT)
  -- if state.BLOCK_ROOTS[slot \ $SLOTS_PER_HISTORICAL_ROOT] = root

;; [Phase0] get_block_root(BeaconState, Epoch) -> Root
dec $get_block_root(beaconState, epoch) : root

def $get_block_root(state, epoch)
  = $get_block_root_at_slot(state, $compute_start_slot_at_epoch(epoch))

;; [Phase0] get_randao_mix(BeaconState, Epoch) -> Bytes32
dec $get_randao_mix(beaconState, epoch) : bytes32

def $get_randao_mix(state, epoch)
  = state.RANDAO_MIXES[epoch \ $EPOCHS_PER_HISTORICAL_VECTOR]

;; [Phase0] get_finality_delay(BeaconState) -> uint64
dec $get_finality_delay(beaconState) : uint64

def $get_finality_delay(state)
  = $( $get_previous_epoch(state) - state.FINALIZED_CHECKPOINT.EPOCH )
  ;; inserted underflow check
  -- if $( $get_previous_epoch(state) >= state.FINALIZED_CHECKPOINT.EPOCH )

;; [Phase0] is_in_inactivity_leak(BeaconState) -> bool
dec $is_in_inactivity_leak(beaconState) : boolean

def $is_in_inactivity_leak(state)
  = $( $get_finality_delay(state) > $MIN_EPOCHS_TO_INACTIVITY_PENALTY )
