;;
;; process_attestation
;;

relation ProcessAttestation:
  beaconState attestation ~> beaconState
  hint(input %0 %1)

rule ProcessAttestation/current:
  state attestation ~> state_out
  -- if attestationData = attestation.DATA
  -- if $get_previous_epoch(state) = epoch_prev
  -- if $get_current_epoch(state)  = epoch_cur
  -- if attestationData.TARGET.EPOCH = epoch_prev \/ attestationData.TARGET.EPOCH = epoch_cur
  -- if $( attestationData.TARGET.EPOCH = $compute_epoch_at_slot(attestationData.SLOT) )
  -- if $( attestationData.SLOT + $MIN_ATTESTATION_INCLUSION_DELAY <= state.SLOT )
  -- if $( state.SLOT <= attestationData.SLOT + $SLOTS_PER_EPOCH )
  -- if $( attestationData.INDEX < $get_committee_count_per_slot(state, attestationData.TARGET.EPOCH) )
  -- if vid_committee* = $get_beacon_committee(state, attestationData.SLOT, attestationData.INDEX)
  -- if |attestation.AGGREGATION_BITS| = |vid_committee*|
  ;; 현재 epoch 분기
  -- if attestationData.TARGET.EPOCH = epoch_cur
  -- if $( state.SLOT - attestationData.SLOT ) = uint64_inclusion_delay
  ;; Python 코드 순서: get_attestation_participation_flag_indices 호출 → is_valid_indexed_attestation 체크
  -- if $get_attestation_participation_flag_indices(state, attestationData, uint64_inclusion_delay) = nat_flag_indices*
  -- if $is_valid_indexed_attestation(state, $get_indexed_attestation(state, attestation)) = true  
  ;; 바깥 for: vi 리스트 만들기
  -- if vid_attesting* = $get_attesting_indices(state, attestation)
  ;; change map_list_2_
  -- if ($attach_flags_to_vi(vid_attesting, nat_flag_indices*) = (vid, nat_flags_vi*))*
  ;; fold over vi: (state, num) 누적
  -- if $fold_<(beaconState, gwei), (validatorIndex, nat*)>(
         def $process_one_vi_current,
         (state, 0),
         (vid, nat_flags_vi*)*
       ) = (state_after_flags, gwei_num)
  ;; proposer 보상 지급
  -- if $compute_proposer_reward(gwei_num) = reward_prop
  -- RewardProposer: state_after_flags `[ `? ] `+ reward_prop ~> state_out

rule ProcessAttestation/previous:
  state attestation ~> state_out
  -- if attestationData = attestation.DATA
  -- if $get_previous_epoch(state) = epoch_prev
  -- if $get_current_epoch(state)  = epoch_cur
  -- if ( attestationData.TARGET.EPOCH = epoch_prev \/ attestationData.TARGET.EPOCH = epoch_cur )
  -- if $( attestationData.TARGET.EPOCH = $compute_epoch_at_slot(attestationData.SLOT) )
  -- if $( attestationData.SLOT + $MIN_ATTESTATION_INCLUSION_DELAY <= state.SLOT )
  -- if $( state.SLOT <= attestationData.SLOT + $SLOTS_PER_EPOCH )
  -- if $( attestationData.INDEX < $get_committee_count_per_slot(state, attestationData.TARGET.EPOCH) )
  -- if vid_committee* = $get_beacon_committee(state, attestationData.SLOT, attestationData.INDEX)
  -- if |attestation.AGGREGATION_BITS| = |vid_committee*|
  ;; 이전 epoch 분기
  -- if attestationData.TARGET.EPOCH = epoch_prev
  -- if $( state.SLOT - attestationData.SLOT ) = uint64_inclusion_delay
  ;; Python 코드 순서: get_attestation_participation_flag_indices 호출 → is_valid_indexed_attestation 체크
  -- if $get_attestation_participation_flag_indices(state, attestationData, uint64_inclusion_delay) = nat_flag_indices*
  -- if $is_valid_indexed_attestation(state, $get_indexed_attestation(state, attestation)) = true
  -- if vid_attesting* = $get_attesting_indices(state, attestation)
  ;; change map_list_2_
  -- if ($attach_flags_to_vi(vid_attesting, nat_flag_indices*) = (vid, nat_flags_vi*))*
  -- if $fold_<(beaconState, gwei), (validatorIndex, nat*)>(
         def $process_one_vi_previous,
         (state, 0),
         (vid, nat_flags_vi*)*
       ) = (state_after_flags, gwei_num)
  -- if $compute_proposer_reward(gwei_num) = reward_prop
  -- RewardProposer: state_after_flags `[ `? ] `+ reward_prop ~> state_out



;; 
;; process_deposit
;;
relation ProcessDeposit:
  beaconState deposit ~> beaconState
  hint(input %0 %1)

rule ProcessDeposit/main:
  state deposit ~> state_applied
  -- if $is_valid_merkle_branch(
         $hash_tree_root_depositData(deposit.DATA),
         deposit.PROOF,
         $( $DEPOSIT_CONTRACT_TREE_DEPTH + 1 ),
         state.ETH1_DEPOSIT_INDEX,
         state.ETH1_DATA.DEPOSIT_ROOT
       ) = true
  -- if state_inc = state[.ETH1_DEPOSIT_INDEX = $(state.ETH1_DEPOSIT_INDEX + 1)]
  -- if state_applied =
       $apply_deposit(
         state_inc,
         deposit.DATA.PUBKEY,
         deposit.DATA.WITHDRAWAL_CREDENTIALS,
         deposit.DATA.AMOUNT,
         deposit.DATA.SIGNATURE
       )

