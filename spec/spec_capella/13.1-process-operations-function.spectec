;; apply proposer_slahsings
relation Apply_proposer_slashings:
  beaconState proposerSlashing* ~> beaconState
  hint(input %0 %1)

rule Apply_proposer_slashings/nil:
  state eps ~> state

rule Apply_proposer_slashings/cons:
  state (proposerSlashing_h :: proposerSlashing_t*) ~> state_out
  -- ProcessProposerSlashing: state proposerSlashing_h ~> state_mid
  -- Apply_proposer_slashings:  state_mid proposerSlashing_t* ~> state_out


