;; [Phase0]
;; process_proposer_slashing
;;  mutates: .VALIDATORS[].EXIT_EPOCH, .VALIDATORS[].WITHDRAWABLE_EPOCH, .SLASHINGS, .BALANCES

relation ProcessProposerSlashing:
  beaconState proposerSlashing ~> beaconState
  hint(input %0 %1)

rule ProcessProposerSlashing/main:
  state proposerSlashing ~> state_slashed
