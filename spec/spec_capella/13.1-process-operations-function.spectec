;; [Phase0 -> Altair]
;; process_attestation
;;  modifies: .CURRENT_EPOCH_PARTICIPATION / .PREVIOUS_EPOCH_PARTICIPATION, .BALANCES

relation ProcessAttestation:
  beaconState attestation ~> beaconState
  hint(input %0 %1)

rule ProcessAttestation/current_epoch:
  state attestation ~> state_out
  -- if attestationData = attestation.DATA
  ----
  ;; branch instead of assert 1
  -- if attestationData.TARGET.EPOCH = $get_current_epoch(state)
  ;; assert 2
  -- if attestationData.TARGET.EPOCH = $compute_epoch_at_slot(attestationData.SLOT)
  ;; assert 3
  -- if $( attestationData.SLOT + $MIN_ATTESTATION_INCLUSION_DELAY <= state.SLOT )
  -- if $( state.SLOT <= attestationData.SLOT + $SLOTS_PER_EPOCH )
  ;; assert 4
  -- if $( attestationData.INDEX < $get_committee_count_per_slot(state, attestationData.TARGET.EPOCH) )
  -- if vid_committee* = $get_beacon_committee(state, attestationData.SLOT, attestationData.INDEX)
  ;; assert 5
  -- if |attestation.AGGREGATION_BITS| = |vid_committee*|
  ;; participation flag indices
  -- if $get_attestation_participation_flag_indices(state, attestationData, $(state.SLOT - attestationData.SLOT)) = vid_participation_flag*
  ;; assert 6: verify signature
  -- if $is_valid_indexed_attestation(state, $get_indexed_attestation(state, attestation))
  ----
  ;; double loop
  -- if vid_attesting* = $get_attesting_indices(state, attestation)
  -- if $fold_<(beaconState, gwei), (validatorIndex, validatorIndex*)>(
         def $process_one_vi_current,
         (state, 0),
         (vid_attesting, vid_participation_flag*)*,
       ) = (state_1, reward_proposer_numerator)
  -- if $( ($WEIGHT_DENOMINATOR - $PROPOSER_WEIGHT) * $WEIGHT_DENOMINATOR / $PROPOSER_WEIGHT )
      = reward_proposer_denominator
  -- if $(reward_proposer_numerator / reward_proposer_denominator) = reward_proposer
  -- IncreaseBalance: state_1 `.BALANCES `[ $get_beacon_proposer_index(state_1) ] `+ reward_proposer ~> state_out

rule ProcessAttestation/previous_epoch:
  state attestation ~> state_out
  -- if attestationData = attestation.DATA
  ----
  ;; branch instead of assert 1
  -- if attestationData.TARGET.EPOCH = $get_previous_epoch(state)
  ;; assert 2
  -- if attestationData.TARGET.EPOCH = $compute_epoch_at_slot(attestationData.SLOT)
  ;; assert 3
  -- if $( attestationData.SLOT + $MIN_ATTESTATION_INCLUSION_DELAY <= state.SLOT )
  -- if $( state.SLOT <= attestationData.SLOT + $SLOTS_PER_EPOCH )
  ;; assert 4
  -- if $( attestationData.INDEX < $get_committee_count_per_slot(state, attestationData.TARGET.EPOCH) )
  -- if vid_committee* = $get_beacon_committee(state, attestationData.SLOT, attestationData.INDEX)
  ;; assert 5
  -- if |attestation.AGGREGATION_BITS| = |vid_committee*|
  ;; participation flag indices
  -- if $get_attestation_participation_flag_indices(state, attestationData, $(state.SLOT - attestationData.SLOT)) = vid_participation_flag*
  ;; assert 6: verify signature
  -- if $is_valid_indexed_attestation(state, $get_indexed_attestation(state, attestation))
  ----
  ;; double loop
  -- if vid_attesting* = $get_attesting_indices(state, attestation)
  -- if $fold_<(beaconState, gwei), (validatorIndex, validatorIndex*)>(
         def $process_one_vi_previous,
         (state, 0),
         (vid_attesting, vid_participation_flag*)*,
       ) = (state_1, reward_proposer_numerator)
  -- if $( ($WEIGHT_DENOMINATOR - $PROPOSER_WEIGHT) * $WEIGHT_DENOMINATOR / $PROPOSER_WEIGHT )
      = reward_proposer_denominator
  -- if $(reward_proposer_numerator / reward_proposer_denominator) = reward_proposer
  -- IncreaseBalance: state_1 `.BALANCES `[ $get_beacon_proposer_index(state_1) ] `+ reward_proposer ~> state_out

;; fold ProcessAttestation over attestation*
relation ProcessAttestations:
  beaconState attestation* ~> beaconState
  hint(input %0 %1)

rule ProcessAttestations/nil:
  state eps ~> state
rule ProcessAttestations/cons:
  state (attestation_h :: attestation_t*) ~> state_t
  -- ProcessAttestation: state attestation_h ~> state_h
  -- ProcessAttestations:  state_h attestation_t* ~> state_t


;; [Phase0]
;; process_deposit
;;  modifies: ETH1_DEPOSIT_INDEX,
;;    VALIDATORS, BALANCES, PREVIOUS_EPOCH_PARTICIPATION, CURRENT_EPOCH_PARTICIPATION, INACTIVITY_SCORES
relation ProcessDeposit:
  beaconState deposit ~> beaconState
  hint(input %0 %1)

rule ProcessDeposit/main:
  state deposit ~> state_applied
  -- if $is_valid_merkle_branch(
         $hash_tree_root_depositData(deposit.DATA),
         deposit.PROOF,
         $( $DEPOSIT_CONTRACT_TREE_DEPTH + 1 ),
         state.ETH1_DEPOSIT_INDEX,
         state.ETH1_DATA.DEPOSIT_ROOT
       ) = true
  -- if state_inc = state[.ETH1_DEPOSIT_INDEX = $(state.ETH1_DEPOSIT_INDEX + 1)]
  -- ApplyDeposit: state_inc `.VALIDATORS `++
      `{
        deposit.DATA.PUBKEY
        deposit.DATA.WITHDRAWAL_CREDENTIALS
        deposit.DATA.AMOUNT
      }
      SIGNED deposit.DATA.SIGNATURE ~> state_applied

;; fold ProcessDeposit over deposit*
relation ProcessDeposits:
  beaconState deposit* ~> beaconState
  hint(input %0 %1)

rule ProcessDeposits/nil:
  state eps ~> state
rule ProcessDeposits/cons:
  state (deposit_h :: deposit_t*) ~> state_t
  -- ProcessDeposit: state deposit_h ~> state_h
  -- ProcessDeposits:  state_h deposit_t* ~> state_t


