;;
;; process_block_header
;;
relation Process_block_header:
  beaconState beaconBlock ~> beaconState
  hint(input %0 %1)

rule Process_block_header:
  state block ~> state[.LATEST_BLOCK_HEADER = beaconBlockHeader_new]
  ;; assert 1
  -- if block.SLOT = state.SLOT
  ;; assert 2
  -- if $(state.LATEST_BLOCK_HEADER.SLOT < block.SLOT)
  -- if $get_beacon_proposer_index(state) = vid_prop_vi
  ;; assert 3
  -- if block.PROPOSER_INDEX = vid_prop_vi
  -- if root_parent_expected_root = $hash_tree_root_beaconBlockHeader(state.LATEST_BLOCK_HEADER)
  ;; assert 4
  -- if block.PARENT_ROOT = root_parent_expected_root
  -- if $hash_tree_root_beaconBlockBody(block.BODY) = root_body_root_new
  -- if beaconBlockHeader_new =
       { SLOT block.SLOT,
         PROPOSER_INDEX block.PROPOSER_INDEX,
         PARENT_ROOT block.PARENT_ROOT,
         STATE_ROOT $ZERO_ROOT,
         BODY_ROOT root_body_root_new }
  -- if $(vid_prop_vi < |state.VALIDATORS|)
  -- if state.VALIDATORS[vid_prop_vi] = validator_proposer
  ;; assert 5
  -- if ~validator_proposer.SLASHED


;;
;; process_withdrawals
;;   
relation ProcessWithdrawals:
  beaconState executionPayload ~> beaconState
  hint(input %0 %1)

;; ========== len(expected) = 0 ==========
rule ProcessWithdrawals/len0:
  state executionPayload_payload ~> state_out
  -- if $get_expected_withdrawals(state) = withdrawal_expect*
  ;; assert
  -- if executionPayload_payload.WITHDRAWALS = withdrawal_expect*
  -- ApplyWithdrawals: state withdrawal_expect* ~>* state_after_debits
  -- if |withdrawal_expect*| = uint64_len
  ----
  ;; branch-if
  -- if uint64_len = 0
  -- if |state_after_debits.VALIDATORS| = uint64_N
  -- if $( state_after_debits.NEXT_WITHDRAWAL_VALIDATOR_INDEX
         + $MAX_VALIDATORS_PER_WITHDRAWALS_SWEEP ) = uint64_next
  -- if $( uint64_next \ uint64_N ) = vid_next
  -- if state_out =
       state_after_debits
         [.NEXT_WITHDRAWAL_VALIDATOR_INDEX = vid_next]

;; ========== len(expected) = MAX_WITHDRAWALS_PER_PAYLOAD ==========
rule ProcessWithdrawals/lenMax:
  state executionPayload ~> state_out
  -- if $get_expected_withdrawals(state) = withdrawal_expect*
  ;; assert
  -- if executionPayload.WITHDRAWALS = withdrawal_expect*
  -- ApplyWithdrawals: state withdrawal_expect* ~>* state_after_debits
  -- if |withdrawal_expect*| = uint64_len
  ----
  ;; branch-elseif
  -- if uint64_len = $MAX_WITHDRAWALS_PER_PAYLOAD
  -- if $( uint64_len - 1 ) = uint64_last
  -- if withdrawal_expect*[uint64_last] = withdrawal_latest
  ;; next_withdrawal_index = latest.index + 1
  -- if $( withdrawal_latest.INDEX + 1 ) = withdrawalIndex_next
  ;; next_withdrawal_validator_index = (latest.validator_index + 1) % N
  -- if |state_after_debits.VALIDATORS| = uint64_N
  -- if withdrawal_latest.VALIDATOR_INDEX = vid_last
  -- if $( vid_last + 1 ) = uint64_next
  -- if $( uint64_next \ uint64_N ) = vid_next
  -- if state_out =
       state_after_debits
         [.NEXT_WITHDRAWAL_INDEX           = withdrawalIndex_next]
         [.NEXT_WITHDRAWAL_VALIDATOR_INDEX = vid_next]

;; ========== 0 < len(expected) < MAX_WITHDRAWALS_PER_PAYLOAD ==========
rule ProcessWithdrawals/lenPartial:
  state executionPayload ~> state_out
  -- if $get_expected_withdrawals(state) = withdrawal_expect*
  ;; assert
  -- if executionPayload.WITHDRAWALS = withdrawal_expect*
  -- ApplyWithdrawals: state withdrawal_expect* ~>* state_after_debits
  -- if |withdrawal_expect*| = uint64_len
  ----
  ;; branch-else
  -- if uint64_len =/= 0
  -- if uint64_len =/= $MAX_WITHDRAWALS_PER_PAYLOAD
  -- if $( uint64_len - 1 ) = uint64_last
  -- if withdrawal_expect*[uint64_last] = withdrawal_latest
  ;; next_withdrawal_index = latest.index + 1
  -- if $( withdrawal_latest.INDEX + 1 ) = withdrawalIndex_next
  ;; next_withdrawal_validator_index = (state.next_withdrawal_validator_index + SWEEP) % N
  -- if |state_after_debits.VALIDATORS| = uint64_N
  -- if $( state_after_debits.NEXT_WITHDRAWAL_VALIDATOR_INDEX
         + $MAX_VALIDATORS_PER_WITHDRAWALS_SWEEP ) = uint64_next
  -- if $( uint64_next \ uint64_N ) = vid_next
  -- if state_out =
       state_after_debits
         [.NEXT_WITHDRAWAL_INDEX = withdrawalIndex_next]
         [.NEXT_WITHDRAWAL_VALIDATOR_INDEX = vid_next]



;;
;; process_execution_payload
;;
relation ProcessExecutionPayload:
  beaconState beaconBlockBody ~> beaconState
  hint(input %0 %1)

rule ProcessExecutionPayload/main:
  state body ~> state[ .LATEST_EXECUTION_PAYLOAD_HEADER = executionPayloadHeader ]
  -- if executionPayload = body.EXECUTION_PAYLOAD
  ;; assert 1
  -- if executionPayload.PARENT_HASH = state.LATEST_EXECUTION_PAYLOAD_HEADER.BLOCK_HASH
  -- if $get_current_epoch(state) = epoch_cur
  -- if $get_randao_mix(state, epoch_cur) = bytes32_randao_expected
  ;; assert 2
  -- if executionPayload.PREV_RANDAO = bytes32_randao_expected
  -- if $compute_time_at_slot(state, state.SLOT) = uint64_ts_expected
  ;; assert 3
  -- if executionPayload.TIMESTAMP = uint64_ts_expected
  ;; assert 4
  -- if $ee_verify_and_notify_new_payload(executionPayload)
  -- if $hash_tree_root_tx(executionPayload.TRANSACTIONS) = root_tx
  -- if $hash_tree_root_withdrawals(executionPayload.WITHDRAWALS) = root_withdrawal
  -- if executionPayloadHeader =
       { PARENT_HASH        executionPayload.PARENT_HASH,
         FEE_RECIPIENT      executionPayload.FEE_RECIPIENT,
         STATE_ROOT         executionPayload.STATE_ROOT,
         RECEIPTS_ROOT      executionPayload.RECEIPTS_ROOT,
         LOGS_BLOOM         executionPayload.LOGS_BLOOM,
         PREV_RANDAO        executionPayload.PREV_RANDAO,
         BLOCK_NUMBER       executionPayload.BLOCK_NUMBER,
         GAS_LIMIT          executionPayload.GAS_LIMIT,
         GAS_USED           executionPayload.GAS_USED,
         TIMESTAMP          executionPayload.TIMESTAMP,
         EXTRA_DATA         executionPayload.EXTRA_DATA,
         BASE_FEE_PER_GAS   executionPayload.BASE_FEE_PER_GAS,
         BLOCK_HASH         executionPayload.BLOCK_HASH,
         TRANSACTIONS_ROOT  root_tx,
         WITHDRAWALS_ROOT   root_withdrawal }


