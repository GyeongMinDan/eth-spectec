;;
;; [Phase0]
;; process_block_header
;;  modifies: LATEST_BLOCK_HEADER
;;

relation ProcessBlockHeader:
  beaconState beaconBlock ~> beaconState
  hint(input %0 %1)

rule ProcessBlockHeader:
  state block ~> state[.LATEST_BLOCK_HEADER = beaconBlockHeader_new]
  ;; assert 1: slots match
  -- if block.SLOT = state.SLOT
  ;; assert 2: block is newer than latest block header
  -- if $(state.LATEST_BLOCK_HEADER.SLOT < block.SLOT)
  ;; assert 3: block proposer is correct
  -- if $get_beacon_proposer_index(state) = block.PROPOSER_INDEX
  ;; assert 4: parent matches
  -- if block.PARENT_ROOT = $hash_tree_root_beaconBlockHeader(state.LATEST_BLOCK_HEADER)
  -- if beaconBlockHeader_new =
       { SLOT block.SLOT,
         PROPOSER_INDEX block.PROPOSER_INDEX,
         PARENT_ROOT block.PARENT_ROOT,
         STATE_ROOT $ZERO_ROOT,
         BODY_ROOT $hash_tree_root_beaconBlockBody(block.BODY) }
  ;; inserted: bound check
  -- if $(block.PROPOSER_INDEX < |state.VALIDATORS|)
  ;; assert 5: proposer is not slashed
  -- if ~state.VALIDATORS[block.PROPOSER_INDEX].SLASHED


;;
;; [Capella]
;; process_withdrawals
;;  modifies: NEXT_WITHDRAWAL_INDEX, NEXT_WITHDRAWAL_VALIDATOR_INDEX
;;

relation ProcessWithdrawals:
  beaconState executionPayload ~> beaconState
  hint(input %0 %1)

;; ========== len(expected) = 0 ==========
rule ProcessWithdrawals/len0:
  state executionPayload ~> 
    state_after_debits[.NEXT_WITHDRAWAL_VALIDATOR_INDEX = vid_next]
  -- if $get_expected_withdrawals(state) = withdrawal_expected*
  ;; assert
  -- if executionPayload.WITHDRAWALS = withdrawal_expected*
  -- ApplyWithdrawals: state withdrawal_expected* ~>* state_after_debits
  ----
  ;; branch-if
  -- if |withdrawal_expected*| = 0
  -- if $( (state_after_debits.NEXT_WITHDRAWAL_VALIDATOR_INDEX
         + $MAX_VALIDATORS_PER_WITHDRAWALS_SWEEP) \ |state_after_debits.VALIDATORS| ) = vid_next

;; ========== len(expected) = MAX_WITHDRAWALS_PER_PAYLOAD ==========
rule ProcessWithdrawals/lenMax:
  state executionPayload ~> 
    state_after_debits
      [.NEXT_WITHDRAWAL_INDEX           = withdrawalIndex_next]
      [.NEXT_WITHDRAWAL_VALIDATOR_INDEX = vid_next]
  -- if $get_expected_withdrawals(state) = withdrawal_expected*
  ;; assert
  -- if executionPayload.WITHDRAWALS = withdrawal_expected*
  -- ApplyWithdrawals: state withdrawal_expected* ~>* state_after_debits
  ----
  ;; branch-elseif
  -- if |withdrawal_expected*| = $MAX_WITHDRAWALS_PER_PAYLOAD
  -- if |withdrawal_expected*| = uint64_len
  ;; TODO: support negative indexing
  -- if withdrawal_expected*[uint64_len - 1] = withdrawal_latest
  -- if $(withdrawal_latest.INDEX + 1 ) = withdrawalIndex_next
  -- if $(( withdrawal_latest.VALIDATOR_INDEX + 1 \ |state_after_debits.VALIDATORS|)) = vid_next

;; ========== 0 < len(expected) < MAX_WITHDRAWALS_PER_PAYLOAD ==========
rule ProcessWithdrawals/lenPartial:
  state executionPayload ~> 
    state_after_debits
      [.NEXT_WITHDRAWAL_INDEX = withdrawalIndex_next]
      [.NEXT_WITHDRAWAL_VALIDATOR_INDEX = vid_next]
  -- if $get_expected_withdrawals(state) = withdrawal_expected*
  ;; assert
  -- if executionPayload.WITHDRAWALS = withdrawal_expected*
  -- ApplyWithdrawals: state withdrawal_expected* ~>* state_after_debits
  ----
  ;; branch-else
  -- if |withdrawal_expected*| =/= 0
  -- if |withdrawal_expected*| =/= $MAX_WITHDRAWALS_PER_PAYLOAD
  -- if |withdrawal_expected*| = uint64_len
  ;; TODO: support negative indexing
  -- if withdrawal_expected*[uint64_len - 1] = withdrawal_latest
  -- if $( withdrawal_latest.INDEX + 1 ) = withdrawalIndex_next
  -- if $( (state_after_debits.NEXT_WITHDRAWAL_VALIDATOR_INDEX
         + $MAX_VALIDATORS_PER_WITHDRAWALS_SWEEP) \ |state_after_debits.VALIDATORS| ) = vid_next



;;
;; [Bellatrix -> Capella]
;; process_execution_payload
;;  modifies: LATEST_EXECUTION_PAYLOAD_HEADER
;;

relation ProcessExecutionPayload:
  beaconState beaconBlockBody ~> beaconState
  hint(input %0 %1)

rule ProcessExecutionPayload/main:
  state body ~> state[ .LATEST_EXECUTION_PAYLOAD_HEADER = executionPayloadHeader ]
  -- if executionPayload = body.EXECUTION_PAYLOAD
  ;; assert 1
  -- if executionPayload.PARENT_HASH = state.LATEST_EXECUTION_PAYLOAD_HEADER.BLOCK_HASH
  ;; assert 2
  -- if executionPayload.PREV_RANDAO = $get_randao_mix(state, $get_current_epoch(state))
  ;; assert 3
  -- if executionPayload.TIMESTAMP = $compute_time_at_slot(state, state.SLOT)
  ;; assert 4
  -- if $ee_verify_and_notify_new_payload(executionPayload)
  -- if executionPayloadHeader =
       { PARENT_HASH        executionPayload.PARENT_HASH,
         FEE_RECIPIENT      executionPayload.FEE_RECIPIENT,
         STATE_ROOT         executionPayload.STATE_ROOT,
         RECEIPTS_ROOT      executionPayload.RECEIPTS_ROOT,
         LOGS_BLOOM         executionPayload.LOGS_BLOOM,
         PREV_RANDAO        executionPayload.PREV_RANDAO,
         BLOCK_NUMBER       executionPayload.BLOCK_NUMBER,
         GAS_LIMIT          executionPayload.GAS_LIMIT,
         GAS_USED           executionPayload.GAS_USED,
         TIMESTAMP          executionPayload.TIMESTAMP,
         EXTRA_DATA         executionPayload.EXTRA_DATA,
         BASE_FEE_PER_GAS   executionPayload.BASE_FEE_PER_GAS,
         BLOCK_HASH         executionPayload.BLOCK_HASH,
         TRANSACTIONS_ROOT  $hash_tree_root_tx(executionPayload.TRANSACTIONS),
         WITHDRAWALS_ROOT   $hash_tree_root_withdrawals(executionPayload.WITHDRAWALS) }


