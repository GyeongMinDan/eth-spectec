;; =========================
;; helpers for Increase / Decrease / initiate_validator_exit / slash_validator / apply_deposit 
;; =========================

;; ------------------------------------------------------------
;; increase_balance(beaconState, validatorIndex, gwei) : beaconState
;; ------------------------------------------------------------
relation IncreaseBalance:
  beaconState `.BALANCES `[ validatorIndex ] `+ gwei ~> beaconState
  hint(input %0 %1 %2)

rule IncreaseBalance:
  state `.BALANCES `[ vid ] `+ delta ~> state[ .BALANCES[vid] = $(balance + delta) ]
  -- if $(vid < |state.BALANCES|)
  -- if state.BALANCES[vid] = balance

;; ------------------------------------------------------------
;; decrease_balance(beaconState, validatorIndex, gwei) : beaconState
;; ------------------------------------------------------------
relation DecreaseBalance:
  beaconState `.BALANCES  `[ validatorIndex ] `- gwei ~> beaconState
  hint(input %0 %1 %2)

rule DecreaseBalance/zero:
  state `.BALANCES `[ vid ] `- delta ~> state[ .BALANCES[vid] = 0]
  -- if $(vid < |state.BALANCES|)
  -- if state.BALANCES[vid] = balance
  ;; branch
  -- if $(delta > balance)
  
rule DecreaseBalance/remains:
  state `.BALANCES `[ vid ] `- delta ~> state[ .BALANCES[vid] = $(balance - delta) ]
  -- if $(vid < |state.BALANCES|)
  -- if state.BALANCES[vid] = balance
  ;; branch
  -- if $(delta <= balance)

;; ----------------------------
;; helpers for exit-epoch lists
;; ----------------------------
dec $exit_epoch_not_far_future(validator) : boolean
def $exit_epoch_not_far_future(validator) = true
  -- if validator.EXIT_EPOCH =/= $FAR_FUTURE_EPOCH
def $exit_epoch_not_far_future(validator) = false
  -- otherwise

dec $exit_epoch_eq(validator, epoch) : boolean
def $exit_epoch_eq(validator, epoch) = true
  -- if validator.EXIT_EPOCH = epoch
def $exit_epoch_eq(validator, epoch) = false
  -- otherwise

;; fold for max over epochs 
dec $fold_max_epoch(epoch, epoch) : epoch
def $fold_max_epoch(epoch_acc, epoch_x) = $max_uint64(epoch_acc, epoch_x)

;; helper: churn >= limit이면 epoch + 1, 아니면 epoch
dec $select_epoch_exit_queue(epoch, uint64, uint64) : epoch
def $select_epoch_exit_queue(epoch_exit_queue_0, uint64_churn, uint64_limit) = epoch_result
  -- if $( uint64_churn >= uint64_limit )
  -- if $( epoch_exit_queue_0 + 1 ) = epoch_result
def $select_epoch_exit_queue(epoch_exit_queue_0, uint64_churn, uint64_limit) = epoch_result
  -- if $( uint64_churn < uint64_limit )
  -- if epoch_exit_queue_0 = epoch_result

;; --------------------------------------------
;; initiate_validator_exit(state, index) : state
;; --------------------------------------------
relation InitiateValidatorExit:
  beaconState `.VALIDATORS `[ validatorIndex ] ~> beaconState
  hint(input %0 %1)

;; skip condition: already exited
rule InitiateValidatorExit/skip:
  state `.VALIDATORS `[ vid ] ~> state
  ;; inserted guard
  -- if $(vid < |state.VALIDATORS|)
  -- if state.VALIDATORS[vid] = validator
  ;; branch
  -- if validator.EXIT_EPOCH =/= $FAR_FUTURE_EPOCH

;; main logic: brancing in helper functions
rule InitiateValidatorExit/main:
  state `.VALIDATORS `[ vid ] ~> state[.VALIDATORS[vid] = validator[.EXIT_EPOCH = epoch_exit_queue][.WITHDRAWABLE_EPOCH = epoch_withdrawable]]
  -- if $(vid < |state.VALIDATORS|)
  -- if state.VALIDATORS[vid] = validator
  ;; branch
  -- if validator.EXIT_EPOCH = $FAR_FUTURE_EPOCH
  ;; (1) exit_epochs = [v.exit_epoch for v in state.validators if v.exit_epoch != FAR_FUTURE_EPOCH]
  -- if $filter_list_<validator>(state.VALIDATORS, def $exit_epoch_not_far_future) = validator_exit*
  -- if (validator_exit.EXIT_EPOCH = epoch_exit)*
  ;; (2) epoch_act_exit = compute_activation_exit_epoch(get_current_epoch(state))
  -- if $compute_activation_exit_epoch($get_current_epoch(state)) = epoch_activation_exit
  ;; (3) exit_queue_epoch_0 = max(exit_epochs + [epoch_act_exit])
  -- if epoch_exit* ++ [ epoch_activation_exit ] = epoch_exit_all*
  -- if $fold_<epoch, epoch>(def $fold_max_epoch, 0, epoch_exit_all*) = epoch_exit_queue_0
  ;; (4) exit_queue_churn = len([v for v in state.validators if v.exit_epoch == exit_queue_epoch_0])
  -- if $filter_list_2_<validator, epoch>(validator_exit*, epoch_exit_queue_0, def $exit_epoch_eq) = validator_list_eq*
  -- if |validator_list_eq*| = uint64_exit_queue_churn
  ;; (5) 한도 체크 및 epoch_exit_queue 결정 (helper 함수로 분기 처리)
  -- if $get_validator_churn_limit(state) = uint64_churn_limit
  ;; TODO: inline helper
  -- if $select_epoch_exit_queue(epoch_exit_queue_0, uint64_exit_queue_churn, uint64_churn_limit) = epoch_exit_queue
  ;; (6) update validator.exit_epoch / withdrawable_epoch
  -- if epoch_withdrawable = $( epoch_exit_queue + $MIN_VALIDATOR_WITHDRAWABILITY_DELAY )


