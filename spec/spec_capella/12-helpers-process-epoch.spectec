rule ApplyInactivity/unslashed_participating_leak:
  state `.INACTIVITY_SCORES `[ vid ] ~> state_mid
  -- if $get_previous_epoch(state) = epoch_prev
  -- if $get_unslashed_participating_indices(state, $TIMELY_TARGET_FLAG_INDEX, epoch_prev) = vid_participating_prev*
