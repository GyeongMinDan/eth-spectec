;; =========================
;; P=0, C=1  →  (A and C) (A and D) (B and C) (B and D) + A / B / C / D / None  (9개) 
;; =========================
def $weigh_justification_and_finalization(state, balance_total_active, gwei_prev_tgt, gwei_cur_tgt) = state_out
  -- if $get_previous_epoch(state) = epoch_prev
  -- if $get_current_epoch(state)  = epoch_cur
  -- if checkpoint_old_prev = state.PREVIOUS_JUSTIFIED_CHECKPOINT
  -- if checkpoint_old_cur  = state.CURRENT_JUSTIFIED_CHECKPOINT
  -- if boolean_old_bits* = state.JUSTIFICATION_BITS
  -- if boolean_bits_init* = [ false, boolean_old_bits*[0], boolean_old_bits*[1], boolean_old_bits*[2] ]
  -- if $(gwei_prev_tgt * 3 >= balance_total_active * 2) = false   ;; P=0
  -- if $(gwei_cur_tgt  * 3 >= balance_total_active * 2) = true    ;; C=1
  -- if boolean_bits_after_P* = boolean_bits_init*
  -- if boolean_bits_final*   = boolean_bits_after_P*[[0] = true]
  ;; JC (C 경로)
  -- if $get_block_root(state, epoch_cur) = root_cur
  -- if checkpoint_cur = { EPOCH epoch_cur, ROOT root_cur }
  -- if state_pj  = state[.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_old_cur]
  -- if state_cj  = state_pj[.CURRENT_JUSTIFIED_CHECKPOINT  = checkpoint_cur]
  -- if state_bits = state_cj[.JUSTIFICATION_BITS = boolean_bits_final*]
  ;; A ∧ C 전제
  -- if boolean_bits_final*[1] = true
  -- if boolean_bits_final*[2] = true
  -- if boolean_bits_final*[3] = true
  -- if $(checkpoint_old_prev.EPOCH + 3 = epoch_cur)      ;; A
  -- if boolean_bits_final*[0] = true
  -- if $(checkpoint_old_cur.EPOCH + 2 = epoch_cur)       ;; C
  -- if state_out = state_bits[.FINALIZED_CHECKPOINT = checkpoint_old_cur]

def $weigh_justification_and_finalization(state, balance_total_active, gwei_prev_tgt, gwei_cur_tgt) = state_out
  -- if $get_previous_epoch(state) = epoch_prev
  -- if $get_current_epoch(state)  = epoch_cur
  -- if checkpoint_old_prev = state.PREVIOUS_JUSTIFIED_CHECKPOINT
  -- if checkpoint_old_cur  = state.CURRENT_JUSTIFIED_CHECKPOINT
  -- if boolean_old_bits* = state.JUSTIFICATION_BITS
  -- if boolean_bits_init* = [ false, boolean_old_bits*[0], boolean_old_bits*[1], boolean_old_bits*[2] ]
  -- if $(gwei_prev_tgt * 3 >= balance_total_active * 2) = false   ;; P=0
  -- if $(gwei_cur_tgt  * 3 >= balance_total_active * 2) = true    ;; C=1
  -- if boolean_bits_after_P* = boolean_bits_init*
  -- if boolean_bits_final*   = boolean_bits_after_P*[[0] = true]
  ;; JC (C 경로)
  -- if $get_block_root(state, epoch_cur) = root_cur
  -- if checkpoint_cur = { EPOCH epoch_cur, ROOT root_cur }
