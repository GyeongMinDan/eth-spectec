;; === ProcessRewardsAndPenalties ===

;; [Custom] loop helper for ProcessRewardsAndPenalties
;; apply reward -> penalty for a single index
relation ApplyRewardAndPenalty: 
  beaconState `.BALANCES `[ validatorIndex ] `+ gwei `- gwei ~> beaconState
  hint(input %0 %1 %2 %3)

rule ApplyRewardAndPenalty:
  state `.BALANCES `[ vid ] `+ reward `- penalty ~> state_out
  -- IncreaseBalance: state   `.BALANCES `[ vid ] `+ reward  ~> state_r
  -- DecreaseBalance: state_r `.BALANCES `[ vid ] `- penalty ~> state_out

;; folder
;; implicit: should fail on length mismatch
;; apply reward -> penalty -> reward -> penalty -> ...
relation ApplyRewardsAndPenalties:
  beaconState `.BALANCES `[ validatorIndex* ] `+ gwei* `- gwei* ~> beaconState
  hint(input %0 %1 %2 %3)

rule ApplyRewardsAndPenalties/nil:
  state `.BALANCES `[ eps ] `+ eps `- eps ~> state

rule ApplyRewardsAndPenalties/cons:
  state `.BALANCES `[ vid_h :: vid_t* ] `+ (reward_h :: reward_t*) `- (penalty_h :: penalty_t*) ~> state_out
  -- ApplyRewardAndPenalty: state `.BALANCES `[ vid_h ] `+ reward_h `- penalty_h ~> state_h
  -- ApplyRewardsAndPenalties: state_h `.BALANCES `[ vid_t* ] `+ reward_t* `- penalty_t* ~> state_out

;; folder
;; implicit: should fail on length mismatch
;; apply rewards and penalties for multiple validators
relation ApplyRewardsAndPenalties_over_deltas:
  beaconState `.BALANCES `[ validatorIndex* ] `+ gwei** `- gwei** ~>* beaconState
  hint(input %0 %1 %2 %3)

rule ApplyRewardsAndPenalties_over_deltas/nil:
  state `.BALANCES `[ _ ] `+ eps `- eps ~>* state

rule ApplyRewardsAndPenalties_over_deltas/cons:
  state `.BALANCES `[ vid* ] `+ (reward* :: reward_t**) `- (penalty* :: penalty_t**) ~>* state_out
  -- ApplyRewardsAndPenalties: state `.BALANCES `[ vid* ] `+ reward* `- penalty* ~> state_t
  -- ApplyRewardsAndPenalties_over_deltas: state_t `.BALANCES `[ vid* ] `+ reward_t** `- penalty_t** ~>* state_out

;; === ProcessInactivityUpdates ===

;; [Custom]
;; apply inactivity score update for a single index
relation ApplyInactivity:
  beaconState `.INACTIVITY_SCORES `[ validatorIndex ] ~> beaconState
  hint(input %0 %1)

rule ApplyInactivity/unslashed_participating_no_leak:
  state `.INACTIVITY_SCORES `[ vid ] ~> state_updated
  ----
  ;; branch 1 : true
  -- if vid <- $get_unslashed_participating_indices(state, $TIMELY_TARGET_FLAG_INDEX, $get_previous_epoch(state))
  ;; branch 2 : false
  -- if ~ $is_in_inactivity_leak(state)
  ;; inserted guard
  -- if $(vid < |state.INACTIVITY_SCORES|)
  -- if state_updated
      = state[.INACTIVITY_SCORES[vid]
               = $max_uint64($(state.INACTIVITY_SCORES[vid] - 1 - $INACTIVITY_SCORE_RECOVERY_RATE), 0)
             ]

rule ApplyInactivity/unslashed_participating_leak:
  state `.INACTIVITY_SCORES `[ vid ] ~> state_updated
  ----
  ;; branch 1 : true
  -- if vid <- $get_unslashed_participating_indices(state, $TIMELY_TARGET_FLAG_INDEX, $get_previous_epoch(state))
  ;; branch 2 : true
  -- if $is_in_inactivity_leak(state)
  ;; inserted guard
  -- if $(vid < |state.INACTIVITY_SCORES|)
  -- if state_updated
      = state[.INACTIVITY_SCORES[vid]
               = $max_uint64($(state.INACTIVITY_SCORES[vid] - 1), 0)
             ]

rule ApplyInactivity/inactive_no_leak:
  state `.INACTIVITY_SCORES `[ vid ] ~> state_updated
  ----
  ;; branch 1 : false
  -- if ~(vid <- $get_unslashed_participating_indices(state, $TIMELY_TARGET_FLAG_INDEX, $get_previous_epoch(state)))
  ;; branch 2 : false
  -- if ~ $is_in_inactivity_leak(state)
  -- if n_leak_penalty = $($INACTIVITY_SCORE_BIAS - $INACTIVITY_SCORE_RECOVERY_RATE)
  ;; inserted guard
  -- if $(vid < |state.INACTIVITY_SCORES|)
  -- if state_updated
      = state[.INACTIVITY_SCORES[vid]
               = $max_uint64($(state.INACTIVITY_SCORES[vid] + n_leak_penalty), 0)
             ]

rule ApplyInactivity/inactive_leak:
  state `.INACTIVITY_SCORES `[ vid ] ~> state_updated
  ----
  ;; branch 1 : false
  -- if ~(vid <- $get_unslashed_participating_indices(state, $TIMELY_TARGET_FLAG_INDEX, $get_previous_epoch(state)))
  ;; branch 2 : true
  -- if $is_in_inactivity_leak(state)
  ;; inserted guard
  -- if $(vid < |state.INACTIVITY_SCORES|)
  -- if state_updated
      = state[.INACTIVITY_SCORES[vid]
               = $max_uint64($(state.INACTIVITY_SCORES[vid] + $INACTIVITY_SCORE_BIAS), 0)
             ]

;; [Custom] folder
relation ApplyInactivity_over_vids:
  beaconState `.INACTIVITY_SCORES `[ validatorIndex* ] ~>* beaconState
  hint(input %0 %1)

rule ApplyInactivity_over_vids/nil:
  state `.INACTIVITY_SCORES `[ eps ] ~>* state

rule ApplyInactivity_over_vids/cons:
  state `.INACTIVITY_SCORES `[ (vid_h :: vid_t*) ] ~>* state_updated
  -- ApplyInactivity: state `.INACTIVITY_SCORES `[ vid_h ] ~> state_1
  -- ApplyInactivity_over_vids: state_1 `.INACTIVITY_SCORES `[ vid_t* ] ~>* state_updated

;; === ProcessSlashings ===

;; [Custom] filter predicate

dec $is_due_slashing_en(enumerated_<validator>, epoch) : boolean

def $is_due_slashing_en((_, validator), epoch) = true
  -- if validator.SLASHED = true
  -- if $( epoch + ($EPOCHS_PER_SLASHINGS_VECTOR / 2) = validator.WITHDRAWABLE_EPOCH )

def $is_due_slashing_en((_, _), _) = false
  -- otherwise

;; [Custom] folder for DecreaseBalance
relation DecreaseBalances:
  beaconState `.BALANCES `[ validatorIndex* ] `- gwei* ~> beaconState
  hint(input %0 %1 %2)

rule DecreaseBalances/nil:
  state `.BALANCES `[ eps ] `- eps ~> state

rule DecreaseBalances/cons:
  state `.BALANCES `[ (vid_h :: vid_t*) ] `- (penalty_h :: penalty_t*) ~> state_t
  -- DecreaseBalance: state `.BALANCES `[ vid_h ] `- penalty_h ~> state_h
  -- DecreaseBalances: state_h `.BALANCES `[ vid_t* ] `- penalty_t* ~> state_t

;; === ProcessJustificationAndFinalization ===

;; [Phase0]
;; weigh_justification_and_finalization
;;  mutates: .JUSTIFICATION_BITS, .FINALIZED_CHECKPOINT, .PREVIOUS_JUSTIFIED_CHECKPOINT, .CURRENT_JUSTIFIED_CHECKPOINT

;; Note: both justification and finalization have three distinct semantic branches:
;; justify/finalize current, justify/finalize previous, neither

relation WeighJustificationAndFinalization:
  beaconState
    TOTAL gwei
    PREV gwei
    CUR gwei
    ~> beaconState
  hint(input %0 %1 %2 %3)

;; === justify neither: two branches ===

rule WeighJustificationAndFinalization/justify_neither_finalize_prev:
  state
    TOTAL balance_total_active
    PREV balance_prev_epoch_target
    CUR balance_current_epoch_target
    ~> state[.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_cur]
            [.FINALIZED_CHECKPOINT = checkpoint_prev]
            [.JUSTIFICATION_BITS = bit*]
  -- if $get_previous_epoch(state) = epoch_prev
  -- if $get_current_epoch(state)  = epoch_cur
  -- if state.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_prev
  -- if state.CURRENT_JUSTIFIED_CHECKPOINT = checkpoint_cur
  ----
  ;; branch 1: (false, false)
  -- if ~ $(balance_prev_epoch_target * 3 >= balance_total_active * 2)
  -- if ~ $(balance_current_epoch_target  * 3 >= balance_total_active * 2)
  -- if bit* = [
          false,
          state.JUSTIFICATION_BITS[0],
          state.JUSTIFICATION_BITS[1],
          state.JUSTIFICATION_BITS[2]
        ]
  ----
  ;; branch 2: true
  -- if (bit*[1] /\ bit*[2] /\ bit*[3]  /\ $(checkpoint_prev.EPOCH + 3) = $get_current_epoch(state))
     \/ (bit*[1] /\ bit*[2] /\ $(checkpoint_prev.EPOCH + 2) = $get_current_epoch(state))

rule WeighJustificationAndFinalization/justify_neither_finalize_neither:
  state
    TOTAL balance_total_active
    PREV balance_prev_epoch_target
    CUR balance_current_epoch_target
    ~> state[.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_cur]
            [.JUSTIFICATION_BITS = bit*]
  -- if $get_previous_epoch(state) = epoch_prev
  -- if $get_current_epoch(state)  = epoch_cur
  -- if state.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_prev
  -- if state.CURRENT_JUSTIFIED_CHECKPOINT = checkpoint_cur
  ----
  ;; branch 1: (false, false)
  -- if ~ $(balance_prev_epoch_target * 3 >= balance_total_active * 2)
  -- if ~ $(balance_current_epoch_target  * 3 >= balance_total_active * 2)
  -- if bit* = [
          false,
          state.JUSTIFICATION_BITS[0],
          state.JUSTIFICATION_BITS[1],
          state.JUSTIFICATION_BITS[2]
        ]
  ----
  ;; branch 2: false
  -- if ~(bit*[1] /\ bit*[2] /\ bit*[3]  /\ $(checkpoint_prev.EPOCH + 3) = $get_current_epoch(state))
     /\ ~(bit*[1] /\ bit*[2] /\ $(checkpoint_prev.EPOCH + 2) = $get_current_epoch(state))

rule WeighJustificationAndFinalization/justify_prev_finalize_prev:
  state
    TOTAL balance_total_active
    PREV balance_prev_epoch_target
    CUR balance_current_epoch_target
    ~> state[.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_cur]
            [.CURRENT_JUSTIFIED_CHECKPOINT
              = { EPOCH epoch_prev,
                  ROOT $get_block_root(state, epoch_prev) }]
            [.FINALIZED_CHECKPOINT = checkpoint_prev]
            [.JUSTIFICATION_BITS = bit*]
  -- if $get_previous_epoch(state) = epoch_prev
  -- if $get_current_epoch(state)  = epoch_cur
  -- if state.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_prev
  -- if state.CURRENT_JUSTIFIED_CHECKPOINT = checkpoint_cur
  ----
  ;; branch 1: (true, false)
  -- if $(balance_prev_epoch_target * 3 >= balance_total_active * 2)
  -- if ~ $(balance_current_epoch_target  * 3 >= balance_total_active * 2)
  -- if bit* = [
          false,
          true,
          state.JUSTIFICATION_BITS[1],
          state.JUSTIFICATION_BITS[2]
        ]
  ----
  ;; branch 2: true
  -- if (bit*[1] /\ bit*[2] /\ bit*[3]  /\ $(checkpoint_prev.EPOCH + 3) = $get_current_epoch(state))
     \/ (bit*[1] /\ bit*[2] /\ $(checkpoint_prev.EPOCH + 2) = $get_current_epoch(state))

rule WeighJustificationAndFinalization/justify_prev_finalize_neither:
  state
    TOTAL balance_total_active
    PREV balance_prev_epoch_target
    CUR balance_current_epoch_target
    ~> state[.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_cur]
            [.CURRENT_JUSTIFIED_CHECKPOINT
              = { EPOCH epoch_prev,
                  ROOT $get_block_root(state, epoch_prev) }]
            [.JUSTIFICATION_BITS = bit*]
  -- if $get_previous_epoch(state) = epoch_prev
  -- if $get_current_epoch(state)  = epoch_cur
  -- if state.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_prev
  -- if state.CURRENT_JUSTIFIED_CHECKPOINT = checkpoint_cur
  ----
  ;; branch 1: (true, false)
  -- if $(balance_prev_epoch_target * 3 >= balance_total_active * 2)
  -- if ~ $(balance_current_epoch_target  * 3 >= balance_total_active * 2)
  -- if bit* = [
          false,
          true,
          state.JUSTIFICATION_BITS[1],
          state.JUSTIFICATION_BITS[2]
        ]
  ----
  ;; branch 2: false
  -- if ~(bit*[1] /\ bit*[2] /\ bit*[3]  /\ $(checkpoint_prev.EPOCH + 3) = $get_current_epoch(state))
     /\ ~(bit*[1] /\ bit*[2] /\ $(checkpoint_prev.EPOCH + 2) = $get_current_epoch(state))

rule WeighJustificationAndFinalization/justify_cur_finalize_cur:
  state
    TOTAL balance_total_active
    PREV balance_prev_epoch_target
    CUR balance_current_epoch_target
    ~> state[.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_cur]
            [.CURRENT_JUSTIFIED_CHECKPOINT
              = { EPOCH epoch_cur,
                  ROOT $get_block_root(state, epoch_cur) }]
            [.FINALIZED_CHECKPOINT = checkpoint_cur]
            [.JUSTIFICATION_BITS = bit*]
  -- if $get_previous_epoch(state) = epoch_prev
  -- if $get_current_epoch(state)  = epoch_cur
  -- if state.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_prev
  -- if state.CURRENT_JUSTIFIED_CHECKPOINT = checkpoint_cur
  ----
  ;; branch 1: (_, true)
  -- if $(balance_current_epoch_target * 3 >= balance_total_active * 2)
  -- if bit* = [
          true,
          state.JUSTIFICATION_BITS[0]
          \/ $(balance_prev_epoch_target * 3 >= balance_total_active * 2),
          state.JUSTIFICATION_BITS[1],
          state.JUSTIFICATION_BITS[2]
        ]
  ----
  ;; branch 2: (true, _)
  -- if (bit*[0] /\ bit*[1] /\ bit*[2] /\ $(checkpoint_cur.EPOCH + 2) = $get_current_epoch(state))
     \/ (bit*[0] /\ bit*[1] /\ $(checkpoint_cur.EPOCH + 1) = $get_current_epoch(state))

rule WeighJustificationAndFinalization/justify_cur_finalize_prev:
  state
    TOTAL balance_total_active
    PREV balance_prev_epoch_target
    CUR balance_current_epoch_target
    ~> state[.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_cur]
            [.CURRENT_JUSTIFIED_CHECKPOINT
              = { EPOCH epoch_cur,
                  ROOT $get_block_root(state, epoch_cur) }]
            [.FINALIZED_CHECKPOINT = checkpoint_prev]
            [.JUSTIFICATION_BITS = bit*]
  -- if $get_previous_epoch(state) = epoch_prev
  -- if $get_current_epoch(state)  = epoch_cur
  -- if state.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_prev
  -- if state.CURRENT_JUSTIFIED_CHECKPOINT = checkpoint_cur
  ----
  ;; branch 1: (_, true)
  -- if $(balance_current_epoch_target * 3 >= balance_total_active * 2)
  -- if bit* = [
          true,
          state.JUSTIFICATION_BITS[0]
          \/ $(balance_prev_epoch_target * 3 >= balance_total_active * 2),
          state.JUSTIFICATION_BITS[1],
          state.JUSTIFICATION_BITS[2]
        ]
  ----
  ;; branch 2: (false, true)
  -- if ~(bit*[0] /\ bit*[1] /\ bit*[2] /\ $(checkpoint_cur.EPOCH + 2) = $get_current_epoch(state))
     /\ ~(bit*[0] /\ bit*[1] /\ $(checkpoint_cur.EPOCH + 1) = $get_current_epoch(state))
     /\ ((bit*[1] /\ bit*[2] /\ bit*[3]  /\ $(checkpoint_prev.EPOCH + 3) = $get_current_epoch(state))
     \/  (bit*[1] /\ bit*[2] /\ $(checkpoint_prev.EPOCH + 2) = $get_current_epoch(state)))

rule WeighJustificationAndFinalization/justify_cur_finalize_neither:
  state
    TOTAL balance_total_active
    PREV balance_prev_epoch_target
    CUR balance_current_epoch_target
    ~> state[.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_cur]
            [.CURRENT_JUSTIFIED_CHECKPOINT
              = { EPOCH epoch_cur,
                  ROOT $get_block_root(state, epoch_cur) }]
            [.JUSTIFICATION_BITS = bit*]
  -- if $get_previous_epoch(state) = epoch_prev
  -- if $get_current_epoch(state)  = epoch_cur
  -- if state.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_prev
  -- if state.CURRENT_JUSTIFIED_CHECKPOINT = checkpoint_cur
  ----
  ;; branch 1: (_, true)
  -- if $(balance_current_epoch_target * 3 >= balance_total_active * 2)
  -- if bit* = [
          true,
          state.JUSTIFICATION_BITS[0]
          \/ $(balance_prev_epoch_target * 3 >= balance_total_active * 2),
          state.JUSTIFICATION_BITS[1],
          state.JUSTIFICATION_BITS[2]
        ]
  ----
  ;; branch 2: (false, false)
  -- if ~(bit*[0] /\ bit*[1] /\ bit*[2] /\ $(checkpoint_cur.EPOCH + 2) = $get_current_epoch(state))
     /\ ~(bit*[0] /\ bit*[1] /\ $(checkpoint_cur.EPOCH + 1) = $get_current_epoch(state))
     /\ ~(bit*[1] /\ bit*[2] /\ bit*[3]  /\ $(checkpoint_prev.EPOCH + 3) = $get_current_epoch(state))
     /\ ~(bit*[1] /\ bit*[2] /\ $(checkpoint_prev.EPOCH + 2) = $get_current_epoch(state))

;; ============================================
;; helpers for process_registry_updates (fixed)
;; ============================================

;; (i, v)가 activation 자격인가?  (state 캡처)
dec $is_eligible_activation_en((nat, validator), beaconState) : boolean
def $is_eligible_activation_en((i, validator), state) =
  $is_eligible_for_activation(state, validator)

;; (i, v) ↦ (v.ACTIVATION_ELIGIBILITY_EPOCH, ValidatorIndex(i))  (state 캡처 안 씀)
dec $activation_key_en((nat, validator), beaconState) : (epoch, validatorIndex)
def $activation_key_en((i, validator), state) = (epoch_key, vid)
  -- if epoch_key = validator.ACTIVATION_ELIGIBILITY_EPOCH
  -- if vid = i

;; enumerate 결과 (n, vi)에서 n < limit ?
dec $idx_lt_limit((nat, validatorIndex), uint64) : boolean
def $idx_lt_limit((i, vid), uint64_lim) = true
  -- if $(i < uint64_lim)
def $idx_lt_limit((i, vid), uint64_lim) = false
  -- otherwise

;; set the activation epoch for a given validator
relation SetActivation:
  beaconState validatorIndex ~> beaconState
  hint(input %0 %1)

rule SetActivation:
  state validatorIndex ~> state_out
  -- if $get_current_epoch(state) = epoch_cur
  -- if $compute_activation_exit_epoch(epoch_cur) = epoch_act
  -- if $(validatorIndex < |state.VALIDATORS|)
  -- if validator_new = state.VALIDATORS[validatorIndex][.ACTIVATION_EPOCH = epoch_act]
  -- if state_out = state[.VALIDATORS[validatorIndex] = validator_new]

relation SetActivations:
  beaconState validatorIndex* ~>* beaconState
  hint(input %0 %1)

rule SetActivations/nil:
  state eps ~>* state

rule SetActivations/cons:
  state (vid_h :: vid_t*) ~>* state_out
  -- SetActivation: state vid_h ~> state'
  -- SetActivations: state' vid_t* ~>* state_out

;; (i, v) 한 쌍 처리: eligibility_epoch 설정 및 eject
dec $process_registry_one(beaconState, (nat, validator)) : beaconState

;; case 1: activation queue 자격 O + ejection 조건 O → eligibility_epoch 갱신 + eject
def $process_registry_one(state, (i, validator)) = state_after
  -- if $get_current_epoch(state) = epoch_cur
  -- if $is_eligible_for_activation_queue(validator) = true
  -- if epoch_elig = $(epoch_cur + 1)
  -- if validator_set_elig = validator[.ACTIVATION_ELIGIBILITY_EPOCH = epoch_elig]
  -- if state_elig = state[.VALIDATORS = state.VALIDATORS[[i] = validator_set_elig]]
  -- if state_elig.VALIDATORS[i] = validator_read
  -- if $is_active_validator(validator_read, epoch_cur) = true
  -- if $(validator_read.EFFECTIVE_BALANCE <= $EJECTION_BALANCE)
  -- InitiateValidatorExit: state_elig `.VALIDATORS `[ i ] ~> state_after

;; case 2: activation queue 자격 O + ejection 조건 X → eligibility_epoch 갱신만
def $process_registry_one(state, (i, validator)) = state_after
  -- if $get_current_epoch(state) = epoch_cur
  -- if $is_eligible_for_activation_queue(validator) = true
  -- if epoch_elig = $(epoch_cur + 1)
  -- if validator_set_elig = validator[.ACTIVATION_ELIGIBILITY_EPOCH = epoch_elig]
  -- if state_elig = state[.VALIDATORS = state.VALIDATORS[[i] = validator_set_elig]]
  -- if state_elig.VALIDATORS[i] = validator_read
  -- if ~( $is_active_validator(validator_read, epoch_cur) = true
         /\ $(validator_read.EFFECTIVE_BALANCE <= $EJECTION_BALANCE) )
  -- if state_after = state_elig

;; case 3: 자격 X + eject 조건 O → eject만
def $process_registry_one(state, (i, validator)) = state_after
  -- if $get_current_epoch(state) = epoch_cur
  -- if $is_eligible_for_activation_queue(validator) = false
  -- if state_mid = state
  -- if state_mid.VALIDATORS[i] = validator_read
  -- if $is_active_validator(validator_read, epoch_cur) = true
  -- if $(validator_read.EFFECTIVE_BALANCE <= $EJECTION_BALANCE) = true
  -- InitiateValidatorExit: state_mid `.VALIDATORS `[ i ] ~> state_after

;; case 4: 그 외 → 변화 없음
def $process_registry_one(state, (i, validator)) = state
  -- otherwise
