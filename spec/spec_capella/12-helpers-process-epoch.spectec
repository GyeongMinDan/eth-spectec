  -- if boolean_old_bits*[2] = boolean_b2p
  -- if boolean_bits_init*   = [ false, boolean_b0p, boolean_b1p, boolean_b2p ]
  -- if $(gwei_prev_tgt * 3 >= balance_total_active * 2) = true    ;; P=1
  -- if $(gwei_cur_tgt  * 3 >= balance_total_active * 2) = false   ;; C=0
  -- if boolean_bits_after_P* = boolean_bits_init*[[1] = true]
  -- if boolean_bits_final*   = boolean_bits_after_P*
  ;; JC 업데이트 (prev ← checkpoint_old_cur; curr ← (epoch_prev, root_prev))
  -- if $get_block_root(state, epoch_prev) = root_prev
  -- if checkpoint_prev = { EPOCH epoch_prev, ROOT root_prev }
  -- if state_pj  = state[.PREVIOUS_JUSTIFIED_CHECKPOINT = checkpoint_old_cur]
  -- if state_cj  = state_pj[.CURRENT_JUSTIFIED_CHECKPOINT  = checkpoint_prev]
  -- if state_bits = state_cj[.JUSTIFICATION_BITS = boolean_bits_final*]
