;; process_block

relation ProcessBlock:
  beaconState beaconBlock ~>* beaconState
  hint(input %0 %1)

rule ProcessBlock:
  state block ~>* state_6
  ;; Phase0
  -- ProcessBlockHeader:      state     block                         ~>  state_0
  ;; Capella
  -- ProcessWithdrawals:       state_0               block.BODY.EXECUTION_PAYLOAD  ~>  state_1
  ;; Bellatrix -> Capella
  -- ProcessExecutionPayload: state_1               block.BODY                    ~>  state_2
  ;; Phase0
  -- ProcessRandao:            state_2               block.BODY                    ~>  state_3
  ;; Phase0
  -- ProcessEth1Data:         state_3               block.BODY                    ~>  state_4
  ;; Phase0 -> Altair -> Capella
  -- ProcessOperations:        state_4               block.BODY                    ~>  state_5
  ;; Altair
  -- ProcessSyncAggregate:    state_5               block.BODY.SYNC_AGGREGATE     ~>  state_6
