  -- ProcessExecutionPayload: state_1               block_beaconBlock.BODY                    ~>  state_2
  ;; Phase0
  -- Process_randao:            state_2               block_beaconBlock.BODY                    ~>  state_3
  ;; Phase0
  -- Process_eth1_data:         state_3               block_beaconBlock.BODY                    ~>  state_4
  ;; Phase0 -> Altair -> Capella
