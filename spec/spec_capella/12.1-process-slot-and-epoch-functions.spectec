;; [Phase 0 -> Capella]
;; process_historical_summaries_update
;;  mutates: .HISTORICAL_SUMMARIES

relation ProcessHistoricalSummariesUpdate:
  beaconState ~> beaconState
  hint(input %0)

rule ProcessHistoricalSummariesUpdate/skip:
  state ~> state
  -- if $($get_current_epoch(state) + 1) = epoch_next
  ;; branch-complete
  -- if $(epoch_next \ ($SLOTS_PER_HISTORICAL_ROOT / $SLOTS_PER_EPOCH)) =/= 0

rule ProcessHistoricalSummariesUpdate/main:
  state ~>
    state[.HISTORICAL_SUMMARIES = state.HISTORICAL_SUMMARIES ++ [ historicalSummary ]]
  -- otherwise
  ;; -- if $($get_current_epoch(state) + 1) = epoch_next
  ;; ;; branch-complete
  ;; -- if $( epoch_next \ ($SLOTS_PER_HISTORICAL_ROOT / $SLOTS_PER_EPOCH) ) = 0
  -- if $hash_tree_root_roots(state.BLOCK_ROOTS) = root_block_summary
  -- if $hash_tree_root_roots(state.STATE_ROOTS) = root_state_summary
  -- if { BLOCK_SUMMARY_ROOT root_block_summary, STATE_SUMMARY_ROOT root_state_summary } = historicalSummary

;; [Altair]
;; process_participation_flag_updates:
;;  initialize current participation flags to zero
;;  mutates: .PREVIOUS_EPOCH_PARTICIPATION, .CURRENT_EPOCH_PARTICIPATION

relation ProcessParticipationFlagUpdates:
  beaconState ~> beaconState
  hint(input %0)

rule ProcessParticipationFlagUpdates:
  state ~> 
    state[.PREVIOUS_EPOCH_PARTICIPATION = state.CURRENT_EPOCH_PARTICIPATION]
         [.CURRENT_EPOCH_PARTICIPATION = participationFlags_zero*]
  -- if $repeat_<participationFlags>(0, |state.VALIDATORS|) = participationFlags_zero*

;; [Altair]
;; process_sync_committee_updates:
;;  initialize sync committees for next epoch
;;  mutates: .CURRENT_SYNC_COMMITTEE, NEXT_SYNC_COMMITTEE

relation ProcessSyncCommitteeUpdates:
  beaconState ~> beaconState
  hint(input %0)

rule ProcessSyncCommitteeUpdates/skip:
  state ~> state
  -- if $($get_current_epoch(state) + 1) = epoch_next
  ;; branch-complete
  -- if $(epoch_next \ $EPOCHS_PER_SYNC_COMMITTEE_PERIOD) =/= 0

rule ProcessSyncCommitteeUpdates/main:
  state ~> 
    state[.CURRENT_SYNC_COMMITTEE = state.NEXT_SYNC_COMMITTEE]
         [.NEXT_SYNC_COMMITTEE    = $get_next_sync_committee(state)]
  -- otherwise
  ;; -- if $($get_current_epoch(state) + 1) = epoch_next
  ;; ;; branch-complete
  ;; -- if $(epoch_next \ $EPOCHS_PER_SYNC_COMMITTEE_PERIOD) = 0
