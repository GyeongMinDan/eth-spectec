  -- if ( $get_flag_index_deltas(state, vid_flag) = (reward_flag*, penalty_flag*) )*
  ;; 2: get flag rewards and penalties
  ;; 3: get inactivity rewards and penalties
  -- if $get_inactivity_penalty_deltas(state) = (reward_inactivity*, penalty_inactivity*)
  -- if reward_flag** ++ [reward_inactivity*] = reward**
  -- if penalty_flag** ++ [penalty_inactivity*] = penalty**
  ;; 4: create validator indices
  -- if $range(|state.VALIDATORS|) = vid*
  ;; 5: apply rewards and penalties to each validator
  -- ApplyRewardsAndPenalties_all: state `.BALANCES `[ vid* ] `+ reward** `- penalty** ~>* state_out

;;
;; process_registry_updates
;;
relation Process_Registry_Updates:
  beaconState ~> beaconState
  hint(input %0)

rule Process_Registry_Updates/main:
  state ~> state_out
  ;; (1) pass 1: process eligibility and ejections for each validator
  -- if $enumerate_<validator>(state.VALIDATORS) = (i, validator_v)*
  -- if state_1 = $fold_<beaconState, (nat, validator)>(
         def $process_registry_one,
         state,
         (i, validator_v)*
       )
  ;; (2) activation 후보 인덱스 수집 + (elig_epoch, index) 키로 정렬
  -- if $enumerate_<validator>(state_1.VALIDATORS) = (j, validator_w)*
  -- if $filter_list_2_<(nat, validator), beaconState>(
         (j, validator_w)*,
         state_1,
         def $is_eligible_activation_en
       ) = (nat_elg, validator_elg)*
  -- if ($activation_key_en((nat_elg, validator_elg), state_1) = (epoch_key, vid))*
  -- if $sort_<(epoch, validatorIndex)>((epoch_key, vid)*) =
         (_, vid_sorted)*
  ;; (3) churn limit 만큼만 dequeue → ACTIVATION_EPOCH 세팅
  -- if $get_validator_churn_limit(state_1) = uint64_churn_limit
  -- if $enumerate_<validatorIndex>(vid_sorted*) = (nat_idx, vid_q)*
  -- if $filter_list_2_<(nat, validatorIndex), uint64>(
        (nat_idx, vid_q)*,
        uint64_churn_limit,
        def $idx_lt_limit
      ) = (_, vid_to_activate)*
  -- SetActivations: state_1 vid_to_activate* ~>* state_out

;;
;; process_slashings
;;
relation Process_slashings:
  beaconState ~> beaconState
  hint(input %0)

rule Process_slashings:
  state ~> state_out
  ;; 1 계산에 사용할 값들 
  -- if $get_current_epoch(state) = epoch_cur 
  -- if $get_total_active_balance(state) = gwei_total_active
  -- if $sum_<gwei>(state.SLASHINGS) = gwei_slash_sum 
  -- if $( gwei_slash_sum * $PROPORTIONAL_SLASHING_MULTIPLIER_BELLATRIX ) = gwei_scaled
  -- if $min_uint64(gwei_scaled, gwei_total_active) = gwei_adj_total_slash
  ;; 2 validator 인덱스 for 문으로 inices 뽑고, 그 안에서 slashing 할 조건으로 index 추출
  -- if validator_list* = state.VALIDATORS
  -- if $enumerate_<validator>(validator_list*) = (nat_i, validator_v)*
  -- if $filter_list_2_<(nat, validator), epoch>(
         (nat_i, validator_v)*,
         epoch_cur,
         def $is_due_slashing_en
       ) = (nat_due, validator_due)*
  ;; 3 penalty 계산(map, (adj_total_slash, total_active))
  ;; change map_list_2_
  -- if ($compute_slash_penalty_en((nat_due, validator_due), (gwei_adj_total_slash, gwei_total_active)) = (vid, penalty))*
  ;; 4 fold 로 적용
  -- if $fold_<beaconState, (validatorIndex, gwei)>(
         def $apply_one_decrease,
         state,
         (vid, penalty)*
       ) = state_out


