;; === SLOT PROCESSING ===

;; [Phase 0]
;; process_slot

relation ProcessSlot:
  beaconState ~> beaconState
  hint(input %0)

;; branch1: cache state root, header state root and block root
rule ProcessSlot/header_root_empty:
  state ~>
    state[.STATE_ROOTS[i] = root_state_prev]
         [.LATEST_BLOCK_HEADER = beaconBlockHeader]
         [.BLOCK_ROOTS[i] = root_block_prev]
  -- if $( state.SLOT \ $SLOTS_PER_HISTORICAL_ROOT ) = i
  ;; branch-complete
  -- if state.LATEST_BLOCK_HEADER.STATE_ROOT = $ZERO_ROOT
  ;; save state root
  -- if $hash_tree_root_beaconState(state) = root_state_prev
  ;; save latest block header state root
  -- if state.LATEST_BLOCK_HEADER[.STATE_ROOT = $hash_tree_root_beaconState(state)]
      = beaconBlockHeader
  ;; save block root
  -- if $hash_tree_root_beaconBlockHeader(beaconBlockHeader) = root_block_prev

;; branch2: cache state root and block root
rule ProcessSlot/header_root_not_empty:
  state ~>
    state[.STATE_ROOTS[i] = root_state_prev]
         [.BLOCK_ROOTS[i] = root_block_prev]
  -- if $( state.SLOT \ $SLOTS_PER_HISTORICAL_ROOT ) = i
  ;; branch-complete
  -- if state.LATEST_BLOCK_HEADER.STATE_ROOT =/= $ZERO_ROOT
  ;; save state root
  -- if $hash_tree_root_beaconState(state) = root_state_prev
  ;; save block root
  -- if $hash_tree_root_beaconBlockHeader(state.LATEST_BLOCK_HEADER) = root_block_prev

;; === EPOCH PROCESSING ===

;; [Phase0 -> Altair]
;; process_justification_and_finalization
;;  mutates: .JUSTIFICATION_BITS, .FINALIZED_CHECKPOINT, .PREVIOUS_JUSTIFIED_CHECKPOINT, .CURRENT_JUSTIFIED_CHECKPOINT

relation ProcessJustificationAndFinalization:
  beaconState ~> beaconState
  hint(input %0)

rule ProcessJustificationAndFinalization/skip:
  state ~> state
  -- if $get_current_epoch(state) = epoch_cur
  -- if $(epoch_cur <= ($GENESIS_EPOCH + 1))

rule ProcessJustificationAndFinalization/main:
  state ~> state_updated
  -- if $get_unslashed_participating_indices(
          state, $TIMELY_TARGET_FLAG_INDEX, $get_previous_epoch(state)
        ) = vid_prev*
  -- if $get_unslashed_participating_indices(
          state, $TIMELY_TARGET_FLAG_INDEX, $get_current_epoch(state)
        ) = vid_cur*
  -- if $get_total_active_balance(state) = balance_total_active
  -- if $get_total_balance(state, vid_prev*) = balance_prev_target
  -- if $get_total_balance(state, vid_cur*) = balance_cur_target
  -- WeighJustificationAndFinalization:
      state
        TOTAL balance_total_active
        PREV balance_prev_target
        CUR balance_cur_target
        ~> state_updated

