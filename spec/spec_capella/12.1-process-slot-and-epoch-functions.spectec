;;
;; process_slot
;;
relation ProcessSlot:
  beaconState ~> beaconState
  hint(input %0)

;; ------------------------------------------------------------
;; case 1: LATEST_BLOCK_HEADER.STATE_ROOT is empty ($ZERO_ROOT)
;;   - cache state root
;;   - cache header state root
;;   - cache block root
;; ------------------------------------------------------------
rule ProcessSlot/header_root_empty:
  state ~> state_out
  -- if $hash_tree_root_beaconState(state) = root_state_prev
  -- if $( state.SLOT \ $SLOTS_PER_HISTORICAL_ROOT ) = uint64_idx
  -- if state_1 = state[.STATE_ROOTS[uint64_idx] = root_state_prev]
  ----
  ;; branch
  -- if state_1.LATEST_BLOCK_HEADER.STATE_ROOT = $ZERO_ROOT
  -- if state_1[.LATEST_BLOCK_HEADER.STATE_ROOT = root_state_prev] = state_2
  ----
  ;; converge
  -- if $hash_tree_root_beaconBlockHeader(state_2.LATEST_BLOCK_HEADER) = root_block_prev
  -- if state_2.BLOCK_ROOTS[[uint64_idx] = root_block_prev] = root_block_list_updated*
  -- if state_out = state_2[.BLOCK_ROOTS = root_block_list_updated*]

;; ------------------------------------------------------------
;; case 2: LATEST_BLOCK_HEADER.STATE_ROOT is set
;;   - cache state root
;;   - cache block root
;; ------------------------------------------------------------
rule ProcessSlot/header_root_present:
  state ~> state_out
  -- if $hash_tree_root_beaconState(state) = root_state_prev
  -- if $( state.SLOT \ $SLOTS_PER_HISTORICAL_ROOT ) = uint64_idx
  -- if state_1 = state[.STATE_ROOTS[uint64_idx] = root_state_prev]
  ----
  ;; branch
  -- if state_1.LATEST_BLOCK_HEADER.STATE_ROOT =/= $ZERO_ROOT
  ----
  ;; converge
  -- if $hash_tree_root_beaconBlockHeader(state_1.LATEST_BLOCK_HEADER) = root_block_prev
  -- if state_1.BLOCK_ROOTS[[uint64_idx] = root_block_prev] = root_block_list_updated*
  -- if state_out = state_1[.BLOCK_ROOTS = root_block_list_updated*]


;;
;; process_justification_and_finalization
;;
relation Process_justification_and_finalization:
  beaconState ~> beaconState
  hint(input %0)

rule Process_justification_and_finalization/skip:
  state ~> state
  -- if $get_current_epoch(state) = epoch_cur
  -- if $(epoch_cur <= ($GENESIS_EPOCH + 1))

rule Process_justification_and_finalization/main:
  state ~> state_weighed
  -- if $get_current_epoch(state) = epoch_cur
  -- if $get_previous_epoch(state) = epoch_prev
  -- if $get_unslashed_participating_indices(state, $TIMELY_TARGET_FLAG_INDEX, epoch_prev) = vid_prev*
  -- if $get_unslashed_participating_indices(state, $TIMELY_TARGET_FLAG_INDEX, epoch_cur)  = vid_curr*
  -- if $get_total_active_balance(state) = balance_total_active
  -- if $get_total_balance(state, vid_prev*) = balance_prev_target
  -- if $get_total_balance(state, vid_curr*) = balance_curr_target
  -- if $weigh_justification_and_finalization(state, balance_total_active, balance_prev_target, balance_curr_target) = state_weighed


