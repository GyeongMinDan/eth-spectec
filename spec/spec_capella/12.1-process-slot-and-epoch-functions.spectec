;; [Capella]
;; process_rewards_and_penalties
;;  mutates: .BALANCES

relation ProcessRewardsAndPenalties:
  beaconState ~> beaconState
  hint(input %0)

rule ProcessRewardsAndPenalties/skip:
  state ~> state
  -- if $get_current_epoch(state) = $GENESIS_EPOCH

rule ProcessRewardsAndPenalties/main:
  state ~> state_out
  -- otherwise
  ;; 1: create flag indices: 0..|PARTICIPATION_FLAG_WEIGHTS|-1
  -- if $range(|$PARTICIPATION_FLAG_WEIGHTS|) = vid_flag*
  -- if ( $get_flag_index_deltas(state, vid_flag) = (reward_flag*, penalty_flag*) )*
  ;; 2: get flag rewards and penalties
  ;; 3: get inactivity rewards and penalties
  -- if $get_inactivity_penalty_deltas(state) = (reward_inactivity*, penalty_inactivity*)
  -- if reward_flag** ++ [reward_inactivity*] = reward**
  -- if penalty_flag** ++ [penalty_inactivity*] = penalty**
  ;; 4: create validator indices
  -- if $range(|state.VALIDATORS|) = vid*
  ;; 5: apply rewards and penalties to each validator
  -- ApplyRewardsAndPenalties_over_deltas: state `.BALANCES `[ vid* ] `+ reward** `- penalty** ~>* state_out

;; [Phase 0]
;; process_registry_updates
;;  mutates: .VALIDATORS[](.ACTIVATION_ELIGIBILITY_EPOCH, .EXIT_EPOCH, .WITHDRAWABLE_EPOCH, .ACTIVATION_EPOCH)

relation ProcessRegistryUpdates:
  beaconState ~> beaconState
  hint(input %0)

rule ProcessRegistryUpdates:
  state ~> state_out
  ;; 1. process eligibility and ejections for each validator
  -- if $range(|state.VALIDATORS|) = vid*
  -- ProcessEligibilityAndEjection_over_vids:
      state `.VALIDATORS `[ vid* ] ~> state_1
  ;; queue validators eligible for activation and not yet dequeued for activattion
  -- if $enumerate_<validator>(state_1.VALIDATORS) = (vid_1, validator)*
  -- if $filter_list_2_<(nat, validator), beaconState>(
         (vid_1, validator)*,
         state_1,
         def $is_eligible_activation_en
       ) = (vid_elg, validator_elg)*
  -- if (validator_elg.ACTIVATION_ELIGIBILITY_EPOCH = epoch_elg)*
  -- if $sort_<(epoch, validatorIndex)>((epoch_elg, vid_elg)*) =
         (_, vid_activation_queue)*
  ;; 3. dequeue validators up to the churn limit for activation
  -- if vid_activation_queue*[0:$get_validator_churn_limit(state_1)] = vid_dequeued*
  -- ApplyActivations:
      state_1 `.VALIDATORS `[ vid_dequeued* ] `.ACTIVATION_EPOCH ~>* state_out

;; [Phase 0] -> [Altair] -> [Bellatrix]
;; process_slashings
;;  mutates: .BALANCES

relation ProcessSlashings:
  beaconState ~> beaconState
  hint(input %0)

rule ProcessSlashings:
  state ~> state_out
  -- if $get_current_epoch(state) = epoch_cur 
  -- if $get_total_active_balance(state) = balance_total
  ;; inserted overflow check
  -- if $( $sum_<gwei>(state.SLASHINGS) <= $UINT64_MAX / $PROPORTIONAL_SLASHING_MULTIPLIER_BELLATRIX )
  -- if $min_uint64(
        $( $sum_<gwei>(state.SLASHINGS) * $PROPORTIONAL_SLASHING_MULTIPLIER_BELLATRIX ),
        balance_total
      ) = balance_adjusted_total_slashing
  -- if $enumerate_<validator>(state.VALIDATORS) = (vid, validator)*
  -- if $filter_list_2_<(validatorIndex, validator), epoch>(
         (vid, validator)*,
         epoch_cur,
         def $is_due_slashing_en
       ) = (vid_due, validator_due)*
  ;; 3. get penalties
  -- if gwei_increment = $EFFECTIVE_BALANCE_INCREMENT
  -- if ($( (validator_due.EFFECTIVE_BALANCE / gwei_increment) * balance_adjusted_total_slashing )
      = penalty_numerator)*
  -- if ($( (penalty_numerator / balance_total) * gwei_increment ) = penalty)*
  ;; 4. apply penalties
  -- DecreaseBalances: state `.BALANCES `[ vid_due* ] `- penalty* ~> state_out

