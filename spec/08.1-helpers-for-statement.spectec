;; =========================
;; Generic fold 
;; =========================
dec $fold_<X, Y>(def $fold_func(X, Y): X, X, Y*) : X
def $fold_<X, Y>(def $fold_func, X, eps) = X
def $fold_<X, Y>(def $fold_func, X, Y_h :: Y_t*)
= $fold_<X, Y>(def $fold_func, $fold_func(X, Y_h), Y_t*)

;;
;; helpers for get_active_validator_indices
;;

syntax enumerated_<X> = (nat, X)
dec $enumerate_<X>(X*) : enumerated_<X>*

dec $filter_list_<X>(X*, def $cond(X) : bool)
  : X*
def $filter_list_<X>(eps, def $cond) = eps
def $filter_list_<X>(X_h :: X_t*, def $cond)
  = X_h :: $filter_list_<X>(X_t*, def $cond)
  -- if $cond(X_h) = true
def $filter_list_<X>(X_h :: X_t*, def $cond)
  = $filter_list_<X>(X_t*, def $cond)
  -- if $cond(X_h) = false

dec $filter_list_2_<X, Y>(X*, Y, def $cond(X, Y) : bool) : X*


dec $is_active_validator_enumerated(enumerated_<validator>, epoch) : bool
def $is_active_validator_enumerated((n, validator), epoch) = $is_active_validator(validator, epoch)

dec $get_active_validator_indices(beaconState, epoch) : validatorIndex*
def $get_active_validator_indices(state, epoch) = n_active*
  -- if state.VALIDATORS = validator*
  -- if $enumerate_<validator>(validator*) = (n, validator)*
  -- if $filter_list_2_<(nat, validator), epoch>(
      (n, validator)*,
      epoch,
      def $is_active_validator_enumerated
    )
    = (n_active, validator_active)*

;; ------------------------------------------------------------
;; get_validator_churn_limit
;; ------------------------------------------------------------
dec $get_validator_churn_limit(beaconState) : uint64
def $get_validator_churn_limit(state_beaconState) = uint64_churn_limit
  -- if $get_current_epoch(state_beaconState) = epoch_current
  -- if $get_active_validator_indices(state_beaconState, epoch_current) = validatorIndex_active*
  -- if $( |validatorIndex_active*| ) = uint64_len_active
  -- if $(uint64_len_active / $CHURN_LIMIT_QUOTIENT) = uint64_quota
  -- if $max_uint64($MIN_PER_EPOCH_CHURN_LIMIT, uint64_quota) = uint64_churn_limit


;; ------------------------------------------------------------
;; get_committee_count_per_slot
;; ------------------------------------------------------------
dec $get_committee_count_per_slot(beaconState, epoch) : uint64
def $get_committee_count_per_slot(state_beaconState, epoch_epoch) = uint64_committees_per_slot
  -- if $get_active_validator_indices(state_beaconState, epoch_epoch) = validatorIndex_active*
  -- if $( |validatorIndex_active*| ) = uint64_len_active
  -- if $(uint64_len_active / $SLOTS_PER_EPOCH) = uint64_per_slot
  -- if $(uint64_per_slot / $TARGET_COMMITTEE_SIZE) = uint64_estimate
  -- if $min_uint64($MAX_COMMITTEES_PER_SLOT, uint64_estimate) = uint64_capped
  -- if $max_uint64(1, uint64_capped) = uint64_committees_per_slot


;; --------------------------------------------
;; eligible cond: active(v, prev) OR (v.SLASHED ∧ prev+1 < v.WITHDRAWABLE_EPOCH)
;; almost same as get_active_validator_indices
;; --------------------------------------------
dec $is_eligible_validator_enumerated(enumerated_<validator>, epoch) : bool
def $is_eligible_validator_enumerated((n, validator), epoch_prev) =
  $is_active_validator(validator, epoch_prev)
  \/
  ( $(validator.SLASHED = true) /\ $(epoch_prev + 1 < validator.WITHDRAWABLE_EPOCH) )

;; --------------------------------------------
;; get_eligible_validator_indices(state) : validatorIndex*
;; --------------------------------------------
dec $get_eligible_validator_indices(beaconState) : validatorIndex*

def $get_eligible_validator_indices(state) = n_eligible*
  -- if $get_previous_epoch(state) = epoch_prev
  -- if state.VALIDATORS = validator*
  -- if $enumerate_<validator>(validator*) = (n, validator)*
  -- if $filter_list_2_<(nat, validator), epoch>(
       (n, validator)*,
       epoch_prev,
       def $is_eligible_validator_enumerated
     ) = (n_eligible, validator_eligible)*

;; --------------------------------------------
;; helpers for filtering by flag / unslashed
;; --------------------------------------------

;; cond: has_flag?
dec $has_flag_for_index(validatorIndex, (participationFlags*, nat)) : bool
def $has_flag_for_index(validatorIndex_vi, (participationFlags_list*, nat_flag))
  = $has_flag(participationFlags_list*[validatorIndex_vi], nat_flag)

;; cond: is validator unslashed?
dec $is_unslashed(validatorIndex, beaconState) : bool
def $is_unslashed(validatorIndex_vi, state) = true
  -- if $(validatorIndex_vi < |state.VALIDATORS|)
  -- if state.VALIDATORS[validatorIndex_vi] = validator
  -- if $(validator.SLASHED = false)
def $is_unslashed(validatorIndex_vi, state) = false
  -- otherwise

;; --------------------------------------------
;; get_unslashed_participating_indices
;; --------------------------------------------
dec $get_unslashed_participating_indices(beaconState, nat, epoch) : validatorIndex*
;; case 1: epoch == current
def $get_unslashed_participating_indices(state, nat_flag_index, epoch_epoch) = validatorIndex_set*
  -- if $get_current_epoch(state) = epoch_epoch
  -- if $get_active_validator_indices(state, epoch_epoch) = validatorIndex_active*
  -- if $filter_list_2_<validatorIndex, (participationFlags*, nat)>(
         validatorIndex_active*,
         (state.CURRENT_EPOCH_PARTICIPATION, nat_flag_index),
         def $has_flag_for_index
       ) = validatorIndex_participating*
  -- if $filter_list_2_<validatorIndex, beaconState>(
         validatorIndex_participating*,
         state,
         def $is_unslashed
       ) = validatorIndex_unslashed*
  -- if $to_set_<validatorIndex>(validatorIndex_unslashed*) = validatorIndex_set*

;; case 2: epoch == previous
def $get_unslashed_participating_indices(state, nat_flag_index, epoch_epoch) = validatorIndex_set*
  -- if $get_previous_epoch(state) = epoch_epoch
  -- if $get_active_validator_indices(state, epoch_epoch) = validatorIndex_active*
  -- if $filter_list_2_<validatorIndex, (participationFlags*, nat)>(
         validatorIndex_active*,
         (state.PREVIOUS_EPOCH_PARTICIPATION, nat_flag_index),
         def $has_flag_for_index
       ) = validatorIndex_participating*
  -- if $filter_list_2_<validatorIndex, beaconState>(
         validatorIndex_participating*,
         state,
         def $is_unslashed
       ) = validatorIndex_unslashed*
  -- if $to_set_<validatorIndex>(validatorIndex_unslashed*) = validatorIndex_set*

;; --------------------------------------------
;; choose_index : nat_bit==1 이면 flip, 아니면 그대로
;; --------------------------------------------
dec $choose_index(uint64, uint64, nat) : uint64
def $choose_index(uint64_index_in, uint64_flip, nat_bit) = uint64_flip
  -- if $(nat_bit = 1)
def $choose_index(uint64_index_in, uint64_flip, nat_bit) = uint64_index_in
  -- otherwise


;; --------------------------------------------
;; attach_capture_round : round ∧ (seed, n) → (seed, n, round)
;; (fold에서 캡처를 건네주기 위한 유틸)
;; --------------------------------------------
dec $attach_capture_round(uint64, (bytes32, uint64)) : (bytes32, uint64, uint64)
def $attach_capture_round(uint64_r, (bytes32_s, uint64_n)) = (bytes32_s, uint64_n, uint64_r)


;; --------------------------------------------
;; apply_shuffle_round : (acc_index, (seed, n, round)) → acc_index'
;;  - 한번의 반복문 사이클을 표현
;;  >> 시프트 연산은 양의정수 uint64 범위 내에서 byte 값을 2**k로 나눈 몫을 사용하고 최하위 비트는 모듈러 2 연산을 사용하여 동일한 의미로 구현
;;  bit = (byte // (2^k)) % 2  로 구현
;; --------------------------------------------
dec $apply_shuffle_round(uint64, (bytes32, uint64, uint64)) : uint64

def $apply_shuffle_round(uint64_index_in, (bytes32_seed, uint64_n, uint64_round)) = uint64_index_out
  ;; 1 round_hash = hash(seed || uint8(round))
  -- if $bytes32_to_bytes(bytes32_seed) = bytes_seed
  -- if $(uint64_round \ 256) = nat_round8
  -- if $uint_to_bytes(nat_round8) = bytes_round8
  -- if $concat_bytes(bytes_seed, bytes_round8) = bytes_msg_r
  -- if $hash_<bytes>(bytes_msg_r) = bytes32_round_hash
  ;; 2 pivot = bytes_to_uint64(round_hash) % n
  -- if $bytes_to_uint64(bytes32_round_hash) = uint64_pivot_raw
  -- if $(uint64_pivot_raw \ uint64_n) = uint64_pivot
  ;; 3 flip / position
  -- if $(uint64_pivot + uint64_n) = uint64_sum
  -- if $(uint64_sum - uint64_index_in) = uint64_tmp
  -- if $(uint64_tmp \ uint64_n) = uint64_flip
  -- if $max_uint64(uint64_index_in, uint64_flip) = uint64_position
  ;; 4 source = hash(seed || uint8(round) || uint32(bucket))
  -- if $(uint64_position / 256) = uint64_bucket
  -- if $uint_to_bytes(uint64_bucket) = bytes_bucket
  -- if $concat_bytes(bytes_seed, bytes_round8) = bytes_seed_round
  -- if $concat_bytes(bytes_seed_round, bytes_bucket) = bytes_msg_src
  -- if $hash_<bytes>(bytes_msg_src) = bytes32_source
  ;; 5 바이트/비트 좌표 (position % 256 → byte_index, k)
  -- if $(uint64_position \ 256) = nat_pos_in_bucket              ;; 0..255
  -- if $(nat_pos_in_bucket / 8) = nat_byte_index                 ;; 0..31
  -- if $(nat_pos_in_bucket \ 8) = nat_k                          ;; 0..7
  ;; 6 byte 선택 및 bit 추출:  bit = (byte // 2^k) % 2
  -- if $bytes32_to_bytes1_list(bytes32_source) = bytes1_list_32*
  -- if bytes1_list_32*[nat_byte_index] = bytes1_b
  -- if $bytes1_to_uint64(bytes1_b) = uint64_byte                  ;; 0..255
  -- if $pow2(nat_k) = nat_two_pow_k                               ;; 2^k
  -- if $(uint64_byte / nat_two_pow_k) = uint64_q                  ;; byte // 2^k
  -- if $(uint64_q \ 2) = nat_bit                                  ;; (..)%2  ∈ {0,1}
  ;; 7 스왑 여부 그리고 출력
  -- if $choose_index(uint64_index_in, uint64_flip, nat_bit) = uint64_index_out 


;; --------------------------------------------
;; compute_shuffled_index : for-loop
;;  - rounds = [0 .. SHUFFLE_ROUND_COUNT-1]
;;  - 각 round에 (seed, n)을 캡처로 붙여서 fold
;; --------------------------------------------
dec $compute_shuffled_index(uint64, uint64, bytes32) : uint64

def $compute_shuffled_index(uint64_index, uint64_index_count, bytes32_seed) = uint64_index_out
  -- if $range($SHUFFLE_ROUND_COUNT) = uint64_rounds*
  -- if $map_list_2_<uint64, (bytes32, uint64), (bytes32, uint64, uint64)>(
         uint64_rounds*,
         (bytes32_seed, uint64_index_count),
         def $attach_capture_round
       ) = (bytes32_seed_c, uint64_n_c, uint64_round_c)*
  -- if $fold_<uint64, (bytes32, uint64, uint64)>(
         def $apply_shuffle_round,
         uint64_index,
         (bytes32_seed_c, uint64_n_c, uint64_round_c)*
       ) = uint64_index_out

;; 구간 보정: nat x + uint64 start → uint64
dec $add_offset_nat_uint64(nat, uint64) : uint64
def $add_offset_nat_uint64(nat_x, uint64_start) = $(uint64_start + nat_x)

;; 하나의 i에 대해 셔플 인덱스를 통해 validatorIndex 뽑기
;; capture: (indices*, seed, len)
dec $pick_shuffled_vi(uint64, (validatorIndex*, bytes32, uint64)) : validatorIndex
def $pick_shuffled_vi(uint64_i, (validatorIndex_indices*, bytes32_seed, uint64_len)) = validatorIndex_vi
  -- if $compute_shuffled_index(uint64_i, uint64_len, bytes32_seed) = uint64_shuf
  -- if validatorIndex_indices*[uint64_shuf] = validatorIndex_vi


;; --------------------------------------------
;; compute_committee(validatorIndex*, bytes32, uint64, uint64) : validatorIndex*
;; --------------------------------------------

dec $compute_committee(validatorIndex*, bytes32, uint64, uint64) : validatorIndex*

def $compute_committee(validatorIndex_indices*, bytes32_seed, uint64_index, uint64_count) = validatorIndex_committee*
  -- if $( |validatorIndex_indices*| ) = uint64_len
  -- if $( (uint64_len * uint64_index) / uint64_count ) = uint64_start
  -- if $(uint64_index + 1) = uint64_plus_index
  -- if $( (uint64_len * uint64_plus_index) / uint64_count ) = uint64_end
  -- if $( uint64_end - uint64_start ) = uint64_span
  ;; [0..span-1] 만들고 → 각 원소에 start를 더해 [start..end-1] i-리스트 만들기
  -- if $range(uint64_span) = nat_r*
  -- if $map_list_2_<nat, uint64, uint64>(nat_r*, uint64_start, def $add_offset_nat_uint64) = uint64_i_list*
  ;; 각 i에 대해 indices[shuffle(i, len, seed)] 선택
  -- if $map_list_2_<uint64, (validatorIndex*, bytes32, uint64), validatorIndex>(
         uint64_i_list*,
         (validatorIndex_indices*, bytes32_seed, uint64_len),
         def $pick_shuffled_vi
       ) = validatorIndex_committee*

;; ----------------------------
;; helpers for exit-epoch lists
;; ----------------------------
dec $exit_epoch_not_far_future(validator) : boolean
def $exit_epoch_not_far_future(validator_v) = true
  -- if ~( validator_v.EXIT_EPOCH = $FAR_FUTURE_EPOCH )
def $exit_epoch_not_far_future(validator_v) = false
  -- otherwise

dec $exit_epoch_eq(validator, epoch) : boolean
def $exit_epoch_eq(validator_v, epoch_e) = true
  -- if $( validator_v.EXIT_EPOCH = epoch_e )
def $exit_epoch_eq(validator_v, epoch_e) = false
  -- otherwise

dec $exit_epoch_of(validator) : epoch
def $exit_epoch_of(validator_v) = validator_v.EXIT_EPOCH

;; fold for max over epochs 
dec $fold_max_epoch(epoch, epoch) : epoch
def $fold_max_epoch(epoch_acc, epoch_x) = $max_uint64(epoch_acc, epoch_x)

;; --------------------------------------------
;; initiate_validator_exit(state, index) : state
;; --------------------------------------------
dec $initiate_validator_exit(beaconState, validatorIndex) : beaconState

;; if 조건 만족 시 그대로 반환
def $initiate_validator_exit(state_in, validatorIndex_idx) = state_in
