;; apply proposer_slahsings
relation Apply_proposer_slashings:
  beaconState proposerSlashing* ~> beaconState
  hint(input %0 %1)

rule Apply_proposer_slashings/base:
  state_in eps ~> state_in

rule Apply_proposer_slashings/step:
  state_in (proposerSlashing_h :: proposerSlashing_t*) ~> state_out
  -- ProcessProposerSlashing: state_in proposerSlashing_h ~> state_mid
  -- Apply_proposer_slashings:  state_mid proposerSlashing_t* ~> state_out


