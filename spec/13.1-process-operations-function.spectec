;;
;; process_proposer_slashing
;; 
relation ProcessProposerSlashing:
  beaconState proposerSlashing ~> beaconState
  hint(input %0 %1)

rule ProcessProposerSlashing/main:
  state_beaconState proposerSlashing_ps ~> state_slashed
  -- if beaconBlockHeader_1 = proposerSlashing_ps.SIGNED_HEADER_1.MESSAGE
  -- if beaconBlockHeader_2 = proposerSlashing_ps.SIGNED_HEADER_2.MESSAGE
  -- if $(beaconBlockHeader_1.SLOT = beaconBlockHeader_2.SLOT)
  -- if $(beaconBlockHeader_1.PROPOSER_INDEX = beaconBlockHeader_2.PROPOSER_INDEX)
  -- if ~(beaconBlockHeader_1 = beaconBlockHeader_2)
  -- if validatorIndex_prop = beaconBlockHeader_1.PROPOSER_INDEX
  -- if $(validatorIndex_prop < |state_beaconState.VALIDATORS|)
  -- if state_beaconState.VALIDATORS[validatorIndex_prop] = validator_prop
  -- if $get_current_epoch(state_beaconState) = epoch_cur
  -- if $is_slashable_validator(validator_prop, epoch_cur) = true
  -- if signedBeaconBlockHeader_header_1 = proposerSlashing_ps.SIGNED_HEADER_1
  -- if $compute_epoch_at_slot(signedBeaconBlockHeader_header_1.MESSAGE.SLOT) = epoch_h1
  -- if $get_domain(state_beaconState, $DOMAIN_BEACON_PROPOSER, epoch_h1) = domain_h1
  -- if $compute_signing_root_beaconBlockHeader(signedBeaconBlockHeader_header_1.MESSAGE, domain_h1) = root_sign_h1
  -- if $bls_verify(validator_prop.PUBKEY, root_sign_h1, signedBeaconBlockHeader_header_1.SIGNATURE) = true
  -- if signedBeaconBlockHeader_header_2 = proposerSlashing_ps.SIGNED_HEADER_2
  -- if $compute_epoch_at_slot(signedBeaconBlockHeader_header_2.MESSAGE.SLOT) = epoch_h2
  -- if $get_domain(state_beaconState, $DOMAIN_BEACON_PROPOSER, epoch_h2) = domain_h2
  -- if $compute_signing_root_beaconBlockHeader(signedBeaconBlockHeader_header_2.MESSAGE, domain_h2) = root_sign_h2
  -- if $bls_verify(validator_prop.PUBKEY, root_sign_h2, signedBeaconBlockHeader_header_2.SIGNATURE) = true
  ;; 디버깅: ProcessProposerSlashing 전 balances
  -- if state_beaconState.BALANCES = gwei_balances_before_proposer_slashing*
  -- if $debug_print_label_<gwei*>("ProcessProposerSlashing: balances before", gwei_balances_before_proposer_slashing*) = gwei_balances_before_proposer_slashing_dbg*
  -- if state_slashed = $slash_validator(state_beaconState, validatorIndex_prop, eps)
  ;; 디버깅: ProcessProposerSlashing 후 balances
  -- if state_slashed.BALANCES = gwei_balances_after_proposer_slashing*
  -- if $debug_print_label_<gwei*>("ProcessProposerSlashing: balances after", gwei_balances_after_proposer_slashing*) = gwei_balances_after_proposer_slashing_dbg*

;;
;; process_attester_slashing
;;
relation ProcessAttesterSlashing:
  beaconState attesterSlashing ~> beaconState
  hint(input %0 %1)

rule ProcessAttesterSlashing/main:
  state_beaconState attesterSlashing_as ~> state_after_slash
  -- if indexedAttestation_1 = attesterSlashing_as.ATTESTATION_1
  -- if indexedAttestation_2 = attesterSlashing_as.ATTESTATION_2
  -- if $is_slashable_attestation_data(indexedAttestation_1.DATA, indexedAttestation_2.DATA) = true
  -- if $is_valid_indexed_attestation(state_beaconState, indexedAttestation_1) = true
  -- if $is_valid_indexed_attestation(state_beaconState, indexedAttestation_2) = true
  -- if validatorIndex_list_1* = indexedAttestation_1.ATTESTING_INDICES
  -- if validatorIndex_list_2* = indexedAttestation_2.ATTESTING_INDICES
  -- if $to_set_<validatorIndex>(validatorIndex_list_1*) = validatorIndex_set_1*
  -- if $to_set_<validatorIndex>(validatorIndex_list_2*) = validatorIndex_set_2*
  -- if $set_intersection_<validatorIndex>(validatorIndex_set_1*, validatorIndex_set_2*) = validatorIndex_intersection*
  -- if $sort_<validatorIndex>(validatorIndex_intersection*) = validatorIndex_sorted*
  ;; 지역변수 slashed_any 의 확인, 여기선 사전에 is_slashable 검사로 보장
  -- if $filter_list_2_<validatorIndex, beaconState>(validatorIndex_sorted*, state_beaconState, def $is_slashable_now) = validatorIndex_slashable_now*
  -- if $( |validatorIndex_slashable_now*| > 0 )
  ;; 디버깅: ProcessAttesterSlashing 전 balances
  -- if state_beaconState.BALANCES = gwei_balances_before_attester_slashing*
  -- if $debug_print_label_<gwei*>("ProcessAttesterSlashing: balances before", gwei_balances_before_attester_slashing*) = gwei_balances_before_attester_slashing_dbg*
  -- if state_after_slash = $apply_slashes(state_beaconState, validatorIndex_sorted*)
  ;; 디버깅: ProcessAttesterSlashing 후 balances
  -- if state_after_slash.BALANCES = gwei_balances_after_attester_slashing*
  -- if $debug_print_label_<gwei*>("ProcessAttesterSlashing: balances after", gwei_balances_after_attester_slashing*) = gwei_balances_after_attester_slashing_dbg*

;;
;; process_attestation
;;

relation ProcessAttestation:
  beaconState attestation ~> beaconState
  hint(input %0 %1)

rule ProcessAttestation/current:
  state_in attestation_att ~> state_out
  -- if attestationData_data = attestation_att.DATA
  -- if $get_previous_epoch(state_in) = epoch_prev
  -- if $get_current_epoch(state_in)  = epoch_cur
  -- if ( attestationData_data.TARGET.EPOCH = epoch_prev \/ attestationData_data.TARGET.EPOCH = epoch_cur )
  -- if $( attestationData_data.TARGET.EPOCH = $compute_epoch_at_slot(attestationData_data.SLOT) )
  -- if $( attestationData_data.SLOT + $MIN_ATTESTATION_INCLUSION_DELAY <= state_in.SLOT )
  -- if $( state_in.SLOT <= attestationData_data.SLOT + $SLOTS_PER_EPOCH )
  -- if $( attestationData_data.INDEX < $get_committee_count_per_slot(state_in, attestationData_data.TARGET.EPOCH) )
  -- if validatorIndex_committee* = $get_beacon_committee(state_in, attestationData_data.SLOT, attestationData_data.INDEX)
  -- if $( |attestation_att.AGGREGATION_BITS| = |validatorIndex_committee*| )
  ;; 현재 epoch 분기
  -- if $( attestationData_data.TARGET.EPOCH = epoch_cur )
  -- if $( state_in.SLOT - attestationData_data.SLOT ) = uint64_inclusion_delay
  ;; Python 코드 순서: get_attestation_participation_flag_indices 호출 → is_valid_indexed_attestation 체크
  -- if $get_attestation_participation_flag_indices(state_in, attestationData_data, uint64_inclusion_delay) = nat_flag_indices*
  -- if $is_valid_indexed_attestation(state_in, $get_indexed_attestation(state_in, attestation_att)) = true  
  ;; 바깥 for: vi 리스트 만들기
  -- if validatorIndex_attesting* = $get_attesting_indices(state_in, attestation_att)
  ;; change map_list_2_
  -- if ($attach_flags_to_vi(validatorIndex_attesting, nat_flag_indices*) = (validatorIndex_vi, nat_flags_vi*))*
  ;; fold over vi: (state, num) 누적
  -- if $fold_<(beaconState, gwei), (validatorIndex, nat*)>(
         def $process_one_vi_current,
         (state_in, 0),
         (validatorIndex_vi, nat_flags_vi*)*
       ) = (state_after_flags, gwei_num)
  ;; proposer 보상 지급
  -- if $compute_proposer_reward(gwei_num) = gwei_prop
  ;; 디버깅: ProcessAttestation/current 전 balances (reward_proposer 전)
  -- if state_after_flags.BALANCES = gwei_balances_before_reward_proposer_current*
  -- if $debug_print_label_<gwei*>("ProcessAttestation/current: balances before reward_proposer", gwei_balances_before_reward_proposer_current*) = gwei_balances_before_reward_proposer_current_dbg*
  -- if state_out = $reward_proposer(state_after_flags, gwei_prop)
  ;; 디버깅: ProcessAttestation/current 후 balances
  -- if state_out.BALANCES = gwei_balances_after_attestation_current*
  -- if $debug_print_label_<gwei*>("ProcessAttestation/current: balances after", gwei_balances_after_attestation_current*) = gwei_balances_after_attestation_current_dbg*

rule ProcessAttestation/previous:
  state_in attestation_att ~> state_out
  -- if attestationData_data = attestation_att.DATA
  -- if $get_previous_epoch(state_in) = epoch_prev
  -- if $get_current_epoch(state_in)  = epoch_cur
  -- if ( attestationData_data.TARGET.EPOCH = epoch_prev \/ attestationData_data.TARGET.EPOCH = epoch_cur )
  -- if $( attestationData_data.TARGET.EPOCH = $compute_epoch_at_slot(attestationData_data.SLOT) )
  -- if $( attestationData_data.SLOT + $MIN_ATTESTATION_INCLUSION_DELAY <= state_in.SLOT )
  -- if $( state_in.SLOT <= attestationData_data.SLOT + $SLOTS_PER_EPOCH )
  -- if $( attestationData_data.INDEX < $get_committee_count_per_slot(state_in, attestationData_data.TARGET.EPOCH) )
  -- if validatorIndex_committee* = $get_beacon_committee(state_in, attestationData_data.SLOT, attestationData_data.INDEX)
  -- if $( |attestation_att.AGGREGATION_BITS| = |validatorIndex_committee*| )
  ;; 이전 epoch 분기
  -- if $( attestationData_data.TARGET.EPOCH = epoch_prev )
  -- if $( state_in.SLOT - attestationData_data.SLOT ) = uint64_inclusion_delay
  ;; Python 코드 순서: get_attestation_participation_flag_indices 호출 → is_valid_indexed_attestation 체크
  -- if $get_attestation_participation_flag_indices(state_in, attestationData_data, uint64_inclusion_delay) = nat_flag_indices*
  -- if $is_valid_indexed_attestation(state_in, $get_indexed_attestation(state_in, attestation_att)) = true
  -- if validatorIndex_attesting* = $get_attesting_indices(state_in, attestation_att)
  ;; change map_list_2_
  -- if ($attach_flags_to_vi(validatorIndex_attesting, nat_flag_indices*) = (validatorIndex_vi, nat_flags_vi*))*
  -- if $fold_<(beaconState, gwei), (validatorIndex, nat*)>(
         def $process_one_vi_previous,
         (state_in, 0),
         (validatorIndex_vi, nat_flags_vi*)*
       ) = (state_after_flags, gwei_num)
  -- if $compute_proposer_reward(gwei_num) = gwei_prop
  ;; 디버깅: ProcessAttestation/previous 전 balances (reward_proposer 전)
  -- if state_after_flags.BALANCES = gwei_balances_before_reward_proposer_previous*
  -- if $debug_print_label_<gwei*>("ProcessAttestation/previous: balances before reward_proposer", gwei_balances_before_reward_proposer_previous*) = gwei_balances_before_reward_proposer_previous_dbg*
  -- if state_out = $reward_proposer(state_after_flags, gwei_prop)
  ;; 디버깅: ProcessAttestation/previous 후 balances
  -- if state_out.BALANCES = gwei_balances_after_attestation_previous*
  -- if $debug_print_label_<gwei*>("ProcessAttestation/previous: balances after", gwei_balances_after_attestation_previous*) = gwei_balances_after_attestation_previous_dbg*



;; 
;; process_deposit
;;
relation ProcessDeposit:
  beaconState deposit ~> beaconState
  hint(input %0 %1)

rule ProcessDeposit/main:
  state deposit ~> state_applied
  -- if $hash_tree_root_depositData(deposit.DATA) = root_leaf
  -- if $( $DEPOSIT_CONTRACT_TREE_DEPTH + 1 ) = uint64_depth_plus_1
  -- if $is_valid_merkle_branch(
         root_leaf,
         deposit.PROOF,
         uint64_depth_plus_1,
         state.ETH1_DEPOSIT_INDEX,
         state.ETH1_DATA.DEPOSIT_ROOT
       ) = true
  -- if $(state.ETH1_DEPOSIT_INDEX + 1) = uint64_deposit_index_next
  -- if state_inc = state[.ETH1_DEPOSIT_INDEX = uint64_deposit_index_next]
  ;; 디버깅: ProcessDeposit 전 balances
  -- if state_inc.BALANCES = gwei_balances_before_deposit*
  -- if $debug_print_label_<gwei*>("ProcessDeposit: balances before", gwei_balances_before_deposit*) = gwei_balances_before_deposit_dbg*
  -- if state_applied =
       $apply_deposit(
         state_inc,
         deposit.DATA.PUBKEY,
         deposit.DATA.WITHDRAWAL_CREDENTIALS,
         deposit.DATA.AMOUNT,
         deposit.DATA.SIGNATURE
       )
  ;; 디버깅: ProcessDeposit 후 balances
  -- if state_applied.BALANCES = gwei_balances_after_deposit*
  -- if $debug_print_label_<gwei*>("ProcessDeposit: balances after", gwei_balances_after_deposit*) = gwei_balances_after_deposit_dbg*

