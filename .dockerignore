# Ignore testing results and coverage reports
coverage_*/
final_coverage_report/
*.csv
*.json
*.md
!README.md

# Ignore Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Ignore build artifacts (will be built inside container)
testing_clients/
*.o
*.so
*.a

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore git files (optional - might want to keep .git)
.git/
.gitignore

# Ignore other temporary files
*.log
*.tmp
.DS_Store