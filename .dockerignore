# Ignore testing results and coverage reports
coverage_*/
final_coverage_report/
results/
*.csv
*.json

# Ignore documentation. Prevents documentation edits from invalidating the cache.
*.md
LICENSE
NOTICE
AUTHORS

# Ignore Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Ignore build artifacts (will be built inside container)
testing_clients/
*.o
*.so
*.a

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore git files
.git/
.gitignore

# Ignore other temporary files
*.log
*.tmp
.DS_Store

# Improve caching
Dockerfile
.dockerignore
